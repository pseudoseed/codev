{
  "name": "@cluesmith/t3-client",
  "version": "3.3.1",
  "description": "Spec 146: a client for t3code's RPC WebSocket. Speaks the layerJson envelope directly; no Effect. Its only dependency is @cluesmith/codev-types, which is itself dependency-free, for the vendored contract used to shape-check payloads.",
  "type": "module",
  "exports": {
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "default": "./dist/envelope.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./resume": {
      "types": "./dist/resume.d.ts",
      "default": "./dist/resume.js"
    },
    "./socket": {
      "types": "./dist/socket.d.ts",
      "default": "./dist/socket.js"
    },
    "./checked": {
      "types": "./dist/checked.d.ts",
      "default": "./dist/checked.js"
    },
    "./subscription": {
      "types": "./dist/subscription.d.ts",
      "default": "./dist/subscription.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cluesmith/codev",
    "directory": "packages/t3-client"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@cluesmith/codev-types": "workspace:*"
  }
}
