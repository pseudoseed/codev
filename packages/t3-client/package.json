{
  "name": "@cluesmith/t3-client",
  "version": "3.3.1",
  "description": "Spec 146: a client for t3code's RPC WebSocket. Speaks the layerJson envelope directly; no Effect. Its only dependency is @cluesmith/codev-types, which is itself dependency-free, for the vendored contract used to shape-check payloads.",
  "type": "module",
  "exports": {
    "./envelope": {
      "types": "./src/envelope.ts",
      "default": "./dist/envelope.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./dist/auth.js"
    },
    "./resume": {
      "types": "./src/resume.ts",
      "default": "./dist/resume.js"
    },
    "./socket": {
      "types": "./src/socket.ts",
      "default": "./dist/socket.js"
    },
    "./checked": {
      "types": "./src/checked.ts",
      "default": "./dist/checked.js"
    },
    "./subscription": {
      "types": "./src/subscription.ts",
      "default": "./dist/subscription.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@cluesmith/codev-types": "workspace:*"
  }
}
