{
  "name": "@cluesmith/porch-driver",
  "version": "3.3.1",
  "description": "Spec 146, Phase 3: porch's session lifecycle against a t3code server. Spawn a thread on a worktree, run a turn to settle, run phase checks as processes porch owns, and survive a crash at either of the two windows that lose work. Library calls only \u2014 no PTY.",
  "type": "module",
  "exports": {
    "./harness-map": {
      "types": "./dist/harness-map.d.ts",
      "default": "./dist/harness-map.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "default": "./dist/cursor.js"
    },
    "./thread": {
      "types": "./dist/thread.d.ts",
      "default": "./dist/thread.js"
    },
    "./turn": {
      "types": "./dist/turn.d.ts",
      "default": "./dist/turn.js"
    },
    "./checks": {
      "types": "./dist/checks.d.ts",
      "default": "./dist/checks.js"
    },
    "./worktree-setup": {
      "types": "./dist/worktree-setup.d.ts",
      "default": "./dist/worktree-setup.js"
    },
    "./deliver": {
      "types": "./dist/deliver.d.ts",
      "default": "./dist/deliver.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./scheduled": {
      "types": "./dist/scheduled.d.ts",
      "default": "./dist/scheduled.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "typescript": "catalog:"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@cluesmith/t3-client": "workspace:*"
  }
}
