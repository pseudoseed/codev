+/**
+ * The thread an entry stands for, or `null` for one that stands for a project.
+ *
+ * `empty-project` carries no thread (issue #272), and every consumer of this
+ * union now has to say what it does with that. Two helpers rather than a widened
+ * `thread?: T` field: an optional field would let `entry.thread.id` keep
+ * compiling and fail at runtime on the one entry kind that has no thread.
+ */
+export function codevEntryThread<T>(entry: CodevSidebarEntry<T>): T | null {
+  return entry.kind === "empty-project" ? null : entry.thread;
+}
+
+/**
+ * The threads an entry list stands for, in render order.
+ *
+ * What every caller wanting "the rows, in the order they draw" actually means.
+ * The sidebar assigns shift-range-select and jump-hint labels from this list, and
+ * a plain `.map(entry => entry.thread)` put `undefined` in it for a project
+ * heading — a crash one row away rather than a wrong row.
+ */
+export function codevOrderedThreads<T>(entries: readonly CodevSidebarEntry<T>[]): T[] {
+  return entries.flatMap((entry) => {
+    const thread = codevEntryThread(entry);
+    return thread === null ? [] : [thread];
+  });
+}
