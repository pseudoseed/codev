+    ).toEqual(["architect", keyOf("idle")]);
+  });
+
+  it("does not draw a second heading for a project the architect run already opened", () => {
+    const order = buildCodevSidebarOrder([architectIn("busy", "arch-1")], {
+      projectKeyOf,
+      projectGroups: [soloGroup("busy")],
