+  });
+
+  it("treats a group as opened when ANY of its member projects has an architect", () => {
+    // One logical project spanning two environments. Without the member list
+    // this draws an empty heading beside the populated one, carrying the same
+    // name, and a reader sees two workspaces where there is one.
+    const populated = keyOf("busy");
+    const order = buildCodevSidebarOrder([architectIn("busy", "arch-1")], {
