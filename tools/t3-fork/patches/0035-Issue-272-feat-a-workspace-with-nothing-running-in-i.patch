+
+  it("draws a heading for a project no architect opened", () => {
+    const order = buildCodevSidebarOrder([architectIn("busy", "arch-1")], {
+      projectKeyOf,
+      projectGroups: [soloGroup("busy"), soloGroup("idle")],
