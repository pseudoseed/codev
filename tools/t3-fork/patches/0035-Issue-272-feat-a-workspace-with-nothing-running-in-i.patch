+      projectGroups: [soloGroup("idle"), soloGroup("idle")],
+    });
+    expect(order.entries.filter((entry) => entry.kind === "empty-project")).toHaveLength(1);
+  });
+
+  it("puts the empty projects after the architect run, in the caller's order", () => {
+    // The caller has already sorted its project list — by pin, by recency, by
