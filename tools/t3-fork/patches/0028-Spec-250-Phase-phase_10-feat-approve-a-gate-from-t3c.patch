+            code: "GATE_NOT_PENDING",
+            message: "that gate is not pending",
+          },
+        },
+      }),
+      pairing,
+      session,
+      gate,
+    );
+    expect(outcome).toEqual({
+      ok: false,
+      signal: "GATE_NOT_PENDING",
+      message: "that gate is not pending",
