+  });
+
+  /**
+   * THE ONE A NAIVE PORT PASSES WHILE RECORDING FICTION.
+   *
+   * The agent answered 200 with nothing this page can read. Filling the record
+   * from local state — this browser's clock, the stored machine, the session in
+   * hand — would render a complete approval every word of which was made up here.
+   */
+  it("reports a success it cannot read as unconfirmed, never as an approval", async () => {
+    const outcome = await approveGate(
+      fakeFetch({
