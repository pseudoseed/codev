index 000000000..0d028f4a8
--- /dev/null
+++ b/apps/web/src/codev/useCodevAgent.ts
@@ -0,0 +1,145 @@
+/**
+ * Codev customization (spec 250), phase 10 — one `codev-agent` read for the whole page.
+ *
+ * Every consumer — the grid's panes and the gate panel's Approve — needs the same
+ * workspace snapshot, and `codev-agent` answers for the whole workspace in one
+ * request. So this holds one poll and hands the result to all of them, rather
+ * than each component fetching its own copy and the page asking the agent the
+ * same question six times.
+ *
+ * It is a module-level store rather than a React context on purpose: `GatePanel`
+ * renders inside `ChatView` and the grid renders inside its own route, and
+ * threading a provider through both would be a change to t3code's tree for a
+ * customization that is meant to stay narrow.
+ */
+
+import { useCallback, useEffect, useState } from "react";
+
+import {
+  AGENT_STATE_POLL_MS,
+  readWorkspaceState,
+  type AgentStateRead,
+} from "./agentState";
+import { clearPairing, readPairing, writePairing, type CodevPairing, type PairingRead } from "./pairing";
+
+export type CodevAgentState =
+  | AgentStateRead
+  /** No credential in this browser. A pairing form fixes it; a server does not. */
+  | { readonly kind: "unpaired"; readonly message: string };
+
+interface Store {
+  pairingRead: PairingRead;
+  state: CodevAgentState;
+}
+
+function unpairedState(pairingRead: PairingRead): CodevAgentState {
+  if (pairingRead.kind === "unreadable") {
+    // NOT "unpaired". The store could not be read, so whether this browser holds
+    // a credential is unknown — and sending someone to spend a fresh token over
+    // an unreadable store is the wrong next action.
+    return {
+      kind: "unreachable",
+      signal: "CODEV_PAIRING_UNREADABLE",
+      message: pairingRead.message,
+    };
+  }
+  return {
+    kind: "unpaired",
+    message: "this browser is not paired with a codev-agent",
+  };
+}
+
+const initialPairing = readPairing();
+const store: Store = {
+  pairingRead: initialPairing,
+  state: initialPairing.kind === "paired"
+    ? { kind: "unreachable", signal: "CODEV_AGENT_STATE_PENDING", message: "reading codev-agent…" }
+    : unpairedState(initialPairing),
+};
+
+const listeners = new Set<() => void>();
+let polling: ReturnType<typeof setInterval> | null = null;
+let inFlight = false;
+
+function announce(): void {
+  for (const listener of listeners) listener();
+}
+
+async function refreshOnce(): Promise<void> {
+  if (inFlight) return;
+  const pairing = store.pairingRead.kind === "paired" ? store.pairingRead.pairing : null;
+  if (pairing === null) {
+    store.state = unpairedState(store.pairingRead);
+    announce();
+    return;
+  }
+  inFlight = true;
+  try {
+    store.state = await readWorkspaceState(globalThis.fetch.bind(globalThis), pairing);
+  } finally {
+    inFlight = false;
+  }
+  announce();
+}
+
+function ensurePolling(): void {
+  if (polling !== null) return;
+  void refreshOnce();
+  polling = setInterval(() => void refreshOnce(), AGENT_STATE_POLL_MS);
+}
+
+function stopPolling(): void {
+  if (polling === null) return;
+  clearInterval(polling);
+  polling = null;
+}
+
+export interface CodevAgentAccess {
+  readonly pairing: CodevPairing | null;
+  readonly pairingRead: PairingRead;
+  readonly state: CodevAgentState;
+  readonly refresh: () => void;
+  readonly pair: (pairing: CodevPairing) => { readonly ok: true } | { readonly ok: false; readonly message: string };
+  readonly unpair: () => void;
+}
+
+export function useCodevAgent(): CodevAgentAccess {
+  const [, setTick] = useState(0);
+
+  useEffect(() => {
+    const listener = (): void => setTick((value) => value + 1);
+    listeners.add(listener);
+    ensurePolling();
+    return () => {
+      listeners.delete(listener);
+      // The last consumer leaving stops the poll. A background interval on a page
+      // nobody is reading is a request every five seconds forever.
+      if (listeners.size === 0) stopPolling();
+    };
+  }, []);
+
+  const pair = useCallback((pairing: CodevPairing) => {
+    const written = writePairing(pairing);
+    if (!written.ok) return written;
+    store.pairingRead = { kind: "paired", pairing };
+    announce();
+    void refreshOnce();
+    return { ok: true as const };
+  }, []);
+
+  const unpair = useCallback(() => {
+    clearPairing();
+    store.pairingRead = { kind: "unpaired" };
+    store.state = unpairedState(store.pairingRead);
+    announce();
+  }, []);
+
+  return {
+    pairing: store.pairingRead.kind === "paired" ? store.pairingRead.pairing : null,
+    pairingRead: store.pairingRead,
+    state: store.state,
+    refresh: () => void refreshOnce(),
+    pair,
+    unpair,
+  };
+}
diff --git a/apps/web/src/routes/_chat.codev-builders.tsx b/apps/web/src/routes/_chat.codev-builders.tsx
