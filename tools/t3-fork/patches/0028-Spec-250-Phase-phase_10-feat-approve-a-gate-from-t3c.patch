@@ -0,0 +1,679 @@
+/**
+ * Codev customization (spec 250), phase 10 — the same-origin proxy to `codev-agent`.
+ *
+ * ## Why a proxy at all
+ *
+ * Approving a porch gate is `codev-agent`'s capability path, and `codev-agent`
+ * runs on its own origin. A page that called it directly would make a
+ * cross-origin request from t3code's app, which is the thing the spec set out
+ * not to do. So the page calls THIS server, on the origin it was loaded from,
+ * and this server makes the one hop.
+ *
+ * The guarantee is structural, not a header. t3code sends
+ * `Content-Security-Policy` on `.svg` asset responses only (`../http.ts`), and
+ * `apps/web/index.html` carries no CSP meta tag — there is no page-level CSP and
+ * therefore no `connect-src` directive to keep closed. What holds is that the
+ * page never *makes* a cross-origin request, and the test that proves it watches
+ * the network rather than parsing a header that does not exist. Adding a
+ * page-level CSP is deliberately NOT done here: it would change how every t3code
+ * page loads, which is far wider than this spec's diff, to obtain a guarantee we
+ * already have.
+ *
+ * ## The upstream target is CONFIGURED, never named by the browser
+ *
+ * A server proxy that forwards to an origin the browser supplies is an SSRF
+ * primitive, and a route-path allowlist does not constrain the *host*. So the
+ * operator configures the permitted `codev-agent` origins in this server's own
+ * environment and the browser selects among them by id. A URL arriving in the
+ * request path is refused rather than normalised.
+ *
+ * ## What it does not forward, and why that is the point
+ *
+ * t3code's own browser session — `authorization`, `cookie` — is never handed to
+ * `codev-agent`. Being signed into t3code is not approval authority: the machine
+ * credential and the human session are, and they are the only credentials this
+ * proxy carries. Forwarding t3code's bearer to another server would give that
+ * server t3code's identity, which nobody asked it for.
+ *
+ * That is why the forward set is an ALLOWLIST rather than a denylist. A denylist
+ * forwards every header nobody thought of, and this hop sees credentials.
+ *
+ * ## Two failure signals, not one
+ *
+ * `packages/codev/src/agent-farm/servers/client-static.ts` learned this and it is
+ * ported deliberately: a machine that refused the connection and one that
+ * accepted it and then said nothing are different facts wanting different next
+ * actions. One signal for both sends an operator to check whether a running
+ * server is running.
+ */
+
+// @effect-diagnostics nodeBuiltinImport:off
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import { HttpRouter, HttpServerRequest, HttpServerResponse, HttpServerRespondable } from "effect/unstable/http";
+import { AuthOrchestrationOperateScope, AuthOrchestrationReadScope } from "@t3tools/contracts";
+import * as NodeHttp from "node:http";
+import * as NodeHttps from "node:https";
+
+import {
+  CODEV_AGENT_PROXY_PREFIX,
+  CODEV_AGENT_TARGETS_PATH,
+} from "@t3tools/shared/codevAgentProxy";
+
+import { authenticateRawRouteWithScope } from "../http.ts";
+
+/** The operator's list of permitted `codev-agent` origins, `id=origin`, comma separated. */
+export const CODEV_AGENT_ORIGINS_ENV = "T3CODE_CODEV_AGENT_ORIGINS";
+
+export { CODEV_AGENT_PROXY_PREFIX, CODEV_AGENT_TARGETS_PATH };
+
+/** The one upstream prefix this proxy will dial. Everything else is refused. */
+const AGENT_ROUTE_PREFIX = "/api/agent/v1";
+
+export interface CodevAgentTarget {
+  /** Stable, operator-chosen. What the browser sends; never a URL. */
+  readonly id: string;
+  /** The `codev-agent` origin. Server-side only — it is not sent to the page. */
+  readonly origin: string;
+}
+
+export interface CodevAgentTargetRejection {
+  readonly entry: string;
+  readonly problem: string;
+}
+
+/**
+ * Three answers, three signals.
+ *
+ * "Nobody configured this", "everything configured was rejected" and "here are
+ * the targets, and these entries were rejected" are three situations wanting
+ * three different next actions from an operator. Collapsing the first two into an
+ * empty list is the defect `client-static.ts` documents at length: a mount
+ * showing nothing with no stated reason reads as broken rather than as
+ * unconfigured.
+ */
+export type CodevAgentTargetsRead =
+  | {
+      readonly ok: false;
+      readonly signal: "CODEV_AGENTS_UNCONFIGURED";
+      readonly message: string;
+      readonly rejected: readonly CodevAgentTargetRejection[];
+    }
+  | {
+      readonly ok: false;
+      readonly signal: "CODEV_AGENTS_ALL_REJECTED";
+      readonly message: string;
+      readonly rejected: readonly CodevAgentTargetRejection[];
+    }
+  | {
+      readonly ok: true;
+      readonly targets: readonly CodevAgentTarget[];
+      readonly rejected: readonly CodevAgentTargetRejection[];
+    };
+
+/**
+ * Loopback, where plaintext never leaves the host.
+ *
+ * Written out rather than shared with `../http.ts`'s `isLoopbackHostname`: that
+ * one normalises a `Host` header, this one reads a parsed URL's hostname, and the
+ * two would drift under one signature.
+ */
+function isLoopback(hostname: string): boolean {
+  const bare = hostname.replace(/^\[(.*)\]$/, "$1").toLowerCase();
+  return bare === "localhost" || bare === "127.0.0.1" || bare === "::1";
+}
+
+/**
+ * Why an origin is checked before it is dialled.
+ *
+ * Ported from `client-static.ts`, whose comment names the two failures this
+ * catches — an `https://` origin dialled with `http.request` reaching port 80 in
+ * cleartext and reporting a configuration mistake as a dead machine, and an
+ * `http://` origin to a NON-loopback host sending a machine credential in the
+ * clear over whatever network is in between. Two more are added here because the
+ * value is operator configuration rather than a curated file: credentials in the
+ * URL, and a URL that is not a bare origin.
+ */
+export function originProblem(origin: string): string | null {
+  let url: URL;
+  try {
+    url = new URL(origin);
+  } catch {
+    return "is not a URL";
+  }
+  if (url.protocol !== "http:" && url.protocol !== "https:") {
+    return `uses ${url.protocol}, and only http: and https: can be proxied`;
+  }
+  if (url.protocol === "http:" && !isLoopback(url.hostname)) {
+    return (
+      "is plaintext http: to a non-loopback host, which would send a machine credential in the "
+      + "clear. Use https: for a remote machine."
+    );
+  }
+  if (url.username !== "" || url.password !== "") {
+    return "carries credentials in the URL, which this proxy will not forward";
+  }
+  if (url.pathname !== "/" || url.search !== "" || url.hash !== "") {
+    return "is not a bare origin — drop the path, query and fragment";
+  }
+  return null;
+}
+
+/**
+ * Parse `id=origin,id=origin` from the operator's environment.
+ *
+ * An entry that cannot be used is REPORTED, not skipped. An operator who typed a
+ * bad origin and one who configured nothing need opposite next actions, and a
+ * silently-dropped entry gives them the same empty list.
+ */
+export function readCodevAgentTargets(
+  environment: Readonly<Record<string, string | undefined>> = process.env,
+): CodevAgentTargetsRead {
+  const raw = (environment[CODEV_AGENT_ORIGINS_ENV] ?? "").trim();
+  if (raw === "") {
+    return {
+      ok: false,
+      signal: "CODEV_AGENTS_UNCONFIGURED",
+      message:
+        `No codev-agent targets are configured. Set ${CODEV_AGENT_ORIGINS_ENV} to a comma-separated `
+        + "list of id=origin entries, for example local=http://127.0.0.1:4100",
+      rejected: [],
+    };
+  }
+
+  const targets: CodevAgentTarget[] = [];
+  const rejected: CodevAgentTargetRejection[] = [];
+  const seen = new Set<string>();
+  for (const entry of raw.split(",").map((part) => part.trim()).filter((part) => part !== "")) {
+    const separator = entry.indexOf("=");
+    if (separator <= 0) {
+      rejected.push({ entry, problem: "is not id=origin" });
+      continue;
+    }
+    const id = entry.slice(0, separator).trim();
+    const origin = entry.slice(separator + 1).trim();
+    // A `/` in an id would let one entry's id widen the proxy prefix into another
+    // path segment, and the route split reads exactly one segment.
+    if (id === "" || id.includes("/")) {
+      rejected.push({ entry, problem: "has an empty id, or one containing /" });
+      continue;
+    }
+    if (seen.has(id)) {
+      // Silently keeping the first would make the operator's second entry a
+      // no-op they cannot see. Which one wins is not the point; being told is.
+      rejected.push({ entry, problem: `repeats the id "${id}", which an earlier entry already used` });
+      continue;
+    }
+    const problem = originProblem(origin);
+    if (problem !== null) {
+      rejected.push({ entry, problem: `origin ${problem}` });
+      continue;
+    }
+    seen.add(id);
+    targets.push({ id, origin });
+  }
+
+  if (targets.length === 0) {
+    return {
+      ok: false,
+      signal: "CODEV_AGENTS_ALL_REJECTED",
+      message:
+        `${CODEV_AGENT_ORIGINS_ENV} is set and no entry in it could be used. This is not the same as `
+        + "having configured nothing; each rejected entry is listed with its reason.",
+      rejected,
+    };
+  }
+  return { ok: true, targets, rejected };
+}
+
+interface ProxiedRoute {
+  readonly id: string;
+  readonly method: "GET" | "POST";
+  readonly pathname?: string;
+  readonly pattern?: RegExp;
+}
+
+/**
+ * The `codev-agent` routes this proxy will carry, and only these.
+ *
+ * Hand-mirrored from `packages/codev/src/agent-farm/servers/agent-auth.ts` rather
+ * than imported — that module reaches `node:fs` and `better-sqlite3` through its
+ * import graph, and the fork does not depend on the Codev package.
+ *
+ * Three of `codev-agent`'s routes are deliberately ABSENT:
+ *
+ *   `workspace-stream`     an SSE stream. This proxy buffers, so carrying it
+ *                          would deliver a stream that is live on the wire and
+ *                          empty in the page. The grid reads `workspace-state`.
+ *   `machine-credential-revoke`
+ *   `approval-capability-revoke-machine`
+ *                          revocation is `afx pair revoke`, an operator act at a
+ *                          terminal. A browser that could revoke could deny a
+ *                          human their own gate.
+ */
+export const PROXIED_AGENT_ROUTES: readonly ProxiedRoute[] = [
+  { id: "pairing-redeem", method: "POST", pathname: `${AGENT_ROUTE_PREFIX}/pairing/redeem` },
+  { id: "human-session-issue", method: "POST", pathname: `${AGENT_ROUTE_PREFIX}/human-sessions` },
+  { id: "session-probe", method: "GET", pathname: `${AGENT_ROUTE_PREFIX}/session` },
+  { id: "approval-capability-issue", method: "POST", pathname: `${AGENT_ROUTE_PREFIX}/approval-capabilities` },
+  { id: "approval-nonce-mint", method: "POST", pathname: `${AGENT_ROUTE_PREFIX}/approval-nonces` },
+  {
+    id: "gate-approve",
+    method: "POST",
+    pattern: /^\/api\/agent\/v1\/workspaces\/[^/]+\/gates\/approve$/,
+  },
+  {
+    id: "approval-submit",
+    method: "POST",
+    pattern: /^\/api\/agent\/v1\/workspaces\/[^/]+\/gates\/approvals$/,
+  },
+  {
+    id: "approval-operation",
+    method: "GET",
+    pattern: /^\/api\/agent\/v1\/workspaces\/[^/]+\/gates\/approvals\/[^/]+$/,
+  },
+  { id: "workspace-state", method: "GET", pattern: /^\/api\/agent\/v1\/workspaces\/[^/]+\/state$/ },
+];
+
+export function matchProxiedAgentRoute(method: string, pathname: string): ProxiedRoute | null {
+  for (const route of PROXIED_AGENT_ROUTES) {
+    if (route.method !== method) continue;
+    if (route.pathname !== undefined && route.pathname === pathname) return route;
+    if (route.pattern?.test(pathname)) return route;
+  }
+  return null;
+}
+
+/**
+ * Headers a proxy must not copy from one connection onto another.
+ *
+ * RFC 9110 hop-by-hop: they describe THIS connection, not the message, and
+ * forwarding them lets a client dictate framing on a socket it does not own.
+ */
+const HOP_BY_HOP = new Set([
+  "connection",
+  "keep-alive",
+  "proxy-authenticate",
+  "proxy-authorization",
+  "te",
+  "trailer",
+  "transfer-encoding",
+  "upgrade",
+]);
+
+/**
+ * Everything `codev-agent` needs from the browser, and nothing else.
+ *
+ * `authorization` and `cookie` are absent on purpose and that absence is the
+ * deliverable: t3code's own browser session is not approval authority and is
+ * never handed to another server.
+ */
+const FORWARDED = new Set([
+  "accept",
+  "content-type",
+  "x-codev-machine-credential",
+  "x-codev-pairing-token",
+  "x-codev-human-session",
+  "x-codev-approval-receipt",
+]);
+
+/**
+ * What survives the hop.
+ *
+ * The allowlist is the primary control, and `Connection`'s own listed tokens are
+ * subtracted from it anyway. That is not belt and braces: `Connection` names
+ * headers that are themselves hop-by-hop, so a request declaring
+ * `Connection: x-codev-machine-credential` is asking for that header to be
+ * connection-scoped — and an allowlist alone would forward it. A port that
+ * hardcodes only the fixed list satisfies the sentence "strips hop-by-hop
+ * headers" and is wrong in exactly this case.
+ */
+export function forwardableHeaders(
+  headers: Readonly<Record<string, string | readonly string[] | undefined>>,
+  hostHeader: string,
+): Record<string, string> {
+  const connectionTokens = new Set(
+    String(headers.connection ?? "")
+      .split(",")
+      .map((token) => token.trim().toLowerCase())
+      .filter((token) => token !== ""),
+  );
+  const out: Record<string, string> = {};
+  for (const [name, value] of Object.entries(headers)) {
+    const lower = name.toLowerCase();
+    if (!FORWARDED.has(lower)) continue;
+    if (HOP_BY_HOP.has(lower) || connectionTokens.has(lower)) continue;
+    if (value === undefined) continue;
+    out[lower] = Array.isArray(value) ? value.join(", ") : String(value);
+  }
+  // The upstream's host, not the browser's. Set last so nothing above can win.
+  out.host = hostHeader;
+  return out;
+}
+
+/**
+ * Bound on how long the upstream may take to produce response headers.
+ *
+ * Every route this proxy carries is a bounded request/response, so unlike
+ * `client-static.ts` this is a bound on the whole exchange rather than on headers
+ * alone — there is no SSE stream here that is meant to outlive it. An approval
+ * SUBMIT returns at once and is polled; it is the poll that waits, one request at
+ * a time.
+ */
+export const UPSTREAM_TIMEOUT_MS = 15_000;
+
+export type ProxyOutcome =
+  | {
+      readonly kind: "answered";
+      readonly status: number;
+      readonly contentType: string | undefined;
+      readonly body: Uint8Array;
+    }
+  /**
+   * The upstream answered with a redirect, which is REFUSED rather than passed on.
+   *
+   * Handing a 3xx back to the page would have the browser follow it — to whatever
+   * origin the `Location` names, cross-origin, with the request's credentials.
+   * That is the escape the configured-target allowlist exists to close, arriving
+   * one hop later. Refusing it server-side is the only place it can be refused.
+   */
+  | { readonly kind: "redirect"; readonly status: number; readonly location: string | undefined }
+  | { readonly kind: "unreachable"; readonly detail: string }
+  | { readonly kind: "silent"; readonly timeoutMs: number };
+
+/**
+ * One hop, buffered, with redirects unfollowed.
+ *
+ * `node:http` rather than Effect's `HttpClient` for two reasons that are the
+ * phase's own deliverables: it does not follow redirects, and its `error` event
+ * and its request timeout are separately observable — which is what lets an
+ * unreachable host and a silent one keep their own signals.
+ */
+export function proxyToAgent(input: {
+  readonly origin: string;
+  readonly path: string;
+  readonly method: "GET" | "POST";
+  readonly headers: Readonly<Record<string, string | readonly string[] | undefined>>;
+  readonly body: Uint8Array | undefined;
+  readonly timeoutMs?: number;
+}): Promise<ProxyOutcome> {
+  const target = new URL(input.origin);
+  const transport = target.protocol === "https:" ? NodeHttps : NodeHttp;
+  const timeoutMs = input.timeoutMs ?? UPSTREAM_TIMEOUT_MS;
+  const headers = forwardableHeaders(input.headers, target.host);
+  if (input.body !== undefined) headers["content-length"] = String(input.body.byteLength);
+
+  return new Promise<ProxyOutcome>((resolve) => {
+    let settled = false;
+    const settle = (outcome: ProxyOutcome): void => {
+      if (settled) return;
+      settled = true;
+      resolve(outcome);
+    };
+
+    const upstream = transport.request(
+      {
+        host: target.hostname,
+        // '' for a default port, which `request` reads as "the module's default" —
+        // 443 for https, 80 for http. Correct for both only because the module varies.
+        port: target.port,
+        path: input.path,
+        method: input.method,
+        headers,
+      },
+      (answer) => {
+        const status = answer.statusCode ?? 502;
+        if (status >= 300 && status < 400) {
+          answer.resume();
+          upstream.destroy();
+          const location = answer.headers.location;
+          settle({
+            kind: "redirect",
+            status,
+            location: Array.isArray(location) ? location[0] : location,
+          });
+          return;
+        }
+        const chunks: Buffer[] = [];
+        answer.on("data", (chunk: Buffer) => chunks.push(chunk));
+        answer.on("end", () => {
+          const contentType = answer.headers["content-type"];
+          settle({
+            kind: "answered",
+            status,
+            contentType: Array.isArray(contentType) ? contentType[0] : contentType,
+            body: new Uint8Array(Buffer.concat(chunks)),
+          });
+        });
+        answer.on("aborted", () =>
+          settle({ kind: "unreachable", detail: "the connection was aborted mid-response" }),
+        );
+        answer.on("error", (error: Error) => settle({ kind: "unreachable", detail: error.message }));
+      },
+    );
+
+    upstream.setTimeout(timeoutMs, () => {
+      /*
+       * A SEPARATE SIGNAL FROM `unreachable`, because these are different facts
+       * wanting different next actions: one host refused the connection, the
+       * other accepted it and then said nothing. Reporting a silent host as a
+       * dead one sends an operator to check whether it is running, which it is.
+       */
+      upstream.destroy();
+      settle({ kind: "silent", timeoutMs });
+    });
+    upstream.on("error", (error: Error) => settle({ kind: "unreachable", detail: error.message }));
+    if (input.body !== undefined) upstream.write(input.body);
+    upstream.end();
+  });
+}
+
+/** `/api/codev/agent/<id><rest>` split into its two halves, or null. */
+export function splitProxyPath(pathname: string): { readonly targetId: string; readonly rest: string } | null {
+  if (!pathname.startsWith(`${CODEV_AGENT_PROXY_PREFIX}/`)) return null;
+  const suffix = pathname.slice(`${CODEV_AGENT_PROXY_PREFIX}/`.length);
+  const separator = suffix.indexOf("/");
+  if (separator <= 0) return null;
+  return { targetId: suffix.slice(0, separator), rest: suffix.slice(separator) };
+}
+
+/**
+ * A path segment that is trying to be a URL.
+ *
+ * Refused with its own signal rather than left to fall off the end of the route
+ * allowlist. The allowlist would refuse it either way, but "this is not a path"
+ * and "this path is not carried" are different answers, and normalising a URL
+ * into a path is how a proxy acquires a target its operator never configured.
+ */
+export function isAbsoluteRequestPath(rest: string): boolean {
+  return /^\/+[a-zA-Z][a-zA-Z0-9+.-]*:/.test(rest) || rest.startsWith("//");
+}
+
+/**
+ * `jsonUnsafe`, not `json`, and the reason is which failures are possible.
+ *
+ * `json` can fail to encode and hands back an Effect that must be handled; every
+ * body here is an object this module built out of strings, so there is nothing to
+ * handle and an error channel for it would be a branch no test could reach.
+ */
+const refusal = (
+  status: number,
+  signal: string,
+  message: string,
+  extra: Record<string, unknown> = {},
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.setHeader(
+    HttpServerResponse.jsonUnsafe({ signal, message, ...extra }, { status }),
+    "Cache-Control",
+    "no-store",
+  );
+
+/**
+ * Which targets exist, by id. Their origins do not travel to the page.
+ *
+ * The page selects by id, so it has no use for the origin, and a page that never
+ * holds one cannot be talked into naming one. The read's reason for being empty
+ * DOES travel, because a picker with no entries and no explanation reads as a
+ * broken feature rather than an unconfigured one.
+ */
+export const codevAgentTargetsRouteLayer = HttpRouter.add(
+  "GET",
+  CODEV_AGENT_TARGETS_PATH,
+  Effect.gen(function* () {
+    yield* authenticateRawRouteWithScope(AuthOrchestrationReadScope);
+    const read = readCodevAgentTargets();
+    const body = read.ok
+      ? { targets: read.targets.map((target) => ({ id: target.id })), rejected: read.rejected }
+      : { signal: read.signal, message: read.message, targets: [], rejected: read.rejected };
+    // 200 WITH A STATED REASON, not an error status: a configuration problem is
+    // something a person acts on, and a 500 renders as a server having a bad
+    // minute, which is a different situation with a different fix.
+    return HttpServerResponse.setHeader(
+      HttpServerResponse.jsonUnsafe(body, { status: 200 }),
+      "Cache-Control",
+      "no-store",
+    );
+  }).pipe(
+    Effect.catchTags({
+      EnvironmentAuthInvalidError: HttpServerRespondable.toResponse,
+      EnvironmentInternalError: HttpServerRespondable.toResponse,
+      EnvironmentScopeRequiredError: HttpServerRespondable.toResponse,
+    }),
+  ),
+);
+
+const proxyHandler = (method: "GET" | "POST") =>
+  Effect.gen(function* () {
+    /*
+     * t3code's own session gates USE OF THE PROXY, and does nothing else.
+     *
+     * Without it this server is an open hop to a loopback service for anyone who
+     * can reach it. It is emphatically not approval authority — `codev-agent`
+     * still requires the machine credential and the human session, and neither
+     * of those is derived from being signed in here.
+     */
+    yield* authenticateRawRouteWithScope(
+      method === "GET" ? AuthOrchestrationReadScope : AuthOrchestrationOperateScope,
+    );
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const url = HttpServerRequest.toURL(request);
+    if (Option.isNone(url)) {
+      return refusal(400, "CODEV_AGENT_REQUEST_MALFORMED", "the request URL could not be read");
+    }
+
+    const split = splitProxyPath(url.value.pathname);
+    if (split === null) {
+      return refusal(
+        404,
+        "CODEV_AGENT_PATH_NOT_ALLOWED",
+        `a proxied request is ${CODEV_AGENT_PROXY_PREFIX}/<target-id>/<agent-path>; this named no target`,
+      );
+    }
+    if (isAbsoluteRequestPath(split.rest)) {
+      return refusal(
+        400,
+        "CODEV_AGENT_PATH_ABSOLUTE",
+        "the proxied path is a URL rather than a path. The upstream is chosen by configured id; "
+          + "an origin named in the request is refused, not normalised.",
+      );
+    }
+
+    const read = readCodevAgentTargets();
+    if (!read.ok) {
+      return refusal(503, read.signal, read.message, { rejected: read.rejected });
+    }
+    const target = read.targets.find((candidate) => candidate.id === split.targetId);
+    if (target === undefined) {
+      return refusal(
+        404,
+        "CODEV_AGENT_UNKNOWN_TARGET",
+        `no codev-agent target "${split.targetId}" is configured on this server`,
+      );
+    }
+
+    const route = matchProxiedAgentRoute(method, split.rest);
+    if (route === null) {
+      return refusal(
+        404,
+        "CODEV_AGENT_PATH_NOT_ALLOWED",
+        `this proxy does not carry ${method} ${split.rest}`,
+      );
+    }
+
+    const body =
+      method === "POST"
+        ? yield* request.arrayBuffer.pipe(
+            Effect.map((buffer) => new Uint8Array(buffer)),
+            Effect.orElseSucceed(() => null),
+          )
+        : undefined;
+    if (body === null) {
+      return refusal(400, "CODEV_AGENT_REQUEST_MALFORMED", "the request body could not be read");
+    }
+
+    const outcome = yield* Effect.promise(() =>
+      proxyToAgent({
+        origin: target.origin,
+        path: `${split.rest}${url.value.search}`,
+        method,
+        headers: request.headers,
+        body,
+      }),
+    );
+
+    if (outcome.kind === "redirect") {
+      return refusal(
+        502,
+        "CODEV_AGENT_REDIRECT_REFUSED",
+        `${target.id} answered ${outcome.status} with a redirect`
+          + `${outcome.location === undefined ? "" : ` to ${outcome.location}`}. Redirects are not `
+          + "followed and not passed on: the page would follow it to an origin nobody configured.",
+      );
+    }
+    if (outcome.kind === "silent") {
+      return refusal(
+        504,
+        "CODEV_AGENT_UPSTREAM_TIMEOUT",
+        `${target.id} accepted the connection and sent no response within ${outcome.timeoutMs}ms`,
+      );
+    }
+    if (outcome.kind === "unreachable") {
+      return refusal(
+        502,
+        "CODEV_AGENT_UPSTREAM_GONE",
+        `${target.id} did not answer: ${outcome.detail}`,
+      );
+    }
+
+    /*
+     * The upstream's status and body travel; its HEADERS do not, beyond the
+     * content type. A proxy that copied them would carry `set-cookie` from one
+     * origin onto another, and every route here answers JSON.
+     */
+    return HttpServerResponse.setHeader(
+      HttpServerResponse.uint8Array(outcome.body, {
+        status: outcome.status,
+        contentType: outcome.contentType ?? "application/json",
+      }),
+      "Cache-Control",
+      "no-store",
+    );
+  }).pipe(
+    Effect.catchTags({
+      EnvironmentAuthInvalidError: HttpServerRespondable.toResponse,
+      EnvironmentInternalError: HttpServerRespondable.toResponse,
+      EnvironmentScopeRequiredError: HttpServerRespondable.toResponse,
+    }),
+  );
+
+export const codevAgentProxyGetRouteLayer = HttpRouter.add(
+  "GET",
+  `${CODEV_AGENT_PROXY_PREFIX}/*`,
+  proxyHandler("GET"),
+);
+
+export const codevAgentProxyPostRouteLayer = HttpRouter.add(
+  "POST",
+  `${CODEV_AGENT_PROXY_PREFIX}/*`,
+  proxyHandler("POST"),
+);
