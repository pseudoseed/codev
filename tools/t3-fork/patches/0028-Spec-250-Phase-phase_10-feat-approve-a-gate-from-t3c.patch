+          body: { operationId: "op-1", receipt: "rcpt", projectId: "250", gateName: "plan-approval" },
+        },
+        "/gates/approvals/op-1": {
+          status: 200,
+          body: {
+            state: "interrupted",
+            projectId: "250",
+            gateName: "plan-approval",
+            message: "the host stopped mid-approval",
+          },
+        },
+      }),
+      pairing,
+      session,
+      gate,
+    );
+    expect(outcome.ok).toBe(false);
+    if (outcome.ok) return;
+    expect(outcome.unconfirmed).toBe(true);
+    expect(outcome.signal).toBe("APPROVAL_OPERATION_INTERRUPTED");
+  });
+
