+/**
+ * Codev customization (spec 250), phase 10 — the same-origin proxy.
+ *
+ * The assertions worth naming, because they are the ones a plausible-looking
+ * port fails:
+ *
+ *  - a request whose `Connection` header NAMES a forwarded header. A port that
+ *    strips only the fixed hop-by-hop list forwards it, and the header it
+ *    forwards is a machine credential.
+ *  - `authorization` and `cookie` do not travel. t3code's own session is not
+ *    approval authority, and handing it to another server is the failure the
+ *    allowlist exists to make impossible rather than merely unlikely.
+ *  - unreachable and silent keep separate signals, and both are driven against
+ *    real sockets rather than asserted from a mock — a closed port and a server
+ *    that accepts and never answers.
+ *  - a redirect from the configured origin is refused, not passed on. Passed on,
+ *    the browser would follow it cross-origin.
+ *  - unconfigured, all-rejected, and configured-with-rejections are three
+ *    answers with three signals.
+ */
+
+// @effect-diagnostics nodeBuiltinImport:off
+import * as NodeHttp from "node:http";
+import * as NodeNet from "node:net";
+import { afterEach, describe, expect, it } from "vite-plus/test";
+
+import {
+  CODEV_AGENT_ORIGINS_ENV,
+  CODEV_AGENT_PROXY_PREFIX,
+  forwardableHeaders,
+  isAbsoluteRequestPath,
+  matchProxiedAgentRoute,
+  originProblem,
+  proxyToAgent,
+  readCodevAgentTargets,
+  splitProxyPath,
+} from "./agentProxy.ts";
+
+const servers: NodeHttp.Server[] = [];
+const sockets: NodeNet.Server[] = [];
+
+afterEach(() => {
+  for (const server of servers.splice(0)) server.close();
+  for (const socket of sockets.splice(0)) socket.close();
+});
+
+function listen(server: NodeHttp.Server): Promise<string> {
+  servers.push(server);
+  return new Promise((resolve) => {
+    server.listen(0, "127.0.0.1", () => {
+      const address = server.address();
+      resolve(`http://127.0.0.1:${typeof address === "object" && address ? address.port : 0}`);
+    });
+  });
+}
+
+describe("codev agent targets (spec 250, phase 10)", () => {
+  it("says nothing is configured, and names the variable that would configure it", () => {
+    const read = readCodevAgentTargets({});
+    expect(read.ok).toBe(false);
+    if (read.ok) return;
+    expect(read.signal).toBe("CODEV_AGENTS_UNCONFIGURED");
+    expect(read.message).toContain(CODEV_AGENT_ORIGINS_ENV);
+  });
+
+  it("reads id=origin entries", () => {
+    const read = readCodevAgentTargets({
+      [CODEV_AGENT_ORIGINS_ENV]: "local=http://127.0.0.1:4100, mesh=https://box.example.ts.net",
+    });
+    expect(read.ok).toBe(true);
+    if (!read.ok) return;
+    expect(read.targets).toEqual([
+      { id: "local", origin: "http://127.0.0.1:4100" },
+      { id: "mesh", origin: "https://box.example.ts.net" },
+    ]);
+    expect(read.rejected).toEqual([]);
+  });
+
+  /**
+   * The distinction the whole union exists for. An operator who configured
+   * nothing and one whose every entry was rejected both end up with no targets,
+   * and they need opposite next actions.
+   */
+  it("distinguishes 'configured nothing' from 'everything configured was rejected'", () => {
+    const read = readCodevAgentTargets({ [CODEV_AGENT_ORIGINS_ENV]: "local=ftp://host" });
+    expect(read.ok).toBe(false);
+    if (read.ok) return;
+    expect(read.signal).toBe("CODEV_AGENTS_ALL_REJECTED");
+    expect(read.rejected).toHaveLength(1);
+    expect(read.rejected[0]?.problem).toContain("ftp:");
+  });
+
+  it("reports a rejected entry alongside the ones it accepted, rather than dropping it", () => {
+    const read = readCodevAgentTargets({
+      [CODEV_AGENT_ORIGINS_ENV]: "local=http://127.0.0.1:4100,broken=notaurl",
+    });
+    expect(read.ok).toBe(true);
+    if (!read.ok) return;
+    expect(read.targets.map((target) => target.id)).toEqual(["local"]);
+    expect(read.rejected).toEqual([{ entry: "broken=notaurl", problem: "origin is not a URL" }]);
+  });
+
+  it("refuses a repeated id rather than silently keeping one of them", () => {
+    const read = readCodevAgentTargets({
+      [CODEV_AGENT_ORIGINS_ENV]: "local=http://127.0.0.1:4100,local=http://127.0.0.1:4200",
+    });
+    expect(read.ok).toBe(true);
+    if (!read.ok) return;
+    expect(read.targets).toHaveLength(1);
+    expect(read.rejected[0]?.problem).toContain('repeats the id "local"');
+  });
+
+  it("refuses an id containing a slash, which would widen the proxy prefix", () => {
+    const read = readCodevAgentTargets({
+      [CODEV_AGENT_ORIGINS_ENV]: "a/b=http://127.0.0.1:4100",
+    });
+    expect(read.ok).toBe(false);
+    if (read.ok) return;
+    expect(read.rejected[0]?.problem).toContain("containing /");
+  });
+});
+
+describe("codev agent origin rules (spec 250, phase 10)", () => {
+  it("accepts loopback http and any https", () => {
+    expect(originProblem("http://127.0.0.1:4100")).toBeNull();
+    expect(originProblem("http://localhost:4100")).toBeNull();
+    expect(originProblem("https://box.example.ts.net")).toBeNull();
+  });
+
+  it("refuses plaintext http to a non-loopback host, which would leak the credential", () => {
+    expect(originProblem("http://box.example.ts.net")).toContain("in the clear");
+  });
+
+  it("refuses a scheme that is not http or https", () => {
+    expect(originProblem("file:///etc/passwd")).toContain("only http: and https:");
+  });
+
+  it("refuses credentials in the URL", () => {
+    expect(originProblem("https://user:pass@box.example.ts.net")).toContain("credentials in the URL");
+  });
+
+  it("refuses an origin carrying a path, query or fragment", () => {
+    expect(originProblem("https://box.example.ts.net/agent")).toContain("bare origin");
+    expect(originProblem("https://box.example.ts.net/?x=1")).toContain("bare origin");
+  });
+});
+
+describe("codev agent route allowlist (spec 250, phase 10)", () => {
+  it("carries the approval ceremony and the workspace state read", () => {
+    const carried: ReadonlyArray<readonly ["GET" | "POST", string]> = [
+      ["POST", "/api/agent/v1/pairing/redeem"],
+      ["POST", "/api/agent/v1/human-sessions"],
+      ["GET", "/api/agent/v1/session"],
+      ["POST", "/api/agent/v1/approval-capabilities"],
+      ["POST", "/api/agent/v1/approval-nonces"],
+      ["POST", "/api/agent/v1/workspaces/d29ya3NwYWNl/gates/approve"],
+      ["POST", "/api/agent/v1/workspaces/d29ya3NwYWNl/gates/approvals"],
+      ["GET", "/api/agent/v1/workspaces/d29ya3NwYWNl/gates/approvals/op-1"],
+      ["GET", "/api/agent/v1/workspaces/d29ya3NwYWNl/state"],
+    ];
+    for (const [method, path] of carried) {
+      expect(matchProxiedAgentRoute(method, path), `${method} ${path}`).not.toBeNull();
+    }
+  });
+
+  /**
+   * Absent on purpose, each for its own reason: the stream is SSE and this proxy
+   * buffers; revocation is an operator act at a terminal, and a browser that
+   * could revoke could deny a human their own gate.
+   */
+  it("does not carry the stream or either revocation route", () => {
+    expect(matchProxiedAgentRoute("GET", "/api/agent/v1/workspaces/d29ya3NwYWNl/stream")).toBeNull();
+    expect(matchProxiedAgentRoute("DELETE", "/api/agent/v1/machines/alpha")).toBeNull();
+    expect(
+      matchProxiedAgentRoute("DELETE", "/api/agent/v1/approval-capabilities/machine/alpha"),
+    ).toBeNull();
+  });
+
+  it("refuses a carried path under the wrong method", () => {
+    expect(matchProxiedAgentRoute("GET", "/api/agent/v1/pairing/redeem")).toBeNull();
+    expect(matchProxiedAgentRoute("POST", "/api/agent/v1/workspaces/w/state")).toBeNull();
+  });
+
+  it("refuses anything outside the agent prefix", () => {
+    expect(matchProxiedAgentRoute("GET", "/api/orchestration/threads")).toBeNull();
+    expect(matchProxiedAgentRoute("GET", "/")).toBeNull();
+  });
+
+  it("does not let an extra path segment slip past a pattern", () => {
+    expect(
+      matchProxiedAgentRoute("GET", "/api/agent/v1/workspaces/one/two/state"),
+    ).toBeNull();
+  });
+});
+
+describe("codev agent proxy path split (spec 250, phase 10)", () => {
+  it("splits the target id from the upstream path", () => {
+    expect(splitProxyPath(`${CODEV_AGENT_PROXY_PREFIX}/local/api/agent/v1/session`)).toEqual({
+      targetId: "local",
+      rest: "/api/agent/v1/session",
+    });
+  });
+
+  it("refuses a prefix that names no target", () => {
+    expect(splitProxyPath(CODEV_AGENT_PROXY_PREFIX)).toBeNull();
+    expect(splitProxyPath(`${CODEV_AGENT_PROXY_PREFIX}/local`)).toBeNull();
+    expect(splitProxyPath("/api/observability/v1/traces")).toBeNull();
+  });
+
+  /**
+   * The SSRF shape the configured-target rule exists to close: a URL arriving
+   * where a path belongs. It has its own answer rather than falling off the end
+   * of the allowlist, because "this is not a path" and "this path is not
+   * carried" send a reader to two different places.
+   */
+  it("recognises a URL arriving in place of a path", () => {
+    expect(isAbsoluteRequestPath("/http://169.254.169.254/latest/meta-data")).toBe(true);
+    expect(isAbsoluteRequestPath("//169.254.169.254/latest/meta-data")).toBe(true);
+    expect(isAbsoluteRequestPath("/api/agent/v1/session")).toBe(false);
+  });
+});
+
+describe("codev agent proxy headers (spec 250, phase 10)", () => {
+  it("forwards what codev-agent needs and sets the upstream host", () => {
+    expect(
+      forwardableHeaders(
+        {
+          accept: "application/json",
+          "content-type": "application/json",
+          "x-codev-machine-credential": "cred-1.secret",
+          "x-codev-human-session": "sess-1",
+          host: "t3code.example",
+        },
+        "127.0.0.1:4100",
+      ),
+    ).toEqual({
+      accept: "application/json",
+      "content-type": "application/json",
+      "x-codev-machine-credential": "cred-1.secret",
+      "x-codev-human-session": "sess-1",
+      host: "127.0.0.1:4100",
+    });
+  });
+
+  /**
+   * THE ONE A FIXED-LIST PORT FAILS.
+   *
+   * `Connection` names headers that are themselves hop-by-hop for this
+   * connection. A port that strips only the fixed list — or one that trusts its
+   * allowlist alone — forwards whatever `Connection` points at, and here it
+   * points at the machine credential.
+   */
+  it("strips a forwarded header that the request's own Connection header names", () => {
+    const forwarded = forwardableHeaders(
+      {
+        connection: "keep-alive, X-Codev-Machine-Credential",
+        "x-codev-machine-credential": "cred-1.secret",
+        accept: "application/json",
+      },
+      "127.0.0.1:4100",
+    );
+    expect(forwarded["x-codev-machine-credential"]).toBeUndefined();
+    expect(forwarded.accept).toBe("application/json");
+    expect(forwarded.connection).toBeUndefined();
+  });
+
+  /**
+   * t3code's own session does not travel. Being signed into t3code is not
+   * approval authority, and forwarding its bearer would hand another server
+   * t3code's identity.
+   */
+  it("never forwards t3code's own session", () => {
+    const forwarded = forwardableHeaders(
+      {
+        authorization: "Bearer t3code-session",
+        cookie: "t3code_session=abc",
+        "x-codev-machine-credential": "cred-1.secret",
+      },
+      "127.0.0.1:4100",
+    );
+    expect(forwarded.authorization).toBeUndefined();
+    expect(forwarded.cookie).toBeUndefined();
+    expect(forwarded["x-codev-machine-credential"]).toBe("cred-1.secret");
+  });
+
+  it("drops every header nobody put on the list", () => {
+    const forwarded = forwardableHeaders(
+      { "x-forwarded-for": "10.0.0.1", "user-agent": "curl", referer: "https://elsewhere" },
+      "127.0.0.1:4100",
+    );
+    expect(Object.keys(forwarded)).toEqual(["host"]);
+  });
+});
+
+describe("codev agent proxy hop (spec 250, phase 10)", () => {
+  it("carries status, body and content type back", async () => {
+    const origin = await listen(
+      NodeHttp.createServer((_request, response) => {
+        response.writeHead(201, { "content-type": "application/json" });
+        response.end(JSON.stringify({ signal: "PAIRING_TOKEN_ACCEPTED" }));
+      }),
+    );
+    const outcome = await proxyToAgent({
+      origin,
+      path: "/api/agent/v1/pairing/redeem",
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: new TextEncoder().encode("{}"),
+    });
+    expect(outcome.kind).toBe("answered");
+    if (outcome.kind !== "answered") return;
+    expect(outcome.status).toBe(201);
+    expect(outcome.contentType).toBe("application/json");
+    expect(JSON.parse(new TextDecoder().decode(outcome.body))).toEqual({
+      signal: "PAIRING_TOKEN_ACCEPTED",
+    });
+  });
+
+  it("sends only the forwardable headers upstream", async () => {
+    let received: NodeHttp.IncomingHttpHeaders = {};
+    const origin = await listen(
+      NodeHttp.createServer((request, response) => {
+        received = request.headers;
+        response.writeHead(200, { "content-type": "application/json" });
+        response.end("{}");
+      }),
+    );
+    await proxyToAgent({
+      origin,
+      path: "/api/agent/v1/session",
+      method: "GET",
+      headers: {
+        authorization: "Bearer t3code-session",
+        cookie: "t3code_session=abc",
+        "x-codev-machine-credential": "cred-1.secret",
+      },
+      body: undefined,
+    });
+    expect(received.authorization).toBeUndefined();
+    expect(received.cookie).toBeUndefined();
+    expect(received["x-codev-machine-credential"]).toBe("cred-1.secret");
+  });
+
+  /**
+   * Refused rather than passed on. Handed to the page, the browser would follow
+   * it — to whatever origin `Location` names, cross-origin, with the request's
+   * credentials — which is the escape the configured-target rule closes one hop
+   * earlier.
+   */
+  it("refuses a redirect instead of following or forwarding it", async () => {
+    const origin = await listen(
+      NodeHttp.createServer((_request, response) => {
+        response.writeHead(302, { location: "http://169.254.169.254/latest/meta-data" });
+        response.end();
+      }),
+    );
+    const outcome = await proxyToAgent({
+      origin,
+      path: "/api/agent/v1/session",
+      method: "GET",
+      headers: {},
+      body: undefined,
+    });
+    expect(outcome.kind).toBe("redirect");
+    if (outcome.kind !== "redirect") return;
+    expect(outcome.status).toBe(302);
+    expect(outcome.location).toBe("http://169.254.169.254/latest/meta-data");
+  });
+
+  /** Refused the connection. */
+  it("reports an unreachable host as its own signal", async () => {
+    const server = NodeHttp.createServer(() => {});
+    const origin = await listen(server);
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+    const outcome = await proxyToAgent({
+      origin,
+      path: "/api/agent/v1/session",
+      method: "GET",
+      headers: {},
+      body: undefined,
+    });
+    expect(outcome.kind).toBe("unreachable");
+  });
+
+  /**
+   * Accepted the connection and said nothing. A DIFFERENT signal from
+   * unreachable: reporting a silent host as a dead one sends an operator to
+   * check whether it is running, which it is.
+   */
+  it("reports a silent host as its own signal, distinct from unreachable", async () => {
+    const socket = NodeNet.createServer(() => {
+      /* accept and never answer */
+    });
+    sockets.push(socket);
+    const port = await new Promise<number>((resolve) => {
+      socket.listen(0, "127.0.0.1", () => {
+        const address = socket.address();
+        resolve(typeof address === "object" && address ? address.port : 0);
+      });
+    });
+    const outcome = await proxyToAgent({
+      origin: `http://127.0.0.1:${port}`,
+      path: "/api/agent/v1/session",
+      method: "GET",
+      headers: {},
+      body: undefined,
+      timeoutMs: 150,
+    });
+    expect(outcome.kind).toBe("silent");
+    if (outcome.kind !== "silent") return;
+    expect(outcome.timeoutMs).toBe(150);
+  });
+});
