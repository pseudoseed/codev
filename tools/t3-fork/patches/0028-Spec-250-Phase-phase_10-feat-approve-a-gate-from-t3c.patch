+  /** An agent predating the field HAS messages it is not sending. */
+  it("reports an absent messageLog as unknown rather than as available", () => {
+    const older = resolvePaneContent(
+      {
+        kind: "read",
+        snapshot: validateAgentSnapshot({
+          ...snapshotBody,
+          protocol: {
+            identities: snapshotBody.protocol.identities,
+          },
+        }) as NonNullable<ReturnType<typeof validateAgentSnapshot>>,
+      },
+      "thread-1",
+    );
+    expect(older.kind).toBe("known");
+    if (older.kind !== "known") return;
+    expect(older.messageLog).toBe("unknown");
+  });
+
+  it("says the agent published no porch project rather than showing an empty phase", () => {
+    const content = resolvePaneContent(
+      {
+        kind: "read",
+        snapshot: validateAgentSnapshot({
+          ...snapshotBody,
+          protocol: {
+            ...snapshotBody.protocol,
+            identities: [{ ...snapshotBody.protocol.identities[0], porch: undefined }],
+          },
+        }) as NonNullable<ReturnType<typeof validateAgentSnapshot>>,
+      },
+      "thread-1",
+    );
+    expect(content.kind).toBe("known");
+    if (content.kind !== "known") return;
+    expect(content.porch).toBeNull();
+  });
+});
