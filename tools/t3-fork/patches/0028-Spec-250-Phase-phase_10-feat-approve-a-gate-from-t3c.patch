+/**
+ * Codev customization (spec 250), phase 10 — the approval walk.
+ *
+ * FOUR OUTCOMES, and the two that a shorter port drops are the ones tested
+ * hardest here. `unconfirmed` and `sessionEnded` are both answers that are not
+ * "no", and each has its own way of being lost:
+ *
+ *   - a 200 whose body this page cannot read is UNCONFIRMED. A port that filled
+ *     `approvedAt` from the browser clock and `machine` from stored state would
+ *     report a complete approval record made of nothing, and would pass a naive
+ *     assertion while recording fiction. That is the test named "server-sourced".
+ *   - a 401 anywhere on the path is `sessionEnded`. Sessions idle out after 30
+ *     minutes, so this is ordinary; folding it into refusal leaves a human with an
+ *     Approve button they can only escape by reloading.
+ */
+
+import { describe, expect, it } from "vite-plus/test";
+
+import { approveGate, openHumanSession, type HumanSession } from "./approval";
+import type { CodevPairing } from "./pairing";
+
+const pairing: CodevPairing = {
+  targetId: "local",
+  machine: "ipad",
+  credential: "cred-1.secret",
+  workspacePath: "/Users/chris/dev/codev",
+};
+
+const session: HumanSession = {
+  sessionId: "sess-1",
+  presentation: "sess-1.secret",
+  expiresAt: "2026-08-31T06:00:00.000Z",
+};
+
+const gate = { projectId: "250", gateName: "plan-approval" } as const;
+
+type Reply = { readonly status: number; readonly body: unknown };
+
+/**
+ * A fetch driven by a path table.
+ *
+ * Keyed on the path so a test states only the step it is about; every other step
+ * takes its ordinary success. A missing key is a loud failure rather than a
+ * silent 404 that would make an unrelated branch pass.
+ */
+function fakeFetch(
+  replies: Readonly<Record<string, Reply>>,
+  seen?: string[],
+): typeof globalThis.fetch {
+  return (async (input: RequestInfo | URL) => {
+    const url = String(input);
+    seen?.push(url);
+    const key = Object.keys(replies).find((candidate) => url.endsWith(candidate));
+    if (key === undefined) throw new Error(`no reply configured for ${url}`);
+    const reply = replies[key] as Reply;
+    return new Response(JSON.stringify(reply.body), { status: reply.status });
+  }) as typeof globalThis.fetch;
+}
+
+const CAPABILITY = {
+  "/approval-capabilities": { status: 201, body: { presentation: "cap.secret", capabilityId: "cap-1" } },
+  "/approval-nonces": { status: 201, body: { nonce: "nonce-1" } },
+} as const;
+
+describe("openHumanSession (spec 250, phase 10)", () => {
+  it("spends a client-session token alongside the machine credential", async () => {
+    const seen: string[] = [];
+    const result = await openHumanSession(
+      fakeFetch(
+        {
+          "/human-sessions": {
+            status: 201,
+            body: { sessionId: "sess-1", presentation: "sess-1.secret", expiresAt: "later" },
+          },
+        },
+        seen,
+      ),
+      pairing,
+      "tok-2",
+    );
+    expect(result.ok).toBe(true);
+    // Same-origin: a path on this server, never the agent's own origin.
+    expect(seen[0]).toBe("/api/codev/agent/local/api/agent/v1/human-sessions");
+  });
+
+  it("refuses a 201 that named no session rather than inventing one", async () => {
+    const result = await openHumanSession(
+      fakeFetch({ "/human-sessions": { status: 201, body: {} } }),
+      pairing,
+      "tok-2",
+    );
+    expect(result.ok).toBe(false);
+  });
+});
+
+describe("approveGate (spec 250, phase 10)", () => {
+  it("approves over the asynchronous route and reports the SERVER's record", async () => {
+    const outcome = await approveGate(
+      fakeFetch({
+        ...CAPABILITY,
+        "/gates/approvals": {
+          status: 202,
+          body: { operationId: "op-1", receipt: "rcpt", projectId: "250", gateName: "plan-approval" },
+        },
+        "/gates/approvals/op-1": {
+          status: 200,
+          body: {
+            state: "succeeded",
+            projectId: "250",
+            gateName: "plan-approval",
+            record: {
+              approvedAt: "2026-08-31T05:30:00.000Z",
+              machine: "ipad",
+              sessionId: "sess-1",
+              authority: "chris",
+            },
+          },
+        },
+      }),
+      pairing,
+      session,
+      gate,
+    );
+    expect(outcome).toEqual({
+      ok: true,
+      approvedAt: "2026-08-31T05:30:00.000Z",
+      machine: "ipad",
+      sessionId: "sess-1",
+      authority: "chris",
