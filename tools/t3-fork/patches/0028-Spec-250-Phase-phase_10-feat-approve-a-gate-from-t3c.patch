+   * same claim as an operation for this gate. A record naming another gate must
+   * not settle this one in either direction.
+   */
+  it("refuses to read another gate's operation as this gate's answer", async () => {
+    const outcome = await approveGate(
+      fakeFetch({
+        ...CAPABILITY,
+        "/gates/approvals": {
+          status: 202,
+          body: { operationId: "op-1", receipt: "rcpt", projectId: "250", gateName: "spec-approval" },
+        },
+      }),
+      pairing,
+      session,
+      gate,
+    );
+    expect(outcome.ok).toBe(false);
+    if (outcome.ok) return;
+    expect(outcome.unconfirmed).toBe(true);
+    expect(outcome.message).toContain("spec-approval");
+  });
+
+  it("refuses a 202 without a receipt, which is not a durable operation", async () => {
+    const outcome = await approveGate(
+      fakeFetch({
+        ...CAPABILITY,
+        "/gates/approvals": {
+          status: 202,
+          body: { operationId: "op-1", projectId: "250", gateName: "plan-approval" },
+        },
+      }),
+      pairing,
+      session,
+      gate,
+    );
+    expect(outcome.ok).toBe(false);
+    if (outcome.ok) return;
