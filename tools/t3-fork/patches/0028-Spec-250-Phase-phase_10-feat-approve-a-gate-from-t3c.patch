diff --git a/apps/web/src/codev/PairingPanel.tsx b/apps/web/src/codev/PairingPanel.tsx
new file mode 100644
index 000000000..6c575cef2
--- /dev/null
+++ b/apps/web/src/codev/PairingPanel.tsx
@@ -0,0 +1,216 @@
+/**
+ * Codev customization (spec 250), phase 10 — pairing this browser with a codev-agent.
+ *
+ * ## t3code gains an entry POINT, not authority
+ *
+ * Everything here travels the ceremony that already exists and is already tested:
+ * `afx pair issue --purpose machine-credential` mints the token this form spends,
+ * and `afx pair revoke <machine>` takes the result away. Nothing in t3code decides
+ * who may approve. Being signed into t3code buys you this form and nothing else.
+ *
+ * ## Four fields, and each one is a thing this browser genuinely does not know
+ *
+ *   target         which configured codev-agent. Chosen from the server's list by
+ *                  id; the origins are the server's and never reach this page.
+ *   machine        the name this credential is issued for, and the name
+ *                  `afx pair revoke` takes back.
+ *   workspace      the absolute workspace path on that host. It identifies which
+ *                  workspace this browser is approving in, and there is no way to
+ *                  derive it from here — t3code's own project path is a different
+ *                  machine's filesystem in the general case.
+ *   token          the one secret a human retypes. Single-use, minutes long.
+ *
+ * ## The token field is not a password field, and that is on purpose
+ *
+ * It is transcribed from a terminal, single-use, and expires in minutes. Masking
+ * it would stop the one person who needs to check they typed it correctly while
+ * protecting a value that is worthless a minute later.
+ */
+
+import { useEffect, useId, useState } from "react";
+
+import { Button } from "../components/ui/button";
+import { Input } from "../components/ui/input";
+import { Label } from "../components/ui/label";
+import { fetchAgentTargets, redeemPairing, type CodevPairing } from "./pairing";
+
+export function PairingPanel(props: {
+  readonly onPaired: (pairing: CodevPairing) => { readonly ok: true } | { readonly ok: false; readonly message: string };
+  readonly onCancel?: () => void;
+  readonly fetchImpl?: typeof globalThis.fetch;
+}) {
+  const { onPaired, onCancel } = props;
+  const fetchImpl = props.fetchImpl ?? globalThis.fetch.bind(globalThis);
+  const ids = useId();
+
+  const [targets, setTargets] = useState<readonly string[] | null>(null);
+  const [targetsProblem, setTargetsProblem] = useState<string | null>(null);
+  const [targetId, setTargetId] = useState("");
+  const [machine, setMachine] = useState("");
+  const [workspacePath, setWorkspacePath] = useState("");
+  const [token, setToken] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [problem, setProblem] = useState<string | null>(null);
+
+  useEffect(() => {
+    let live = true;
+    void fetchAgentTargets(fetchImpl).then((read) => {
+      if (!live) return;
+      if (read.ok) {
+        setTargets(read.targets.map((target) => target.id));
+        setTargetId((current) => (current === "" ? (read.targets[0]?.id ?? "") : current));
+        setTargetsProblem(null);
+        return;
+      }
+      /*
+       * AN EMPTY LIST ALWAYS CARRIES ITS REASON.
+       *
+       * A picker with no entries and no explanation reads as a broken feature.
+       * "Nobody configured a codev-agent on this server" and "this server could
+       * not be asked" send a reader to two different places.
+       */
+      setTargets([]);
+      setTargetsProblem(read.message);
+    });
+    return () => {
+      live = false;
+    };
+  }, [fetchImpl]);
+
+  const ready =
+    targetId.trim() !== "" && machine.trim() !== "" && workspacePath.trim() !== "" && token.trim() !== "";
+
+  async function submit(): Promise<void> {
+    setBusy(true);
+    setProblem(null);
+    try {
+      const outcome = await redeemPairing(fetchImpl, {
+        targetId: targetId.trim(),
+        machine: machine.trim(),
+        token: token.trim(),
+        workspacePath: workspacePath.trim(),
+      });
+      if (!outcome.ok) {
+        // The agent's own signal and words, verbatim. A refusal reworded here
+        // would be this page guessing at a decision another server made.
+        setProblem(`${outcome.signal}: ${outcome.message}`);
+        return;
+      }
+      const stored = onPaired(outcome.pairing);
+      if (!stored.ok) {
+        /*
+         * The credential was issued and this browser cannot keep it. Saying
+         * "pairing failed" would send the human to spend another token on a
+         * problem another token will not fix — the token is already spent.
+         */
+        setProblem(
+          `the agent issued a credential and this browser could not store it (${stored.message}). `
+            + "That token is spent; mint another once storage works.",
+        );
+        return;
+      }
+      setToken("");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <form
+      data-testid="codev-pairing-panel"
+      className="flex min-w-0 flex-col gap-3 rounded-lg border border-sidebar-border/60 bg-card p-3 text-sm"
+      onSubmit={(event) => {
+        event.preventDefault();
+        if (ready && !busy) void submit();
+      }}
+    >
+      <div className="flex min-w-0 flex-col gap-1">
+        <p className="font-medium text-card-foreground">Pair this browser with codev-agent</p>
+        <p data-testid="codev-pairing-explainer" className="text-muted-foreground text-xs">
+          Approving a gate needs a machine credential of its own. Mint a token with{" "}
+          <code className="font-mono">afx pair issue --purpose machine-credential</code> and paste it
+          below. Signing into t3code does not grant approval; this credential does, and{" "}
+          <code className="font-mono">afx pair revoke</code> takes it away.
+        </p>
+      </div>
+
+      <div className="flex min-w-0 flex-col gap-1">
+        <Label htmlFor={`${ids}-target`}>codev-agent</Label>
+        {targets !== null && targets.length === 0 ? (
+          <p data-testid="codev-pairing-no-targets" className="text-muted-foreground text-xs">
+            {targetsProblem ?? "this server proxies to no codev-agent, and did not say why"}
+          </p>
+        ) : (
+          <select
+            id={`${ids}-target`}
+            data-testid="codev-pairing-target"
+            value={targetId}
+            onChange={(event) => setTargetId(event.target.value)}
+            className="h-8 min-w-0 rounded-md border border-input bg-popover px-2 text-sm"
+          >
+            {targets === null ? <option value="">Loading…</option> : null}
+            {(targets ?? []).map((id) => (
+              <option key={id} value={id}>
+                {id}
+              </option>
+            ))}
+          </select>
+        )}
+      </div>
+
+      <div className="flex min-w-0 flex-col gap-1">
+        <Label htmlFor={`${ids}-machine`}>Machine name</Label>
+        <Input
+          id={`${ids}-machine`}
+          data-testid="codev-pairing-machine"
+          value={machine}
+          onChange={(event) => setMachine(event.target.value)}
+          placeholder="ipad"
+          autoComplete="off"
+        />
+      </div>
+
+      <div className="flex min-w-0 flex-col gap-1">
+        <Label htmlFor={`${ids}-workspace`}>Workspace path</Label>
+        <Input
+          id={`${ids}-workspace`}
+          data-testid="codev-pairing-workspace"
+          value={workspacePath}
+          onChange={(event) => setWorkspacePath(event.target.value)}
+          placeholder="/Users/you/dev/your-workspace"
+          autoComplete="off"
+          spellCheck={false}
+        />
+      </div>
+
+      <div className="flex min-w-0 flex-col gap-1">
+        <Label htmlFor={`${ids}-token`}>Pairing token</Label>
+        <Input
+          id={`${ids}-token`}
+          data-testid="codev-pairing-token"
+          value={token}
+          onChange={(event) => setToken(event.target.value)}
+          autoComplete="off"
+          spellCheck={false}
+        />
+      </div>
+
+      {problem === null ? null : (
+        <p data-testid="codev-pairing-problem" className="text-destructive-foreground text-xs">
+          {problem}
+        </p>
+      )}
+
+      <div className="flex shrink-0 items-center gap-2">
+        <Button type="submit" size="sm" disabled={!ready || busy} data-testid="codev-pairing-submit">
+          {busy ? "Pairing…" : "Pair"}
+        </Button>
+        {onCancel === undefined ? null : (
+          <Button type="button" size="sm" variant="ghost" onClick={onCancel}>
+            Cancel
+          </Button>
+        )}
+      </div>
+    </form>
+  );
+}
