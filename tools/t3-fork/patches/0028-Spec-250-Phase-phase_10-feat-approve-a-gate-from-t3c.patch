+/**
+ * Codev customization (spec 250), phase 10 — the two paths the proxy lives at.
+ *
+ * Two consumers must agree on these, and drift between them is silent: the
+ * server registers routes here (`apps/server/src/codev/agentProxy.ts`) and the
+ * web app builds its URLs from them (`apps/web/src/codev/pairing.ts`). A prefix
+ * only one side knows produces a 404 that reads as a broken feature rather than
+ * as a mismatch — the same reason `devProxy.ts` next door holds its list once.
+ *
+ * They sit under `/api` deliberately: `DEV_PROXIED_PATH_PREFIXES` already
+ * carries `/api`, so browser dev reaches them through the Vite proxy and the
+ * page stays same-origin without a second entry to keep in step.
+ */
+
+/** `${CODEV_AGENT_PROXY_PREFIX}/<target-id>/<agent-path>`. */
+export const CODEV_AGENT_PROXY_PREFIX = "/api/codev/agent";
+
+/** Which `codev-agent` targets this server is configured to reach, by id. */
+export const CODEV_AGENT_TARGETS_PATH = "/api/codev/agent-targets";
