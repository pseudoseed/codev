+  /** Ordinary, not exceptional: sessions idle out after 30 minutes. */
+  it("reports a 401 as sessionEnded rather than as a refusal", async () => {
+    const outcome = await approveGate(
+      fakeFetch({
+        ...CAPABILITY,
+        "/gates/approvals": { status: 401, body: { signal: "HUMAN_SESSION_REQUIRED" } },
+      }),
+      pairing,
+      session,
+      gate,
+    );
+    expect(outcome.ok).toBe(false);
+    if (outcome.ok) return;
+    expect(outcome.sessionEnded).toBe(true);
+    expect(outcome.unconfirmed).toBeUndefined();
+  });
+
+  it("reports an interrupted host as unconfirmed, because the gate may be approved", async () => {
+    const outcome = await approveGate(
+      fakeFetch({
+        ...CAPABILITY,
+        "/gates/approvals": {
