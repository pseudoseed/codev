index 000000000..486991ed5
--- /dev/null
+++ b/apps/web/src/codev/GateApproval.tsx
@@ -0,0 +1,269 @@
+/**
+ * Codev customization (spec 250), phase 10 — approving the gate, from t3code.
+ *
+ * ## Four outcomes get four renderings, and that is the whole point of the file
+ *
+ * approved, refused, **unconfirmed**, **session ended**. Two of those are answers
+ * that are not "no", and rendering them in the refusal's red is how a human ends
+ * up approving twice at the one moment a duplicate costs something. So:
+ *
+ *   approved        stated with the SERVER's timestamp, machine and session id.
+ *                   Never this browser's clock, never the stored machine label.
+ *   refused         the agent's own signal and words.
+ *   unconfirmed     "could not tell", in the informational treatment, with what
+ *                   to go and look at. Never the refusal styling.
+ *   session ended   the session is dropped and a token field comes back, because
+ *                   what this person needs is a new session, not a retry.
+ *
+ * ## Where `projectId` comes from, and why it is not on the gate
+ *
+ * `codev-agent` publishes the porch projection — project id included — for every
+ * identity in the workspace, and this page already reads it for the builder
+ * panes. Putting a project id on the thread's gate block as well would be a
+ * second copy of a fact the agent already owns, and the two could disagree. So
+ * the button is enabled only when the agent has said which project this thread
+ * is, and says so plainly when it has not.
+ */
+
+import { useState } from "react";
+
+import { Button } from "../components/ui/button";
+import { Input } from "../components/ui/input";
+import { approveGate, openHumanSession, type ApprovalOutcome, type ApprovalProgress, type HumanSession } from "./approval";
+import { PairingPanel } from "./PairingPanel";
+import { useCodevAgent } from "./useCodevAgent";
+
+function porchProjectFor(
+  state: ReturnType<typeof useCodevAgent>["state"],
+  threadId: string,
+): { readonly projectId: string } | null {
+  if (state.kind !== "read") return null;
+  const identity = state.snapshot.identities.find((candidate) => candidate.threadId === threadId);
+  const porch = identity?.porch;
+  return porch === undefined ? null : { projectId: porch.projectId };
+}
+
+export function GateApproval(props: {
+  readonly threadId: string;
+  readonly gateName: string;
+  readonly fetchImpl?: typeof globalThis.fetch;
+}) {
+  const { threadId, gateName } = props;
+  const fetchImpl = props.fetchImpl ?? globalThis.fetch.bind(globalThis);
+  const agent = useCodevAgent();
+
+  const [pairingOpen, setPairingOpen] = useState(false);
+  const [sessionToken, setSessionToken] = useState("");
+  const [session, setSession] = useState<HumanSession | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [progress, setProgress] = useState<ApprovalProgress | null>(null);
+  const [outcome, setOutcome] = useState<ApprovalOutcome | null>(null);
+  const [problem, setProblem] = useState<string | null>(null);
+
+  const pairing = agent.pairing;
+  const project = porchProjectFor(agent.state, threadId);
+
+  async function approve(): Promise<void> {
+    if (pairing === null || project === null) return;
+    setBusy(true);
+    setProblem(null);
+    setOutcome(null);
+    setProgress(null);
+    try {
+      /*
+       * A SESSION IS OPENED PER APPROVAL when there is not one in hand, and it
+       * costs its own single-use token. That is the ceremony, not an accident of
+       * this UI: the machine credential says which browser, the session token
+       * makes this particular act a distinct recorded one.
+       */
+      let live = session;
+      if (live === null) {
+        const opened = await openHumanSession(fetchImpl, pairing, sessionToken.trim());
+        if (!opened.ok) {
+          setProblem(`${opened.signal}: ${opened.message}`);
+          return;
+        }
+        live = opened.session;
+        setSession(live);
+        setSessionToken("");
+      }
+      const result = await approveGate(
+        fetchImpl,
+        pairing,
+        live,
+        { projectId: project.projectId, gateName },
+        setProgress,
+      );
+      setOutcome(result);
+      if (!result.ok && result.sessionEnded === true) {
+        // Dropped rather than kept, so what comes back is a token field and not
+        // an Approve button that can only ever fail.
+        setSession(null);
+      }
+      agent.refresh();
+    } finally {
+      setBusy(false);
+      setProgress(null);
+    }
+  }
+
+  if (pairingOpen) {
+    return (
+      <div data-testid="codev-gate-approval" className="mx-auto w-full max-w-3xl">
+        <PairingPanel
+          fetchImpl={fetchImpl}
+          onPaired={(next) => {
+            const stored = agent.pair(next);
+            if (stored.ok) setPairingOpen(false);
+            return stored;
+          }}
+          onCancel={() => setPairingOpen(false)}
+        />
+      </div>
+    );
+  }
+
+  return (
+    <section
+      data-testid="codev-gate-approval"
+      data-codev-approval-state={
+        outcome === null ? "idle" : outcome.ok ? "approved" : outcome.unconfirmed === true ? "unconfirmed" : "refused"
+      }
+      className="mx-auto flex w-full max-w-3xl min-w-0 flex-col gap-2 text-sm"
+    >
+      {pairing === null ? (
+        <div className="flex min-w-0 flex-col gap-1">
+          <p data-testid="codev-gate-approval-unpaired" className="text-muted-foreground text-xs">
+            {agent.pairingRead.kind === "unreadable"
+              ? /* NOT "not paired". The store could not be read, so whether this
+                   browser holds a credential is unknown, and sending someone to
+                   spend a fresh token is the wrong next action. */
+                `Whether this browser is paired is unknown: ${agent.pairingRead.message}`
+              : "This browser holds no codev-agent credential, so it cannot approve yet."}
+          </p>
+          <div>
+            <Button
+              type="button"
+              size="sm"
+              data-testid="codev-gate-approval-pair"
+              onClick={() => setPairingOpen(true)}
+            >
+              Pair this browser
+            </Button>
+          </div>
+        </div>
+      ) : project === null ? (
+        <p data-testid="codev-gate-approval-no-project" className="text-muted-foreground text-xs">
+          {agent.state.kind === "read"
+            ? "codev-agent publishes no porch project for this thread, so there is nothing to approve here."
+            : `codev-agent has not been read yet: ${agent.state.message}`}
+        </p>
+      ) : (
+        <div className="flex min-w-0 flex-col gap-2">
+          {session === null ? (
+            <div className="flex min-w-0 flex-col gap-1">
+              <label
+                htmlFor="codev-gate-session-token"
+                className="font-medium text-muted-foreground text-xs"
+              >
+                Session token —{" "}
+                <code className="font-mono">afx pair issue --purpose client-session</code>
+              </label>
+              <Input
+                id="codev-gate-session-token"
+                data-testid="codev-gate-session-token"
+                value={sessionToken}
+                onChange={(event) => setSessionToken(event.target.value)}
+                autoComplete="off"
+                spellCheck={false}
+              />
+            </div>
+          ) : null}
+          <div className="flex shrink-0 flex-wrap items-center gap-2">
+            <Button
+              type="button"
+              size="sm"
+              data-testid="codev-gate-approve"
+              disabled={busy || (session === null && sessionToken.trim() === "")}
+              onClick={() => void approve()}
+            >
+              {busy ? "Approving…" : `Approve ${gateName}`}
+            </Button>
+            <span data-testid="codev-gate-approval-machine" className="text-muted-foreground text-xs">
+              as {pairing.machine} on {pairing.targetId}
+            </span>
+            <Button type="button" size="sm" variant="ghost" onClick={agent.unpair}>
+              Forget credential
+            </Button>
+          </div>
+        </div>
+      )}
+
+      {progress === null ? null : (
+        /*
+          The SERVER's own phase and check names, never a guess made here. A
+          button that says "Approving…" for four minutes with nothing behind it
+          is indistinguishable from one that is stuck.
+        */
+        <p data-testid="codev-gate-approval-progress" className="text-muted-foreground text-xs">
+          {progress.state === "running" ? "Running" : "Submitted"} as {progress.operationId}
+          {progress.phase === undefined ? "" : ` — phase ${progress.phase}`}
+          {progress.checks === undefined || progress.checks.length === 0
+            ? ""
+            : ` — checks: ${progress.checks.join(", ")}`}
+        </p>
+      )}
+
+      {problem === null ? null : (
+        <p data-testid="codev-gate-approval-problem" className="text-destructive-foreground text-xs">
+          {problem}
+        </p>
+      )}
+
+      {outcome === null ? null : outcome.ok ? (
+        <div data-testid="codev-gate-approval-approved" className="flex min-w-0 flex-col gap-0.5 text-xs">
+          <p className="font-medium text-emerald-700 dark:text-emerald-300">
+            {outcome.alreadyApproved === true
+              ? /* Someone else may have approved it, on another machine. Reported
+                   as what it is rather than as "you approved this". */
+                `${gateName} was already approved`
+              : `${gateName} approved`}
+            {" · "}
+            {outcome.approvedAt} · {outcome.machine} ·{" "}
+            {outcome.sessionId === null ? "session unknown" : `session ${outcome.sessionId}`}
+          </p>
+          {outcome.authority === undefined ? null : (
+            <p className="text-muted-foreground">authority: {outcome.authority}</p>
+          )}
+          {outcome.delivery === undefined ? null : (
+            /* A SUCCESS WITH A CAVEAT, never a failure: none of the delivery
+               states means the gate is unapproved, and they want three different
+               remedies. */
+            <p className="text-amber-700 dark:text-amber-300">
+              {outcome.delivery}
+              {outcome.deliveryMessage === undefined ? "" : ` — ${outcome.deliveryMessage}`}
+            </p>
+          )}
+        </div>
+      ) : outcome.unconfirmed === true ? (
+        /*
+          "I COULD NOT TELL" IS NOT "NO", and it does not get the refusal's red.
+          The gate may well be approved; this text sends the reader to check
+          rather than to approve again.
+        */
+        <p data-testid="codev-gate-approval-unconfirmed" className="text-info text-xs">
+          Could not tell — {outcome.signal}: {outcome.message}
+        </p>
+      ) : outcome.sessionEnded === true ? (
+        <p data-testid="codev-gate-approval-session-ended" className="text-amber-700 text-xs dark:text-amber-300">
+          The session ended — {outcome.signal}: {outcome.message} Mint another session token and try
+          again.
+        </p>
+      ) : (
+        <p data-testid="codev-gate-approval-refused" className="text-destructive-foreground text-xs">
+          {outcome.signal}: {outcome.message}
+        </p>
+      )}
+    </section>
+  );
+}
