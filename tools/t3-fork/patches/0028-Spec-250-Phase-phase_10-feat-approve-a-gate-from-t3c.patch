+      seen.push(url);
+      if (url.includes("/gates/approvals/op-1")) {
+        pollHeaders = (init?.headers ?? {}) as Record<string, string>;
+        return new Response(
+          JSON.stringify({
+            state: "succeeded",
+            projectId: "250",
+            gateName: "plan-approval",
+            record: { approvedAt: "t", machine: "ipad" },
+          }),
+          { status: 200 },
+        );
+      }
+      if (url.includes("/gates/approvals")) {
+        return new Response(
+          JSON.stringify({
+            operationId: "op-1",
+            receipt: "rcpt-secret",
+            projectId: "250",
+            gateName: "plan-approval",
+          }),
+          { status: 202 },
+        );
+      }
+      if (url.includes("/approval-capabilities")) {
+        return new Response(JSON.stringify({ presentation: "cap.secret", capabilityId: "cap-1" }), {
+          status: 201,
+        });
+      }
+      return new Response(JSON.stringify({ nonce: "nonce-1" }), { status: 201 });
+    }) as typeof globalThis.fetch;
+
+    await approveGate(fetchImpl, pairing, session, gate);
+    expect(pollHeaders["x-codev-approval-receipt"]).toBe("rcpt-secret");
+    expect(seen.every((url) => !url.includes("rcpt-secret"))).toBe(true);
+  });
+});
diff --git a/apps/web/src/codev/approval.ts b/apps/web/src/codev/approval.ts
new file mode 100644
index 000000000..0de6f7435
--- /dev/null
+++ b/apps/web/src/codev/approval.ts
@@ -0,0 +1,631 @@
+/**
+ * Codev customization (spec 250), phase 10 — approving a porch gate from t3code.
+ *
+ * Ported from `apps/client/src/gate/approval.ts`, which is frozen. The ceremony
+ * is unchanged because it is `codev-agent`'s, not this page's; what changes is
+ * that every request goes to THIS origin and the fork's server makes the one hop.
+ *
+ * ## The ceremony, named in full
+ *
+ *   1. `pairing/redeem`      spends a `machine-credential` token for this
+ *                            browser's credential. Lives in `pairing.ts`; done
+ *                            once, not per approval.
+ *   2. `openHumanSession`    spends a distinct single-use `client-session` token
+ *                            alongside the machine credential, and yields a
+ *                            presentation carried in `x-codev-human-session`.
+ *   3. capability + nonce     the capability is the act a human gate exists to
+ *                            require; the nonce binds it to ONE gate.
+ *   4. the approval itself    submitted asynchronously and polled, because a
+ *                            phase's checks will not fit inside one request.
+ *
+ * NONE OF THEM ESTABLISHES THAT A HUMAN IS PRESENT. Minting a pairing token
+ * needs only write access to the pairing store, and every agent on that host runs
+ * as the same user. What the chain carries instead is a stated `authority`,
+ * recorded and never verified — see `codev/resources/146-approval-threat-model.md`.
+ *
+ * ## Four outcomes, not two
+ *
+ * approved, refused, **unconfirmed** and **`sessionEnded`**. The last two are the
+ * ones a shorter port drops, and each drop has the same shape: an answer that is
+ * not "no" being spelled like "no".
+ *
+ *   `unconfirmed`   the server answered and this page could not read it. The
+ *                   gate may well be approved, so rendering it as a refusal sends
+ *                   a human to approve twice at the one point where a duplicate
+ *                   costs something.
+ *   `sessionEnded`  ordinary, not exceptional: sessions idle out after 30
+ *                   minutes. Folding it into refusal tells someone their approval
+ *                   failed when what they need is to open a session again.
+ */
+
+import { agentUrl, machineHeaders, encodeWorkspacePath, APPROVAL_RECEIPT_HEADER, HUMAN_SESSION_HEADER, PAIRING_TOKEN_HEADER, type CodevPairing } from "./pairing";
+
+export interface HumanSession {
+  readonly sessionId: string;
+  /** Presented in `x-codev-human-session`. Never stored anywhere durable. */
+  readonly presentation: string;
+  readonly expiresAt: string;
+}
+
+export type ApprovalOutcome =
+  | {
+      readonly ok: true;
+      readonly approvedAt: string;
+      readonly machine: string;
+      /**
+       * NULLABLE ON PURPOSE. An approval recorded before session ids existed is a
+       * real approval with an unknown approver, and reporting "unknown" is right
+       * where inventing this session's id would be a lie.
+       */
+      readonly sessionId: string | null;
+      /**
+       * The gate was ALREADY approved before this request — a definite answer,
+       * but about whoever actually approved it, who may be someone else on
+       * another machine. Never presented as "you approved this".
+       */
+      readonly alreadyApproved?: boolean;
+      /** What the pairing token behind the approving capability claimed. */
+      readonly authority?: string;
+      /**
+       * How far the approval travelled, when it did not travel all the way. A
+       * success with a caveat, never a failure: none of these means the gate is
+       * unapproved, and they want three different remedies.
+       */
+      readonly delivery?: ApprovalDelivery;
+      readonly deliveryMessage?: string;
+    }
+  | {
+      readonly ok: false;
+      readonly signal: string;
+      readonly message: string;
+      /** "I could not tell", which must never be rendered as "no". */
+      readonly unconfirmed?: boolean;
+      /** The session is gone. The panel drops it and offers pairing again. */
+      readonly sessionEnded?: boolean;
+    };
+
+/** What the server says while an approval runs. Never invented by this page. */
+export interface ApprovalProgress {
+  readonly state: "submitted" | "running";
+  readonly operationId: string;
+  /** The phase the server says it is running in, when it has said. */
+  readonly phase?: string;
+  /** The check names the server says it will run. */
+  readonly checks?: readonly string[];
+}
+
+interface Json {
+  readonly status: number;
+  readonly body: Record<string, unknown>;
+}
+
+async function send(
+  fetchImpl: typeof globalThis.fetch,
+  url: string,
+  headers: Record<string, string>,
+  body: unknown,
+): Promise<Json> {
+  const response = await fetchImpl(url, {
+    method: "POST",
+    headers: { "content-type": "application/json", accept: "application/json", ...headers },
+    body: JSON.stringify(body),
+  });
+  let parsed: unknown;
+  try {
+    parsed = await response.json();
+  } catch {
+    parsed = {};
+  }
+  return {
+    status: response.status,
+    body: (parsed !== null && typeof parsed === "object" ? parsed : {}) as Record<string, unknown>,
+  };
+}
+
+function text(body: Record<string, unknown>, key: string): string | undefined {
+  const value = body[key];
+  return typeof value === "string" ? value : undefined;
+}
+
+/** Signals that mean "this session is over", as distinct from "this was refused". */
+const SESSION_ENDED = new Set([
+  "HUMAN_SESSION_REQUIRED",
+  "HUMAN_SESSION_REVOKED",
+  "APPROVAL_ISSUANCE_REQUIRES_HUMAN_SESSION",
+]);
+
+function refusal(
+  result: Json,
+  fallback: string,
+): { ok: false; signal: string; message: string; sessionEnded: boolean } {
+  const signal = text(result.body, "signal") ?? `HTTP_${result.status}`;
+  return {
+    ok: false,
+    signal,
+    message: text(result.body, "message") ?? fallback,
+    // A 401 on any step means the session went away mid-ceremony; sessions idle
+    // out after 30 minutes, so this is ordinary rather than exceptional.
+    sessionEnded: SESSION_ENDED.has(signal) || result.status === 401,
+  };
+}
+
+function api(pairing: CodevPairing, path: string): string {
+  return agentUrl(pairing.targetId, `/api/agent/v1${path}`);
+}
+
+/**
+ * Exchange a `client-session` pairing token for a paired human session.
+ *
+ * The token makes each session a distinct, single-use, recorded act. It does NOT
+ * make "a human is present" a fact. The machine credential is required alongside
+ * it so a revoked browser cannot open a session — that part is a real control,
+ * and it is what `afx pair revoke` acts on.
+ */
+export async function openHumanSession(
+  fetchImpl: typeof globalThis.fetch,
+  pairing: CodevPairing,
+  pairingToken: string,
+): Promise<
+  { ok: true; session: HumanSession } | { ok: false; signal: string; message: string }
+> {
+  const result = await send(
+    fetchImpl,
+    api(pairing, "/human-sessions"),
+    { ...machineHeaders(pairing), [PAIRING_TOKEN_HEADER]: pairingToken },
+    {},
+  );
+  const presentation = text(result.body, "presentation");
+  const sessionId = text(result.body, "sessionId");
+  if (result.status !== 201 || presentation === undefined || sessionId === undefined) {
+    return refusal(result, "the agent did not issue a human session");
+  }
+  return {
+    ok: true,
+    session: { sessionId, presentation, expiresAt: text(result.body, "expiresAt") ?? "" },
+  };
+}
+
+const POLL_INTERVAL_MS = 1_000;
+const POLL_LIMIT_MS = 30 * 60_000;
+const TERMINAL_STATES = new Set(["succeeded", "refused", "failed", "interrupted"]);
+
+/**
+ * Issue a capability, mint a nonce for one gate, and spend both.
+ *
+ * The three are one act from the human's point of view. A capability outlives one
+ * approval, but re-issuing per approval is cheap and keeps nothing long-lived in
+ * the page.
+ */
+export async function approveGate(
+  fetchImpl: typeof globalThis.fetch,
+  pairing: CodevPairing,
+  session: HumanSession,
+  gate: { readonly projectId: string; readonly gateName: string },
+  /**
+   * OPTIONAL BUT NOT DECORATIVE. Phase checks take minutes, and a button that
+   * says "Approving…" for four minutes with nothing behind it is
+   * indistinguishable from one that is stuck. What is reported is the server's
+   * own phase and check names, never a guess made here.
+   */
+  onProgress?: (progress: ApprovalProgress) => void,
+): Promise<ApprovalOutcome> {
+  const authed = { ...machineHeaders(pairing), [HUMAN_SESSION_HEADER]: session.presentation };
+
+  const issued = await send(fetchImpl, api(pairing, "/approval-capabilities"), authed, {
+    principalKind: "human-client",
+  });
+  const capability = text(issued.body, "presentation");
+  const capabilityId = text(issued.body, "capabilityId");
+  if (issued.status !== 201 || capability === undefined || capabilityId === undefined) {
+    return refusal(issued, "the agent did not issue an approval capability");
+  }
+
+  const minted = await send(fetchImpl, api(pairing, "/approval-nonces"), authed, {
+    projectId: gate.projectId,
+    gateName: gate.gateName,
+    capabilityId,
+  });
+  const nonce = text(minted.body, "nonce");
+  if (minted.status !== 201 || nonce === undefined) {
+    return refusal(minted, "the agent did not mint an approval nonce");
+  }
+
+  const workspace = encodeURIComponent(encodeWorkspacePath(pairing.workspacePath));
+
+  /*
+   * THE ASYNCHRONOUS ROUTE FIRST, because it is the only one that works on an
+   * ordinary project: the synchronous route refuses any project whose phase
+   * declares checks, since an HTTP request will not hold a connection open for a
+   * repository's test suite.
+   *
+   * A SUBMIT THAT NEVER COMPLETED IS NOT A REFUSAL. There is no way to know from
+   * here whether the server received it, and that is what `unconfirmed` is for.
+   */
+  let submitted: Json;
+  try {
+    submitted = await send(
+      fetchImpl,
+      api(pairing, `/workspaces/${workspace}/gates/approvals`),
+      authed,
+      { projectId: gate.projectId, gateName: gate.gateName, capability, nonce },
+    );
+  } catch (error) {
+    return {
+      ok: false,
+      unconfirmed: true,
+      signal: "GATE_APPROVAL_UNCONFIRMED",
+      message:
+        `the request to approve ${gate.gateName} did not complete (${(error as Error).message}), so `
+        + "whether the agent received it is unknown. It may already be running — check before "
+        + "approving again.",
+    };
+  }
+
+  /*
+   * NARROW ON THE SIGNAL, NOT ON THE STATUS. A host predating the async route
+   * answers 404 `AGENT_ROUTE_NOT_FOUND`; a current one with no operation store
+   * answers 501. Other 404s are real answers — an unknown workspace, a workspace
+   * this host does not serve — and treating those as "no async route here" would
+   * run the synchronous path against a host that would have refused outright.
+   */
+  const unrouted =
+    submitted.status === 404 && text(submitted.body, "signal") === "AGENT_ROUTE_NOT_FOUND";
+  if (submitted.status !== 501 && !unrouted) {
+    return await pollApproval(fetchImpl, pairing, authed, workspace, submitted, gate, onProgress);
+  }
+
+  const approved = await send(
+    fetchImpl,
+    api(pairing, `/workspaces/${workspace}/gates/approve`),
+    authed,
+    { projectId: gate.projectId, gateName: gate.gateName, capability, nonce },
+  );
+  if (approved.status !== 200) {
+    return refusal(approved, "the gate was not approved");
+  }
+
+  /*
+   * EVERY PIECE OF EVIDENCE COMES FROM THE SERVER OR THE ANSWER IS NOT A YES.
+   *
+   * Filling `approvedAt` from this browser's clock, `machine` from the stored
+   * label and `sessionId` from the session in hand would make an empty body — or
+   * the proxy's own 200 — render as a complete approval record, every word of it
+   * manufactured here. Criterion 4 asks porch to record exactly those three, so a
+   * port that invents them passes a naive assertion while reporting fiction.
+   */
+  return readSynchronousApproval(approved);
+}
+
+function readSynchronousApproval(approved: Json): ApprovalOutcome {
+  const signal = text(approved.body, "signal");
+  const approvedAt = text(approved.body, "approvedAt");
+  const machine = text(approved.body, "machine");
+  const sessionId = text(approved.body, "sessionId") ?? null;
+  const alreadyApproved = signal === "GATE_ALREADY_APPROVED";
+  if ((signal !== "GATE_APPROVED" && !alreadyApproved) || approvedAt === undefined || machine === undefined) {
+    return {
+      ok: false,
+      unconfirmed: true,
+      signal: "GATE_APPROVAL_UNCONFIRMED",
+      message:
+        "the agent answered 200 but not with a result this page can read, so whether the gate was "
+        + "approved is unknown. Check status.yaml before approving again.",
+    };
+  }
+  const delivery = readDelivery(text(approved.body, "delivery"));
+  const deliveryMessage = text(approved.body, "deliveryMessage");
+  const authority = text(approved.body, "authority");
+  return {
+    ok: true,
+    approvedAt,
+    machine,
+    sessionId,
+    ...(alreadyApproved ? { alreadyApproved: true } : {}),
+    ...(authority === undefined ? {} : { authority }),
+    ...(delivery === undefined
+      ? {}
+      : { delivery, ...(deliveryMessage === undefined ? {} : { deliveryMessage }) }),
+  };
+}
+
+export type ApprovalDelivery = "written-not-committed" | "committed-not-pushed" | "unknown";
+
+/** A delivery word this build does not know is dropped, never passed through. */
+function readDelivery(raw: string | undefined): ApprovalDelivery | undefined {
+  return raw === "written-not-committed" || raw === "committed-not-pushed" || raw === "unknown"
+    ? raw
+    : undefined;
+}
+
+/**
+ * Follow one submitted approval to its end.
+ *
+ * ## Why giving up is reported as UNCONFIRMED, never as a refusal
+ *
+ * This page stopping does not stop porch. If it gives up waiting, the approval is
+ * still running and may well succeed — so reporting "not approved" would be the
+ * very failure the asynchronous path exists to prevent, reintroduced in the
+ * client. The bound exists so a tab does not poll forever; what it produces is
+ * "I could not tell", with the operation id to look up.
+ */
+async function pollApproval(
+  fetchImpl: typeof globalThis.fetch,
+  pairing: CodevPairing,
+  authed: Record<string, string>,
+  workspace: string,
+  submitted: Json,
+  gate: { readonly projectId: string; readonly gateName: string },
+  onProgress?: (progress: ApprovalProgress) => void,
+): Promise<ApprovalOutcome> {
+  /*
+   * A 5xx ON THE SUBMIT MAY HAVE CREATED THE OPERATION: the record is written
+   * BEFORE the 202. A 4xx is a definite answer about the request itself and
+   * stays a refusal.
+   */
+  if (submitted.status >= 500) {
+    return {
+      ok: false,
+      unconfirmed: true,
+      signal: "GATE_APPROVAL_UNCONFIRMED",
+      message:
+        `the agent answered ${submitted.status} to the request to approve ${gate.gateName}. The `
+        + "operation is recorded before the response is written, so it may be running — check "
+        + "before approving again.",
+    };
+  }
+  if (submitted.status === 409) {
+    /*
+     * A CONFLICT IS NOT A REFUSAL OF THIS GATE. Another session's approval for
+     * this project is running and may be about to succeed; this page cannot poll
+     * it and must not claim to know its outcome.
+     */
+    const running = text(submitted.body, "operationId");
+    return {
+      ok: false,
+      unconfirmed: true,
+      signal: "APPROVAL_ALREADY_IN_FLIGHT",
+      message:
+        `an approval for this project is already running${running === undefined ? "" : ` as operation ${running}`}`
+        + ", started by another session. This gate may be approved by that run, so nothing here "
+        + "says it was not — wait for it, and check the gate before submitting again.",
+    };
+  }
+  const operationId = text(submitted.body, "operationId");
+  if (submitted.status !== 202 || operationId === undefined) {
+    return refusal(submitted, "the agent did not accept the approval");
+  }
+
+  /*
+   * A 202 WITHOUT A RECEIPT IS NOT A DURABLE OPERATION.
+   *
+   * Human sessions live in the host's memory, so the restart that resolves an
+   * operation to `interrupted` destroys the session that submitted it. The
+   * receipt, presented from the same machine, is the second way in. Accepting a
+   * 202 without one silently gives that up — it works right up until the restart
+   * the receipt exists for.
+   */
+  const receipt = text(submitted.body, "receipt");
+  if (receipt === undefined) {
+    return {
+      ok: false,
+      unconfirmed: true,
+      signal: "GATE_APPROVAL_UNCONFIRMED",
+      message:
+        `the agent accepted approval ${operationId} without a receipt, so this page cannot read the `
+        + "outcome if the host restarts. The approval may be running; check the gate rather than "
+        + "submitting again.",
+    };
+  }
+  // IN A HEADER, NEVER IN THE URL. It is a bearer secret, and URLs are logged by
+  // things that were not asked.
+  const polling = { ...authed, [APPROVAL_RECEIPT_HEADER]: receipt };
+
+  /*
+   * THE OPERATION MUST BE THIS GATE'S, AND THIS PAGE CHECKS RATHER THAN ASSUMES.
+   *
+   * Single-flight is PROJECT-wide, so "an operation for this project" is not the
+   * same claim as "an operation for this gate". REQUIRED AND EQUAL, not "equal if
+   * present": a body that says nothing about which gate it describes is precisely
+   * the body that must not settle one.
+   */
+  const identityMismatch = (body: Record<string, unknown>): string | null => {
+    const project = text(body, "projectId");
+    const named = text(body, "gateName");
+    if (project === undefined) return `no project id, so it cannot be shown to describe ${gate.projectId}`;
+    if (project !== gate.projectId) return `project ${project} rather than ${gate.projectId}`;
+    if (named === undefined) return `no gate name, so it cannot be shown to describe ${gate.gateName}`;
+    if (named !== gate.gateName) return `gate ${named} rather than ${gate.gateName}`;
+    return null;
+  };
+  const submittedMismatch = identityMismatch(submitted.body);
+  if (submittedMismatch !== null) {
+    return {
+      ok: false,
+      unconfirmed: true,
+      signal: "GATE_APPROVAL_UNCONFIRMED",
+      message:
+        `the agent answered the request to approve ${gate.gateName} with an operation for `
+        + `${submittedMismatch}. Nothing here says whether ${gate.gateName} was approved; it was not `
+        + "reported as approved on the strength of another gate's record.",
+    };
+  }
+
+  const url = api(pairing, `/workspaces/${workspace}/gates/approvals/${encodeURIComponent(operationId)}`);
+  const deadline = Date.now() + POLL_LIMIT_MS;
+  while (Date.now() < deadline) {
+    /*
+     * A POLL THAT CANNOT READ THE STATE SAYS NOTHING ABOUT THE APPROVAL. A 503 is
+     * the agent's own "the operation store could not be read", not "your gate was
+     * refused". Retried until the deadline and then reported as unconfirmed.
+     */
+    let polled: Json;
+    try {
+      const response = await fetchImpl(url, { headers: { accept: "application/json", ...polling } });
+      let parsed: unknown;
+      try {
+        parsed = await response.json();
+      } catch {
+        parsed = {};
+      }
+      polled = {
+        status: response.status,
+        body: (parsed !== null && typeof parsed === "object" ? parsed : {}) as Record<string, unknown>,
+      };
+    } catch {
+      await new Promise((wait) => setTimeout(wait, POLL_INTERVAL_MS));
+      continue;
+    }
+
+    /*
+     * TWO DEFINITE ANSWERS, and only two. 403 says this session may not read this
+     * operation; 401 says the session is gone. Neither changes by retrying, and
+     * the 401 must mean `sessionEnded` here exactly as it does on the synchronous
+     * path — otherwise a dead session leaves an Approve button a human can only
+     * escape by reloading.
+     */
+    if (polled.status === 403 || polled.status === 401) {
+      return refusal(polled, "this session can no longer read that approval");
+    }
+    /*
+     * 404 IS DEFINITE TOO, and re-asking cannot change it. Reported as
+     * UNCONFIRMED rather than refused, because both facts are true and neither is
+     * a verdict on the gate: it WAS accepted, and the host no longer knows it.
+     */
+    if (polled.status === 404) {
+      return {
+        ok: false,
+        unconfirmed: true,
+        signal: "GATE_APPROVAL_UNCONFIRMED",
+        message:
+          `the agent accepted approval ${operationId} and now does not know it. Whether the gate was `
+          + "approved is unknown; check before approving again.",
+      };
+    }
+    if (polled.status !== 200) {
+      await new Promise((wait) => setTimeout(wait, POLL_INTERVAL_MS));
+      continue;
+    }
+
+    // AND AGAIN ON EVERY POLL, because the record read is the one reported.
+    const polledMismatch = identityMismatch(polled.body);
+    if (polledMismatch !== null) {
+      return {
+        ok: false,
+        unconfirmed: true,
+        signal: "GATE_APPROVAL_UNCONFIRMED",
+        message:
+          `operation ${operationId} describes ${polledMismatch}, so it cannot say whether `
+          + `${gate.gateName} was approved. Check the gate rather than treating this as an answer.`,
+      };
+    }
+
+    const state = text(polled.body, "state");
+    if (state !== undefined && TERMINAL_STATES.has(state)) return terminalOutcome(polled, state, gate);
+    if (state === "submitted" || state === "running") {
+      const phase = text(polled.body, "phase");
+      onProgress?.({
+        state,
+        operationId,
+        ...(phase === undefined ? {} : { phase }),
+        ...(Array.isArray(polled.body.checks)
+          ? {
+              checks: (polled.body.checks as unknown[]).filter(
+                (check): check is string => typeof check === "string",
+              ),
+            }
+          : {}),
+      });
+    } else {
+      // A state this build does not know is not a reason to claim an outcome.
+      return {
+        ok: false,
+        unconfirmed: true,
+        signal: "GATE_APPROVAL_UNCONFIRMED",
+        message:
+          `the agent reported approval state "${String(state)}", which this page does not recognise. `
+          + `Look up operation ${operationId} before approving again.`,
+      };
+    }
+    await new Promise((wait) => setTimeout(wait, POLL_INTERVAL_MS));
+  }
+
+  return {
+    ok: false,
+    unconfirmed: true,
+    signal: "GATE_APPROVAL_UNCONFIRMED",
+    message:
+      `this page stopped waiting after ${Math.round(POLL_LIMIT_MS / 60_000)} minutes, but that does `
+      + `not stop the approval — operation ${operationId} may still be running or may have `
+      + "succeeded. Look it up before approving again.",
+  };
+}
+
+/** Turn a settled operation into the outcome a human reads. */
+function terminalOutcome(
+  polled: Json,
+  state: string,
+  gate: { readonly projectId: string; readonly gateName: string },
+): ApprovalOutcome {
+  if (state === "refused") {
+    return {
+      ok: false,
+      signal: text(polled.body, "code") ?? "GATE_APPROVAL_REFUSED",
+      message: text(polled.body, "message") ?? `${gate.gateName} was not approved`,
+      sessionEnded: false,
+    };
+  }
+  if (state === "failed") {
+    return {
+      ok: false,
+      signal: "GATE_APPROVAL_FAILED",
+      message: text(polled.body, "message") ?? "the approval failed and the agent gave no reason",
+      sessionEnded: false,
+    };
+  }
+  if (state === "interrupted") {
+    /*
+     * NOT A FAILURE. The host stopped while the work ran, and the gate may well be
+     * approved — the agent has read `status.yaml` and its message says which it
+     * found. Reporting this as "not approved" would send a human to approve
+     * something already approved, which is the reason this state exists.
+     */
+    return {
+      ok: false,
+      unconfirmed: true,
+      signal: "APPROVAL_OPERATION_INTERRUPTED",
+      message:
+        text(polled.body, "message")
+        ?? "the host stopped while this approval was running; check status.yaml before retrying",
+    };
+  }
+
+  const record = polled.body.record;
+  const fields = (record !== null && typeof record === "object" ? record : {}) as Record<string, unknown>;
+  const approvedAt = typeof fields.approvedAt === "string" ? fields.approvedAt : undefined;
+  const machine = typeof fields.machine === "string" ? fields.machine : undefined;
+  if (approvedAt === undefined || machine === undefined) {
+    // The same rule as the synchronous path: a success this page cannot read is
+    // UNCONFIRMED, never a refusal, because the gate may be approved.
+    return {
+      ok: false,
+      unconfirmed: true,
+      signal: "GATE_APPROVAL_UNCONFIRMED",
+      message:
+        "the agent reported the approval succeeded but not with a result this page can read, so "
+        + "whether the gate was approved is unknown. Check status.yaml before approving again.",
+    };
+  }
+  const delivery = readDelivery(typeof fields.delivery === "string" ? fields.delivery : undefined);
+  const deliveryMessage = typeof fields.deliveryMessage === "string" ? fields.deliveryMessage : undefined;
+  return {
+    ok: true,
+    approvedAt,
+    machine,
+    sessionId: typeof fields.sessionId === "string" ? fields.sessionId : null,
+    ...(fields.outcome === "already-approved" ? { alreadyApproved: true } : {}),
+    ...(typeof fields.authority === "string" ? { authority: fields.authority } : {}),
+    ...(delivery === undefined
+      ? {}
+      : { delivery, ...(deliveryMessage === undefined ? {} : { deliveryMessage }) }),
+  };
+}
