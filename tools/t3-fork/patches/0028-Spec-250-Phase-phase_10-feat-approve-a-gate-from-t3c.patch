+/**
+ * Codev customization (spec 250), phase 10 — what codev-agent published, read here.
+ *
+ * The claims:
+ *
+ *  - a payload this build cannot read is REFUSED, and refusal is reported as
+ *    "could not read", never as an empty workspace. A half-understood snapshot
+ *    would put a phase on screen that nothing published.
+ *  - the four "cannot show a phase" branches are four different facts and none of
+ *    them is a blank line. `unpaired` is fixed in a form, `unavailable` is a
+ *    server to look at, `absent` is ordinary, and `porch: null` means the agent
+ *    answered and there is no project.
+ *  - the message log's three states survive to the pane. An agent that predates
+ *    the field HAS messages it is not sending, and that is not "no messages".
+ */
+
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  readWorkspaceState,
+  resolvePaneContent,
+  validateAgentSnapshot,
+  type AgentStateRead,
+} from "./agentState";
+import type { CodevPairing } from "./pairing";
+
+const pairing: CodevPairing = {
+  targetId: "local",
+  machine: "ipad",
+  credential: "cred-1.secret",
+  workspacePath: "/Users/chris/dev/codev",
+};
+
+const snapshotBody = {
+  schemaVersion: 1,
+  workspacePath: "/Users/chris/dev/codev",
+  generatedAt: "2026-08-31T05:00:00.000Z",
+  protocol: {
+    messageLog: "available",
+    identities: [
+      {
+        backing: "thread",
+        threadId: "thread-1",
+        role: "builder",
+        workspacePath: "/Users/chris/dev/codev",
+        management: "managed",
+        porch: {
+          projectId: "250",
+          title: "t3code is the front end",
+          protocol: "SPIR",
+          phase: "implement",
+          currentPlanPhase: "phase_10",
+          gates: {},
+          artifactRoot: "codev",
+          statusPath: "codev/projects/250/status.yaml",
+        },
+        messages: [
+          { id: "m3", from: "architect", at: "t3", body: "third" },
+          { id: "m2", from: "architect", at: "t2", body: "second", truncated: true },
+          { id: "m1", from: "architect", at: "t1", body: "first" },
+          { id: "m0", from: "architect", at: "t0", body: "zeroth" },
+        ],
+      },
+    ],
+  },
+};
+
+describe("codev agent snapshot validation (spec 250, phase 10)", () => {
+  it("reads the fields the grid needs", () => {
+    const snapshot = validateAgentSnapshot(snapshotBody);
+    expect(snapshot).not.toBeNull();
+    expect(snapshot?.identities[0]?.porch?.phase).toBe("implement");
+    expect(snapshot?.messageLog).toBe("available");
+  });
+
+  /**
+   * The mirror is kept honest by REFUSAL, not by hope. This module cannot import
+   * the agent's own types, so the only thing standing between a changed wire
+   * shape and a fabricated phase is this check.
+   */
+  it("refuses a payload missing what this build reads", () => {
+    expect(validateAgentSnapshot({ protocol: { identities: [] } })).toBeNull();
+    expect(validateAgentSnapshot({ ...snapshotBody, protocol: {} })).toBeNull();
+    expect(
+      validateAgentSnapshot({
+        ...snapshotBody,
+        protocol: { identities: [{ role: "builder", porch: { projectId: "250" } }] },
+      }),
+    ).toBeNull();
+  });
+
+  /** An agent that GAINS a field still validates; only a missing one refuses. */
+  it("tolerates fields this build does not read", () => {
+    expect(
+      validateAgentSnapshot({
+        ...snapshotBody,
+        somethingNew: true,
+        protocol: { ...snapshotBody.protocol, alsoNew: 1 },
+      }),
+    ).not.toBeNull();
+  });
+});
+
+describe("codev workspace state read (spec 250, phase 10)", () => {
+  it("reads over the same-origin proxy with the machine credential", async () => {
+    let seen = "";
+    let headers: Record<string, string> = {};
+    const read = await readWorkspaceState(
+      (async (input: RequestInfo | URL, init?: RequestInit) => {
+        seen = String(input);
+        headers = (init?.headers ?? {}) as Record<string, string>;
+        return new Response(JSON.stringify(snapshotBody), { status: 200 });
+      }) as typeof globalThis.fetch,
+      pairing,
+    );
+    expect(read.kind).toBe("read");
+    expect(seen).toBe(
+      "/api/codev/agent/local/api/agent/v1/workspaces/L1VzZXJzL2NocmlzL2Rldi9jb2Rldg/state",
+    );
+    expect(headers["x-codev-machine-credential"]).toBe("cred-1.secret");
+  });
+
+  it("reports a refusal with the agent's own signal", async () => {
+    const read = await readWorkspaceState(
+      async () =>
+        new Response(JSON.stringify({ signal: "MACHINE_CREDENTIAL_REVOKED", message: "revoked" }), {
+          status: 401,
+        }),
+      pairing,
+    );
+    expect(read).toEqual({
+      kind: "unreachable",
+      signal: "MACHINE_CREDENTIAL_REVOKED",
+      message: "revoked",
+    });
+  });
+
+  /** A 200 this build cannot read is NOT an empty workspace, and says so. */
+  it("reports an unreadable 200 as unreadable, never as an empty workspace", async () => {
+    const read = await readWorkspaceState(
+      async () => new Response(JSON.stringify({ hello: "world" }), { status: 200 }),
+      pairing,
+    );
+    expect(read.kind).toBe("unreadable");
+    if (read.kind !== "unreadable") return;
+    expect(read.message).toContain("could not read");
+  });
+});
+
+describe("pane content (spec 250, phase 10)", () => {
+  const read: AgentStateRead = {
+    kind: "read",
+    snapshot: validateAgentSnapshot(snapshotBody) as NonNullable<
+      ReturnType<typeof validateAgentSnapshot>
+    >,
+  };
+
+  it("carries the phase, the plan phase and the last three messages, newest first", () => {
+    const content = resolvePaneContent(read, "thread-1");
+    expect(content.kind).toBe("known");
+    if (content.kind !== "known") return;
+    expect(content.porch?.phase).toBe("implement");
+    expect(content.porch?.currentPlanPhase).toBe("phase_10");
+    expect(content.messages.map((entry) => entry.id)).toEqual(["m3", "m2", "m1"]);
+    expect(content.messages[1]?.truncated).toBe(true);
+  });
+
+  /**
+   * Four ways of not having a phase, and each one names itself. A blank line for
+   * all four would be a claim about the builder rather than about what reached
+   * the browser.
+   */
+  it("keeps unpaired, unavailable and absent as three different answers", () => {
+    expect(
+      resolvePaneContent({ kind: "unpaired", message: "no credential" }, "thread-1").kind,
+    ).toBe("unpaired");
+    expect(
+      resolvePaneContent(
+        { kind: "unreachable", signal: "CODEV_AGENT_UPSTREAM_GONE", message: "gone" },
+        "thread-1",
+      ).kind,
+    ).toBe("unavailable");
+    expect(resolvePaneContent(read, "thread-missing").kind).toBe("absent");
+  });
+
+  it("distinguishes an unreadable message log from a builder that has said nothing", () => {
+    const unreadable = resolvePaneContent(
+      {
+        kind: "read",
+        snapshot: validateAgentSnapshot({
+          ...snapshotBody,
+          protocol: {
+            ...snapshotBody.protocol,
+            messageLog: "unreadable",
+            identities: [{ ...snapshotBody.protocol.identities[0], messages: undefined }],
+          },
+        }) as NonNullable<ReturnType<typeof validateAgentSnapshot>>,
+      },
+      "thread-1",
+    );
