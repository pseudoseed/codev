index 000000000..1a229be7d
--- /dev/null
+++ b/apps/web/src/codev/agentState.ts
@@ -0,0 +1,271 @@
+/**
+ * Codev customization (spec 250), phase 10 — what `codev-agent` publishes, read here at last.
+ *
+ * Phase 9's panes said "Phase not read here yet — published by codev-agent",
+ * which was the true sentence at the time: `codev-agent` has always published the
+ * porch phase and the last messages, workspace-scoped, in ONE request for the
+ * whole grid, and this page had no way to reach it. The same-origin proxy is that
+ * way, so this is the module that replaces the sentence with the data.
+ *
+ * ## One request for the grid, not one per pane
+ *
+ * `GET /api/agent/v1/workspaces/<b64>/state` answers for every identity in the
+ * workspace at once. That is why the plan's ban on six continuous subscriptions
+ * was never in tension with showing this: six panes cost one request.
+ *
+ * The SSE stream beside it is deliberately not proxied — the proxy buffers, and a
+ * buffered stream is live on the wire and empty in the page. So this polls, and
+ * the interval is a stated number rather than a hidden one.
+ *
+ * ## The wire shape is hand-mirrored, and the mirror is kept honest by refusal
+ *
+ * `agent-routes.ts` lives in the Codev package and reaches `node:fs` and
+ * `better-sqlite3` through its import graph, so this cannot import it — the same
+ * reason `apps/client/src/connection/types.ts` mirrors it. A payload this build
+ * does not recognise is REFUSED rather than rendered: a half-understood snapshot
+ * would put a phase on screen that nothing published.
+ *
+ * ## "I could not tell" is spelled differently from "no", in three places
+ *
+ * Not paired, could not reach the agent, and reached it and could not read the
+ * answer are three facts with three different next actions. A pane that showed a
+ * blank line for all three would be claiming the builder has no phase, which is a
+ * claim about the builder rather than about what reached the browser.
+ */
+
+import { agentUrl, encodeWorkspacePath, machineHeaders, type CodevPairing } from "./pairing";
+
+/** The porch projection, as `codev-agent` publishes it. */
+export interface CodevAgentPorch {
+  readonly projectId: string;
+  readonly title: string;
+  readonly protocol: string;
+  readonly phase: string;
+  readonly currentPlanPhase: string | null;
+}
+
+/** One message addressed to an agent, newest first. */
+export interface CodevAgentMessage {
+  readonly id: string;
+  readonly from: string;
+  readonly at: string;
+  readonly body: string;
+  /**
+   * NOT COSMETIC. A body cut at the agent's limit that renders without saying so
+   * is a message misreported as complete.
+   */
+  readonly truncated?: true;
+  readonly held?: true;
+}
+
+export interface CodevAgentIdentity {
+  readonly threadId?: string;
+  readonly role: "architect" | "builder" | "unmanaged";
+  readonly porch?: CodevAgentPorch;
+  /** Absent means none was published. Whether any could be READ is `messageLog`. */
+  readonly messages?: readonly CodevAgentMessage[];
+}
+
+export interface CodevAgentSnapshot {
+  readonly workspacePath: string;
+  readonly generatedAt: string;
+  readonly identities: readonly CodevAgentIdentity[];
+  /**
+   * Whether the message log was readable at all.
+   *
+   * Absent is a THIRD situation: an agent predating the field has messages it is
+   * not sending. An `unreadable` one could not open the store. An `available` one
+   * answered, possibly with nothing. Three facts, three words.
+   */
+  readonly messageLog?: "available" | "unreadable";
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function str(value: unknown): value is string {
+  return typeof value === "string";
+}
+
+function porch(value: unknown): value is CodevAgentPorch {
+  return (
+    isRecord(value) &&
+    str(value.projectId) &&
+    str(value.title) &&
+    str(value.protocol) &&
+    str(value.phase) &&
+    (value.currentPlanPhase === null || str(value.currentPlanPhase))
+  );
+}
+
+function message(value: unknown): value is CodevAgentMessage {
+  return (
+    isRecord(value) &&
+    str(value.id) &&
+    str(value.from) &&
+    str(value.at) &&
+    str(value.body) &&
+    (value.truncated === undefined || value.truncated === true) &&
+    (value.held === undefined || value.held === true)
+  );
+}
+
+function identity(value: unknown): value is CodevAgentIdentity {
+  return (
+    isRecord(value) &&
+    (value.threadId === undefined || str(value.threadId)) &&
+    (value.role === "architect" || value.role === "builder" || value.role === "unmanaged") &&
+    (value.porch === undefined || porch(value.porch)) &&
+    (value.messages === undefined ||
+      (Array.isArray(value.messages) && value.messages.every(message)))
+  );
+}
+
+/**
+ * The snapshot, or null.
+ *
+ * Deliberately narrower than the wire: this validates the fields the grid reads
+ * and ignores the rest, so an agent that GAINS a field still validates. What it
+ * refuses is a payload missing what this build needs — and a refusal is reported
+ * as "could not read", never as an empty workspace.
+ */
+export function validateAgentSnapshot(value: unknown): CodevAgentSnapshot | null {
+  if (!isRecord(value)) return null;
+  const protocol = value.protocol;
+  if (!isRecord(protocol)) return null;
+  if (!str(value.workspacePath) || !str(value.generatedAt)) return null;
+  if (!Array.isArray(protocol.identities) || !protocol.identities.every(identity)) return null;
+  const messageLog = protocol.messageLog;
+  if (messageLog !== undefined && messageLog !== "available" && messageLog !== "unreadable") {
+    return null;
+  }
+  return {
+    workspacePath: value.workspacePath,
+    generatedAt: value.generatedAt,
+    identities: protocol.identities,
+    ...(messageLog === undefined ? {} : { messageLog }),
+  };
+}
+
+export type AgentStateRead =
+  | { readonly kind: "read"; readonly snapshot: CodevAgentSnapshot }
+  /** The request did not produce an answer this page could use. */
+  | { readonly kind: "unreachable"; readonly signal: string; readonly message: string }
+  /** It answered 200 and this build could not read the payload. Not "empty". */
+  | { readonly kind: "unreadable"; readonly signal: string; readonly message: string };
+
+/** One read of the whole workspace, over the same-origin proxy. */
+export async function readWorkspaceState(
+  fetchImpl: typeof globalThis.fetch,
+  pairing: CodevPairing,
+): Promise<AgentStateRead> {
+  const url = agentUrl(
+    pairing.targetId,
+    `/api/agent/v1/workspaces/${encodeURIComponent(encodeWorkspacePath(pairing.workspacePath))}/state`,
+  );
+  let response: Response;
+  try {
+    response = await fetchImpl(url, {
+      headers: { accept: "application/json", ...machineHeaders(pairing) },
+    });
+  } catch (error) {
+    return {
+      kind: "unreachable",
+      signal: "CODEV_AGENT_STATE_UNREACHABLE",
+      message: `codev-agent could not be reached: ${(error as Error).message}`,
+    };
+  }
+  let body: unknown;
+  try {
+    body = await response.json();
+  } catch {
+    body = null;
+  }
+  const fields = isRecord(body) ? body : {};
+  if (response.status !== 200) {
+    return {
+      kind: "unreachable",
+      signal: str(fields.signal) ? fields.signal : `HTTP_${response.status}`,
+      message: str(fields.message)
+        ? fields.message
+        : `codev-agent answered ${response.status} for this workspace`,
+    };
+  }
+  const snapshot = validateAgentSnapshot(body);
+  if (snapshot === null) {
+    return {
+      kind: "unreadable",
+      signal: "CODEV_AGENT_STATE_UNREADABLE",
+      message:
+        "codev-agent answered with a snapshot this build does not understand. Nothing here says "
+        + "the workspace is empty; it says this page could not read the answer.",
+    };
+  }
+  return { kind: "read", snapshot };
+}
+
+/**
+ * How often the grid re-reads.
+ *
+ * One request for every pane, so this is one request per interval regardless of
+ * how many builders are on screen. Five seconds is chosen for a screen someone is
+ * WATCHING: a phase that changed thirty seconds ago and still reads as the old
+ * one is the staleness this page exists to remove. It is not a stream and does
+ * not pretend to be — `generatedAt` travels so the pane can say how old it is.
+ */
+export const AGENT_STATE_POLL_MS = 5_000;
+
+/** How many messages a pane shows. The plan's number, kept in one place. */
+export const PANE_MESSAGE_COUNT = 3;
+
+/**
+ * What one pane can say, and every branch is a different fact.
+ *
+ * The three "cannot" branches are not interchangeable. `unpaired` is something a
+ * human fixes in ten seconds; `unavailable` is a server to go and look at;
+ * `absent` says the agent answered and does not publish this thread, which is
+ * ordinary for a thread Codev did not create.
+ */
+export type PaneContent =
+  | { readonly kind: "unpaired"; readonly message: string }
+  | { readonly kind: "unavailable"; readonly signal: string; readonly message: string }
+  | { readonly kind: "absent"; readonly message: string }
+  | {
+      readonly kind: "known";
+      readonly porch: CodevAgentPorch | null;
+      readonly messages: readonly CodevAgentMessage[];
+      /**
+       * Whether the message log could be read at all.
+       *
+       * `unknown` is an agent that predates the field; `unreadable` is one that
+       * could not open the store. Neither is "this builder has said nothing", and
+       * rendering an empty box for them would be a claim about the builder.
+       */
+      readonly messageLog: "available" | "unreadable" | "unknown";
+      readonly generatedAt: string;
+    };
+
+export function resolvePaneContent(
+  read: AgentStateRead | { readonly kind: "unpaired"; readonly message: string },
+  threadId: string,
+): PaneContent {
+  if (read.kind === "unpaired") return read;
+  if (read.kind !== "read") {
+    return { kind: "unavailable", signal: read.signal, message: read.message };
+  }
+  const found = read.snapshot.identities.find((candidate) => candidate.threadId === threadId);
+  if (found === undefined) {
+    return {
+      kind: "absent",
+      message: "codev-agent does not publish this thread",
+    };
+  }
+  return {
+    kind: "known",
+    porch: found.porch ?? null,
+    messages: (found.messages ?? []).slice(0, PANE_MESSAGE_COUNT),
+    messageLog: read.snapshot.messageLog ?? "unknown",
+    generatedAt: read.snapshot.generatedAt,
+  };
+}
