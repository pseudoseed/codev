+/**
+ * Codev customization (spec 250), phase 10 — what this browser holds.
+ *
+ * The claims worth naming:
+ *
+ *  - an unreadable store is NOT an unpaired one. A private window throws on
+ *    access, and answering "unpaired" would send someone to spend a single-use
+ *    token over a condition another token does not fix.
+ *  - every URL this module builds is a PATH on this origin. There is no absolute
+ *    URL for the page to hold, which is the same-origin property stated as code
+ *    rather than as a comment.
+ *  - an empty target list always carries a reason.
+ */
+
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  agentUrl,
+  encodeWorkspacePath,
+  fetchAgentTargets,
+  machineHeaders,
+  PAIRING_STORAGE_KEY,
+  readPairing,
+  redeemPairing,
+  writePairing,
+  type CodevPairing,
+} from "./pairing";
+
+const pairing: CodevPairing = {
+  targetId: "local",
+  machine: "ipad",
+  credential: "cred-1.secret",
+  workspacePath: "/Users/chris/dev/codev",
+};
+
+function memoryStorage(seed: Record<string, string> = {}): Storage {
+  const map = new Map(Object.entries(seed));
+  return {
+    get length() {
+      return map.size;
+    },
+    clear: () => map.clear(),
+    getItem: (key: string) => map.get(key) ?? null,
+    key: (index: number) => [...map.keys()][index] ?? null,
+    removeItem: (key: string) => void map.delete(key),
+    setItem: (key: string, value: string) => void map.set(key, value),
+  } as Storage;
+}
+
+function throwingStorage(): Storage {
+  return {
+    get length() {
+      return 0;
+    },
+    clear: () => {},
+    getItem: () => {
+      throw new Error("site data is blocked");
+    },
+    key: () => null,
+    removeItem: () => {},
+    setItem: () => {
+      throw new Error("site data is blocked");
+    },
+  } as unknown as Storage;
+}
+
+describe("codev pairing storage (spec 250, phase 10)", () => {
+  it("round-trips a pairing", () => {
+    const storage = memoryStorage();
+    expect(writePairing(pairing, storage)).toEqual({ ok: true });
+    expect(readPairing(storage)).toEqual({ kind: "paired", pairing });
+  });
+
+  it("reports an empty store as unpaired", () => {
+    expect(readPairing(memoryStorage())).toEqual({ kind: "unpaired" });
+  });
+
+  /**
+   * THE ONE THAT MATTERS. A store that throws on access is "I could not tell",
+   * and spelling it "unpaired" sends a human to spend a token they already have
+   * a credential for.
+   */
+  it("reports a store that throws as unreadable, never as unpaired", () => {
+    const read = readPairing(throwingStorage());
+    expect(read.kind).toBe("unreadable");
+    if (read.kind !== "unreadable") return;
+    expect(read.message).toContain("site data is blocked");
+  });
+
+  it("reports an unparseable stored value as unreadable rather than absent", () => {
+    const read = readPairing(memoryStorage({ [PAIRING_STORAGE_KEY]: "{not json" }));
+    expect(read.kind).toBe("unreadable");
+  });
+
+  it("reports a stored value missing fields this build needs as unreadable", () => {
+    const read = readPairing(
+      memoryStorage({ [PAIRING_STORAGE_KEY]: JSON.stringify({ targetId: "local" }) }),
+    );
+    expect(read.kind).toBe("unreadable");
+  });
+
+  it("says so when the credential could not be stored, rather than reporting success", () => {
+    expect(writePairing(pairing, throwingStorage())).toEqual({
+      ok: false,
+      message: expect.stringContaining("site data is blocked"),
+    });
+  });
+});
+
+describe("codev agent URLs (spec 250, phase 10)", () => {
+  /**
+   * The same-origin property, as a test rather than a comment: every URL is a
+   * path, so there is no origin in the page for anything to redirect or be
+   * talked into naming.
+   */
+  it("builds paths on this origin and never an absolute URL", () => {
+    const url = agentUrl("local", "/api/agent/v1/session");
+    expect(url).toBe("/api/codev/agent/local/api/agent/v1/session");
+    expect(url.startsWith("/")).toBe(true);
+    expect(() => new URL(url)).toThrow();
+  });
+
+  it("escapes a target id rather than letting it add a path segment", () => {
+    expect(agentUrl("a/b", "/api/agent/v1/session")).toBe(
+      "/api/codev/agent/a%2Fb/api/agent/v1/session",
+    );
+  });
+
+  it("encodes a workspace path as base64url, matching the agent's decoder", () => {
+    expect(encodeWorkspacePath("/Users/chris/dev/codev")).toBe(
+      "L1VzZXJzL2NocmlzL2Rldi9jb2Rldg",
+    );
+  });
+
+  it("sends the machine credential and nothing else", () => {
+    expect(machineHeaders(pairing)).toEqual({ "x-codev-machine-credential": "cred-1.secret" });
+  });
+});
+
+describe("codev agent target list (spec 250, phase 10)", () => {
+  it("reads the ids this server will proxy to", async () => {
+    const read = await fetchAgentTargets(
+      async () => new Response(JSON.stringify({ targets: [{ id: "local" }] }), { status: 200 }),
+    );
+    expect(read).toEqual({ ok: true, targets: [{ id: "local" }] });
+  });
+
+  it("carries the reason an empty list is empty", async () => {
+    const read = await fetchAgentTargets(
+      async () =>
+        new Response(
+          JSON.stringify({
+            signal: "CODEV_AGENTS_UNCONFIGURED",
+            message: "No codev-agent targets are configured.",
+            targets: [],
+          }),
+          { status: 200 },
+        ),
+    );
+    expect(read).toEqual({
+      ok: false,
+      signal: "CODEV_AGENTS_UNCONFIGURED",
+      message: "No codev-agent targets are configured.",
+    });
+  });
+
+  it("reports a server that could not be asked separately from one with nothing configured", async () => {
+    const read = await fetchAgentTargets(async () => {
+      throw new Error("network down");
+    });
+    expect(read).toEqual({
+      ok: false,
+      signal: "CODEV_AGENT_TARGETS_UNREACHABLE",
+      message: expect.stringContaining("network down"),
+    });
+  });
+});
+
+describe("codev pairing redemption (spec 250, phase 10)", () => {
+  it("spends the token at the agent and keeps what it issued", async () => {
+    let seen: { url: string; init: RequestInit | undefined } | null = null;
+    const outcome = await redeemPairing(
+      async (url, init) => {
+        seen = { url: String(url), init };
+        return new Response(
+          JSON.stringify({ signal: "PAIRING_TOKEN_ACCEPTED", machine: "ipad", credential: "c.s" }),
+          { status: 201 },
+        );
+      },
+      { targetId: "local", machine: "ipad", token: "tok-1", workspacePath: "/w" },
+    );
+    expect(outcome).toEqual({
+      ok: true,
+      pairing: { targetId: "local", machine: "ipad", credential: "c.s", workspacePath: "/w" },
+    });
+    expect(seen).not.toBeNull();
+    const request = seen as unknown as { url: string; init: RequestInit };
+    expect(request.url).toBe("/api/codev/agent/local/api/agent/v1/pairing/redeem");
+    expect((request.init.headers as Record<string, string>)["x-codev-pairing-token"]).toBe("tok-1");
+  });
+
+  /** The agent's own words, not a refusal reworded here. */
+  it("reports the agent's refusal verbatim", async () => {
+    const outcome = await redeemPairing(
+      async () =>
+        new Response(JSON.stringify({ signal: "PAIRING_TOKEN_SPENT", message: "already redeemed" }), {
+          status: 401,
+        }),
+      { targetId: "local", machine: "ipad", token: "tok-1", workspacePath: "/w" },
+    );
+    expect(outcome).toEqual({
+      ok: false,
+      signal: "PAIRING_TOKEN_SPENT",
+      message: "already redeemed",
+    });
+  });
+
+  it("refuses a 201 that carried no credential rather than storing nothing as a pairing", async () => {
+    const outcome = await redeemPairing(
+      async () => new Response(JSON.stringify({ signal: "PAIRING_TOKEN_ACCEPTED" }), { status: 201 }),
+      { targetId: "local", machine: "ipad", token: "tok-1", workspacePath: "/w" },
+    );
+    expect(outcome.ok).toBe(false);
+  });
+});
diff --git a/apps/web/src/codev/pairing.ts b/apps/web/src/codev/pairing.ts
new file mode 100644
index 000000000..acbd70c99
--- /dev/null
+++ b/apps/web/src/codev/pairing.ts
@@ -0,0 +1,285 @@
+/**
+ * Codev customization (spec 250), phase 10 — what this browser holds, and how it got it.
+ *
+ * ## Two halves, and neither one alone approves anything
+ *
+ * A **machine credential**, redeemed once from a `machine-credential` pairing
+ * token, identifies this browser to `codev-agent` and is revocable on its own
+ * (`afx pair revoke <machine>`). A **`client-session`** token, spent per session
+ * through `openHumanSession`, makes each session a distinct recorded act. They
+ * are different secrets with different lifetimes, obtained from two separate
+ * `afx pair issue` mints, and the approval path needs both.
+ *
+ * Neither is t3code's own session. Being signed into t3code is not approval
+ * authority — the proxy refuses to forward `authorization` and `cookie` at all,
+ * so it could not be even by accident.
+ *
+ * ## Where the credential lives, and why that is worse than `apps/client`
+ *
+ * `apps/client` reads an operator-written `~/.agent-farm/client-machines.json` at
+ * mode 0600. A page in a browser has no equivalent, so this holds the credential
+ * in per-origin browser storage, and that is strictly more exposed: an XSS on
+ * this page reaches it, and the proxy sees every credential it forwards.
+ *
+ * The trade is deliberate and is bounded by what the credential IS. It is scoped
+ * to one machine name and revocable on its own, and it is emphatically never
+ * Tower's shared key, which cannot be revoked for one machine without rotating
+ * it for all. So the worst case is one revocable machine, not host-wide access.
+ *
+ * ## Storage can throw, and an unreadable store is not an empty one
+ *
+ * Private windows and blocked site data make `localStorage` throw on ACCESS, not
+ * merely return null. A read that swallowed that would report "not paired" to
+ * someone who is, and send them to spend a token they did not need. So the read
+ * answers with three cases and the panel says which.
+ */
+
+import { CODEV_AGENT_PROXY_PREFIX, CODEV_AGENT_TARGETS_PATH } from "@t3tools/shared/codevAgentProxy";
+
+export const MACHINE_CREDENTIAL_HEADER = "x-codev-machine-credential";
+export const PAIRING_TOKEN_HEADER = "x-codev-pairing-token";
+export const HUMAN_SESSION_HEADER = "x-codev-human-session";
+/** The approval receipt. A header, not a query parameter: URLs are logged. */
+export const APPROVAL_RECEIPT_HEADER = "x-codev-approval-receipt";
+
+/** Versioned, so a later shape change is a miss rather than a misread. */
+export const PAIRING_STORAGE_KEY = "codev.pairing.v1";
+
+/** What this browser holds for one `codev-agent`. */
+export interface CodevPairing {
+  /** The configured target's id. NEVER a URL — the server owns the origins. */
+  readonly targetId: string;
+  /** The machine name this credential was issued for. */
+  readonly machine: string;
+  /** `<credentialId>.<secret>`. Never logged. */
+  readonly credential: string;
+  /** Absolute workspace path on that machine, identifying what is approved in. */
+  readonly workspacePath: string;
+}
+
+export type PairingRead =
+  | { readonly kind: "paired"; readonly pairing: CodevPairing }
+  | { readonly kind: "unpaired" }
+  /** The store could not be read. NOT "unpaired" — the answer is unknown. */
+  | { readonly kind: "unreadable"; readonly message: string };
+
+function wellFormed(value: unknown): value is CodevPairing {
+  if (typeof value !== "object" || value === null) return false;
+  const entry = value as Record<string, unknown>;
+  return (
+    typeof entry.targetId === "string" &&
+    entry.targetId.length > 0 &&
+    typeof entry.machine === "string" &&
+    entry.machine.length > 0 &&
+    typeof entry.credential === "string" &&
+    entry.credential.length > 0 &&
+    typeof entry.workspacePath === "string" &&
+    entry.workspacePath.length > 0
+  );
+}
+
+export function readPairing(storage: Storage | undefined = globalThis.localStorage): PairingRead {
+  if (storage === undefined) {
+    return { kind: "unreadable", message: "this browser exposes no local storage" };
+  }
+  let raw: string | null;
+  try {
+    raw = storage.getItem(PAIRING_STORAGE_KEY);
+  } catch (error) {
+    return {
+      kind: "unreadable",
+      message: `browser storage could not be read (${(error as Error).message}); whether this `
+        + "browser is paired is unknown",
+    };
+  }
+  if (raw === null) return { kind: "unpaired" };
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    // A stored value this build cannot parse is not a pairing, and saying
+    // "unpaired" would be right about what is usable and wrong about what is
+    // there. Naming it lets a human clear it rather than wonder.
+    return { kind: "unreadable", message: "the stored pairing is not readable JSON" };
+  }
+  if (!wellFormed(parsed)) {
+    return { kind: "unreadable", message: "the stored pairing is missing fields this build needs" };
+  }
+  return { kind: "paired", pairing: parsed };
+}
+
+export function writePairing(
+  pairing: CodevPairing,
+  storage: Storage | undefined = globalThis.localStorage,
+): { readonly ok: true } | { readonly ok: false; readonly message: string } {
+  if (storage === undefined) return { ok: false, message: "this browser exposes no local storage" };
+  try {
+    storage.setItem(PAIRING_STORAGE_KEY, JSON.stringify(pairing));
+    return { ok: true };
+  } catch (error) {
+    return { ok: false, message: `browser storage could not be written (${(error as Error).message})` };
+  }
+}
+
+export function clearPairing(storage: Storage | undefined = globalThis.localStorage): void {
+  try {
+    storage?.removeItem(PAIRING_STORAGE_KEY);
+  } catch {
+    /* a store that will not clear is one the read already reports as unreadable */
+  }
+}
+
+/** base64url of the absolute path, matching `decodeWorkspacePath` on the agent. */
+export function encodeWorkspacePath(workspacePath: string): string {
+  const bytes = new TextEncoder().encode(workspacePath);
+  let binary = "";
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+/**
+ * The URL for one `codev-agent` call, on THIS origin.
+ *
+ * The target is named by its configured id and the origin never appears. That is
+ * the whole same-origin property: there is no absolute URL for the page to hold,
+ * so there is none for it to be talked into using.
+ */
+export function agentUrl(targetId: string, path: string): string {
+  return `${CODEV_AGENT_PROXY_PREFIX}/${encodeURIComponent(targetId)}${path}`;
+}
+
+export function machineHeaders(pairing: CodevPairing): Record<string, string> {
+  return { [MACHINE_CREDENTIAL_HEADER]: pairing.credential };
+}
+
+export interface CodevAgentTargetSummary {
+  readonly id: string;
+}
+
+export type AgentTargetsRead =
+  | { readonly ok: true; readonly targets: readonly CodevAgentTargetSummary[] }
+  | { readonly ok: false; readonly signal: string; readonly message: string };
+
+/**
+ * Which targets this server will proxy to.
+ *
+ * An empty list ALWAYS carries its reason. A picker with no entries and no
+ * explanation reads as a broken feature; "nobody configured one" and "the server
+ * could not be asked" are different situations with different next actions.
+ */
+export async function fetchAgentTargets(
+  fetchImpl: typeof globalThis.fetch,
+): Promise<AgentTargetsRead> {
+  let response: Response;
+  try {
+    response = await fetchImpl(CODEV_AGENT_TARGETS_PATH, { headers: { accept: "application/json" } });
+  } catch (error) {
+    return {
+      ok: false,
+      signal: "CODEV_AGENT_TARGETS_UNREACHABLE",
+      message: `this server could not be asked which codev-agents it proxies to: ${(error as Error).message}`,
+    };
+  }
+  let body: Record<string, unknown> = {};
+  try {
+    const parsed: unknown = await response.json();
+    if (parsed !== null && typeof parsed === "object") body = parsed as Record<string, unknown>;
+  } catch {
+    /* an unreadable body is handled by the shape check below */
+  }
+  if (response.status !== 200) {
+    return {
+      ok: false,
+      signal: typeof body.signal === "string" ? body.signal : `HTTP_${response.status}`,
+      message:
+        typeof body.message === "string"
+          ? body.message
+          : `this server answered ${response.status} when asked which codev-agents it proxies to`,
+    };
+  }
+  const raw = Array.isArray(body.targets) ? body.targets : [];
+  const targets = raw
+    .filter((entry): entry is { id: string } =>
+      entry !== null && typeof entry === "object" && typeof (entry as { id?: unknown }).id === "string",
+    )
+    .map((entry) => ({ id: entry.id }));
+  if (targets.length === 0) {
+    return {
+      ok: false,
+      signal: typeof body.signal === "string" ? body.signal : "CODEV_AGENTS_UNCONFIGURED",
+      message:
+        typeof body.message === "string"
+          ? body.message
+          : "this server proxies to no codev-agent, and did not say why",
+    };
+  }
+  return { ok: true, targets };
+}
+
+export type PairingOutcome =
+  | { readonly ok: true; readonly pairing: CodevPairing }
+  | { readonly ok: false; readonly signal: string; readonly message: string };
+
+/**
+ * Spend a `machine-credential` pairing token for this browser's credential.
+ *
+ * Single-use and minutes-long: it is the one secret a human retypes. The token
+ * is spent at the agent, not here, so a refusal is the agent's own signal rather
+ * than a guess made in the page.
+ */
+export async function redeemPairing(
+  fetchImpl: typeof globalThis.fetch,
+  input: {
+    readonly targetId: string;
+    readonly machine: string;
+    readonly token: string;
+    readonly workspacePath: string;
+  },
+): Promise<PairingOutcome> {
+  let response: Response;
+  try {
+    response = await fetchImpl(agentUrl(input.targetId, "/api/agent/v1/pairing/redeem"), {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        accept: "application/json",
+        [PAIRING_TOKEN_HEADER]: input.token,
+      },
+      body: JSON.stringify({ machine: input.machine }),
+    });
+  } catch (error) {
+    return {
+      ok: false,
+      signal: "CODEV_PAIRING_UNREACHABLE",
+      message: `the pairing request did not complete: ${(error as Error).message}`,
+    };
+  }
+  let body: Record<string, unknown> = {};
+  try {
+    const parsed: unknown = await response.json();
+    if (parsed !== null && typeof parsed === "object") body = parsed as Record<string, unknown>;
+  } catch {
+    /* handled below: a redemption with no readable credential is a refusal */
+  }
+  const credential = typeof body.credential === "string" ? body.credential : undefined;
+  const machine = typeof body.machine === "string" ? body.machine : input.machine;
+  if (response.status !== 201 || credential === undefined) {
+    return {
+      ok: false,
+      signal: typeof body.signal === "string" ? body.signal : `HTTP_${response.status}`,
+      message:
+        typeof body.message === "string"
+          ? body.message
+          : "the agent did not issue a machine credential for this browser",
+    };
+  }
+  return {
+    ok: true,
+    pairing: {
+      targetId: input.targetId,
+      machine,
+      credential,
+      workspacePath: input.workspacePath,
+    },
+  };
+}
