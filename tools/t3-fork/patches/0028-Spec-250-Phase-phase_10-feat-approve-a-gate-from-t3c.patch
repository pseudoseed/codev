+    expect(outcome.ok).toBe(false);
+    if (outcome.ok) return;
+    expect(outcome.unconfirmed).toBe(true);
+    expect(outcome.signal).toBe("GATE_APPROVAL_UNCONFIRMED");
+    // Nothing invented: the message says to go and look, and names no timestamp.
+    expect(outcome.message).toContain("status.yaml");
+  });
+
+  it("reports a refusal as a refusal, with the agent's own words", async () => {
+    const outcome = await approveGate(
+      fakeFetch({
+        ...CAPABILITY,
+        "/gates/approvals": {
+          status: 202,
+          body: { operationId: "op-1", receipt: "rcpt", projectId: "250", gateName: "plan-approval" },
+        },
+        "/gates/approvals/op-1": {
