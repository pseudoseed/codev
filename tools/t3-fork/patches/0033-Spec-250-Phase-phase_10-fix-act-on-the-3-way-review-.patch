 apps/web/src/codev/GateApproval.tsx | 39 +++++++++++++++++++++--
 apps/web/src/codev/approval.test.ts | 49 ++++++++++++++++++++++++++++-
 3 files changed, 107 insertions(+), 10 deletions(-)

diff --git a/apps/server/src/codev/agentProxy.ts b/apps/server/src/codev/agentProxy.ts
index bdbd9a7cd..c13b2ef66 100644
--- a/apps/server/src/codev/agentProxy.ts
+++ b/apps/server/src/codev/agentProxy.ts
@@ -353,13 +353,27 @@ export function forwardableHeaders(
 }
 
 /**
- * Bound on how long the upstream may take to produce response headers.
+ * How long the upstream may be SILENT before this hop gives up.
  *
- * Every route this proxy carries is a bounded request/response, so unlike
- * `client-static.ts` this is a bound on the whole exchange rather than on headers
- * alone — there is no SSE stream here that is meant to outlive it. An approval
- * SUBMIT returns at once and is polled; it is the poll that waits, one request at
- * a time.
+ * **It is an idle-socket timeout, not a total-duration bound**, because that is
+ * what `ClientRequest.setTimeout` gives: the clock restarts on socket activity.
+ * The first draft's comment called it "a bound on the whole exchange", which is a
+ * guarantee this code does not have, and overstating a bound is the same class of
+ * error as overstating a CSP — it reads as protection that is not there.
+ *
+ * An idle bound is the right one here anyway. Unlike `client-static.ts` there is
+ * no SSE stream to outlive it — the stream route is deliberately not carried —
+ * and every route that IS carried is a bounded request/response: an approval
+ * submit returns at once and is polled, one request at a time. What the bound
+ * exists to catch is a machine that accepts a socket and never answers, because
+ * each of those holds a request open on this server's event loop.
+ *
+ * The residual, stated rather than left implicit: an upstream that trickles a
+ * byte every 14 seconds is not bounded by this. That upstream is one the operator
+ * named in `T3CODE_CODEV_AGENT_ORIGINS`, so it is not a stranger, and closing it
+ * would mean a total-duration bound that has to be large enough for the slowest
+ * legitimate answer — a worse trade for a threat the allowlist already narrows to
+ * the operator's own hosts.
  */
 export const UPSTREAM_TIMEOUT_MS = 15_000;
 
@@ -476,6 +490,9 @@ export function proxyToAgent(input: {
        * wanting different next actions: one host refused the connection, the
        * other accepted it and then said nothing. Reporting a silent host as a
        * dead one sends an operator to check whether it is running, which it is.
+       *
+       * `silent` is the accurate word for what this fires on — see
+       * {@link UPSTREAM_TIMEOUT_MS}: it is inactivity, not elapsed time.
        */
       upstream.destroy();
       settle({ kind: "silent", timeoutMs });
