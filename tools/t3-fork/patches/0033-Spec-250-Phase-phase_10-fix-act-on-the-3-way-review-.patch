+/**
+ * The outcome as one word, for a test and for anything reading the DOM.
+ *
+ * Kept beside the rendering rather than inlined so the two cannot drift: the
+ * branch order here is the branch order below.
+ */
+export type ApprovalStateAttribute =
+  | "idle"
+  | "approved"
+  | "unconfirmed"
+  | "session-ended"
+  | "refused";
+
+export function approvalStateAttribute(
+  outcome: ApprovalOutcome | null,
+): ApprovalStateAttribute {
+  if (outcome === null) return "idle";
+  if (outcome.ok) return "approved";
+  if (outcome.unconfirmed === true) return "unconfirmed";
+  if (outcome.sessionEnded === true) return "session-ended";
+  return "refused";
+}
+
