 import { describe, expect, it } from "vite-plus/test";
 
-import { approveGate, openHumanSession, type HumanSession } from "./approval";
+import { approveGate, openHumanSession, type ApprovalOutcome, type HumanSession } from "./approval";
+import { approvalStateAttribute } from "./GateApproval";
 import type { CodevPairing } from "./pairing";
 
 const pairing: CodevPairing = {
@@ -449,3 +450,49 @@ describe("approveGate (spec 250, phase 10)", () => {
     expect(seen.every((url) => !url.includes("rcpt-secret"))).toBe(true);
   });
 });
+
+/**
+ * The machine-readable outcome, which must not be coarser than the words.
+ *
+ * Review finding, and the reason it was worth fixing before anything asserted on
+ * it: the attribute computed three values, so `sessionEnded` tagged as `refused`
+ * while the visible text distinguished them. The first test written against the
+ * attribute would have inherited "the session idled out" spelled the same as
+ * "your approval was refused" — the conflation this whole module exists to stop,
+ * one layer below where a human reads it.
+ */
+describe("approval state attribute (spec 250, phase 10)", () => {
+  const refusal: ApprovalOutcome = {
+    ok: false,
+    signal: "GATE_NOT_PENDING",
+    message: "that gate is not pending",
+  };
+
+  it("gives each of the four outcomes its own word, plus idle", () => {
+    expect(approvalStateAttribute(null)).toBe("idle");
+    expect(
+      approvalStateAttribute({ ok: true, approvedAt: "t", machine: "m", sessionId: null }),
+    ).toBe("approved");
+    expect(approvalStateAttribute({ ...refusal, unconfirmed: true })).toBe("unconfirmed");
+    expect(approvalStateAttribute({ ...refusal, sessionEnded: true })).toBe("session-ended");
+    expect(approvalStateAttribute(refusal)).toBe("refused");
+  });
+
+  it("does not spell a session that ended the same way as a refusal", () => {
+    expect(approvalStateAttribute({ ...refusal, sessionEnded: true })).not.toBe(
+      approvalStateAttribute(refusal),
+    );
+  });
+
+  /**
+   * `unconfirmed` wins over `sessionEnded` when a body carries both: the poll's
+   * 401 path sets `sessionEnded`, and an unreadable answer is the stronger claim
+   * about what is unknown. Pinned so the precedence is a decision rather than an
+   * accident of branch order.
+   */
+  it("prefers unconfirmed when an outcome carries both flags", () => {
+    expect(
+      approvalStateAttribute({ ...refusal, unconfirmed: true, sessionEnded: true }),
+    ).toBe("unconfirmed");
+  });
+});
