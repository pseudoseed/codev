 apps/web/src/codev/gateState.test.ts |  6 +++--
 apps/web/src/codev/gateState.ts      | 19 ++++++++++------
 apps/web/src/components/Sidebar.tsx  | 33 +++++++++++++---------------
 3 files changed, 31 insertions(+), 27 deletions(-)

