+++ b/apps/web/src/codev/gateState.test.ts
@@ -248,7 +248,9 @@ describe("the gate bounds are the schema's, not the renderer's", () => {
 describe("resolveCodevGatePill", () => {
   it("names the gate, so the row says WHICH decision is waiting", () => {
     const pill = resolveCodevGatePill(resolveCodevGateState(gate({ gateName: "spec-approval" })));
-    expect(pill?.label).toBe("Gate: spec-approval");
+    // The name alone. The word "Gate" is the icon's job — see the doc comment
+    // for the row width that decided it.
+    expect(pill?.label).toBe("spec-approval");
   });
 
   it("gives both pending states the same pill", () => {
@@ -265,7 +267,7 @@ describe("resolveCodevGatePill", () => {
     // Input, sky Working, violet Plan Ready, emerald Completed. Reusing amber
     // would collapse the exact distinction the gate block exists to make.
     for (const taken of ["amber", "indigo", "sky", "violet", "emerald"]) {
-      expect(`${pill?.colorClass} ${pill?.dotClass}`).not.toContain(taken);
+      expect(pill?.colorClass).not.toContain(taken);
     }
   });
 });
