 /**
@@ -128,16 +127,22 @@ export interface CodevGatePill {
  * violet Plan Ready, emerald Completed. Reusing amber would collapse exactly the
  * distinction phase 4 built the gate block to make.
  *
- * The label carries the gate NAME, because "which gate" is the first thing a
- * human asks and the panel is a click away. Both pending states get the same
- * pill: from the sidebar, a gate with no attached question is no less blocking
- * than one with a question.
+ * **The label is the gate NAME alone, and the word "Gate" is carried by the
+ * icon.** It read `Gate: plan-approval` first, which is better in isolation and
+ * does not survive the row: a sidebar is ~230px, and on a gated ARCHITECT that
+ * label plus the role caption plus the timestamp overflow it — the first version
+ * truncated "Architect" to "A…", and moving the label to the title line
+ * truncated the title instead. The gavel is the same glyph the panel opens with,
+ * so the row and the panel say "gate" the same way and the six characters buy
+ * back the room.
+ *
+ * Both pending states get the same marker: from the sidebar, a gate with no
+ * attached question is no less blocking than one with a question.
  */
 export function resolveCodevGatePill(state: CodevGateState): CodevGatePill | null {
   if (state.kind === "none") return null;
   return {
-    label: `Gate: ${state.gateName}`,
+    label: state.gateName,
     colorClass: "text-rose-600 dark:text-rose-300/90",
-    dotClass: "bg-rose-500 dark:bg-rose-300/90",
   };
 }
