-          className={cn("ml-auto shrink-0 font-medium text-xs", status.colorClass)}
+          className={cn("ml-auto shrink-0 font-medium text-[13px]", status.colorClass)}
         >
           {status.label}
         </span>
       </header>
 
-      <p data-testid="codev-pane-phase" className="flex min-w-0 items-center gap-1 text-xs">
+      {/*
+        13px, not `text-xs`.
+
+        t3code's own secondary labels are 12px and that is right in a sidebar
