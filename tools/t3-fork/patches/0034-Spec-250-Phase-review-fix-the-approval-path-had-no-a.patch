+/**
+ * A sentence about the network, from whatever the runtime threw.
+ *
+ * `fetch` rejects with a `TypeError` whose message is deliberately vague, and a
+ * non-Error can be thrown by anything. An empty string here would put "()" in
+ * front of a human, so there is a floor.
+ */
+function describeTransportFailure(error: unknown): string {
+  const message = error instanceof Error ? error.message : String(error);
+  return message.trim() === "" ? "the connection failed" : message;
+}
+
+/**
+ * The gate was NOT approved, and this is not an "I could not tell".
+ *
+ * Used only for the steps that run BEFORE an approval is submitted. Opening a
+ * session, issuing a capability and minting a nonce are preparation: if one of
+ * them cannot reach the agent, no approval was ever requested, so reporting
+ * `unconfirmed` would send a human to check a gate that provably did not move —
+ * and, worse, teach them that "unconfirmed" is the ordinary noise of a flaky
+ * network rather than the rare thing it is.
+ */
+function unreachable(signal: string, step: string, error: string): ApprovalOutcome {
+  return {
+    ok: false,
+    signal,
+    message:
+      `could not reach the agent to ${step} (${error}). Nothing was submitted, so the gate was not `
+      + "approved and there is nothing to check — fix the connection and approve again.",
+  };
+}
