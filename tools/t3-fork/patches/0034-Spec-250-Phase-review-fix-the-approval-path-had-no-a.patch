+  it("refuses a response past the bound, and aborts the upstream rather than reading on", async () => {
+    let aborted = false;
+    const megabyte = Buffer.alloc(256 * 1024, 0x61);
+    const origin = await listen(
+      NodeHttp.createServer((request, response) => {
+        request.on("aborted", () => {
+          aborted = true;
+        });
+        response.writeHead(200, { "content-type": "application/json" });
+        // Never calls end(). A proxy that stops reading without destroying the
+        // socket leaves this writing into a connection nobody drains.
+        const push = (): void => {
+          if (response.writableEnded || response.destroyed) return;
+          if (response.write(megabyte)) setImmediate(push);
+          else response.once("drain", push);
+        };
+        push();
+      }),
+    );
+    const outcome = await proxyToAgent({
+      origin,
+      path: "/api/agent/v1/session",
+      method: "GET",
+      headers: {},
+      body: undefined,
+    });
+    expect(outcome.kind).toBe("oversized");
+    if (outcome.kind !== "oversized") return;
+    expect(outcome.limitBytes).toBe(MAX_PROXIED_RESPONSE_BYTES);
+    // The upstream is torn down, not merely ignored — otherwise the target keeps
+    // streaming and the resource is held under a different name.
+    await new Promise((settle) => setTimeout(settle, 50));
+    expect(aborted, "the upstream request must be aborted, not left streaming").toBe(true);
+  });
+
+  /**
+   * The bound must not fire on an ordinary answer, or every approval would be
+   * refused as oversized and the test above would pass for the wrong reason.
+   */
+  it("carries a response that sits just under the bound", async () => {
+    const body = "a".repeat(MAX_PROXIED_RESPONSE_BYTES - 1);
+    const origin = await listen(
+      NodeHttp.createServer((_request, response) => {
+        response.writeHead(200, { "content-type": "text/plain" });
+        response.end(body);
+      }),
+    );
+    const outcome = await proxyToAgent({
+      origin,
+      path: "/api/agent/v1/session",
+      method: "GET",
+      headers: {},
+      body: undefined,
+    });
+    expect(outcome.kind).toBe("answered");
+    if (outcome.kind !== "answered") return;
+    expect(outcome.body.byteLength).toBe(MAX_PROXIED_RESPONSE_BYTES - 1);
+  });
 });
