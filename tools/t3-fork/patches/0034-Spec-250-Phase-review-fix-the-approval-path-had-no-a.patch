+function fetchDyingOn(
+  deadPath: string,
+  replies: Readonly<Record<string, Reply>>,
+): typeof globalThis.fetch {
+  const healthy = fakeFetch(replies);
+  return (async (input: RequestInfo | URL, init?: RequestInit) => {
+    if (String(input).includes(deadPath)) {
+      // What `fetch` actually rejects with when the connection drops.
