diff --git a/apps/web/src/routes/_chat.codev-builders.tsx b/apps/web/src/routes/_chat.codev-builders.tsx
new file mode 100644
index 000000000..1cde3215f
--- /dev/null
+++ b/apps/web/src/routes/_chat.codev-builders.tsx
@@ -0,0 +1,81 @@
+/**
+ * Codev customization (spec 250), phase 9 — the builder grid, inside t3code's chrome.
+ *
+ * A child of `_chat`, deliberately: the criteria are about how many panes fit
+ * BESIDE the sidebar, and a route that escaped the shell would be measuring a
+ * page Codev does not ship. The sidebar is 232px of the 1440 the criterion
+ * names, and that is the whole reason the geometry was re-measured rather than
+ * ported.
+ */
+
+import { createFileRoute } from "@tanstack/react-router";
+import { useMemo } from "react";
+
+import { BuilderGrid } from "../codev/BuilderGrid";
+import type { BuilderPaneStatus, BuilderPaneThread } from "../codev/BuilderPane";
+import { buildCodevSidebarOrder, resolveSidebarThreadStatus } from "../components/Sidebar.logic";
+import { useThreadShells } from "../state/entities";
+
+/**
+ * One status vocabulary, t3code's own.
+ *
+ * `resolveSidebarThreadStatus` is what every sidebar row already answers with,
+ * so a pane and its row cannot disagree about what a builder is doing. A second
+ * derivation here would be two sources of truth for one fact.
+ */
+const STATUS_LABELS: Record<ReturnType<typeof resolveSidebarThreadStatus>, BuilderPaneStatus> = {
+  approval: { label: "Approval", colorClass: "text-amber-700 dark:text-amber-300" },
+  input: { label: "Input", colorClass: "text-indigo-600 dark:text-indigo-300" },
+  working: { label: "Working", colorClass: "text-sky-600 dark:text-sky-400" },
+  monitoring: { label: "Monitoring", colorClass: "text-sky-600 dark:text-sky-400" },
+  failed: { label: "Failed", colorClass: "text-red-700 dark:text-red-300" },
+  ready: { label: "Ready", colorClass: "text-muted-foreground" },
+};
+
+function CodevBuilderGridRoute() {
+  const threads = useThreadShells();
+
+  /**
+   * Architect first, then its builders — the same order the sidebar draws.
+   *
+   * `buildCodevSidebarOrder` already answers this, so the grid and the tree
+   * cannot drift into two different ideas of who owns whom. Threads Codev did
+   * not create are not here at all: this page is about the agents Codev is
+   * running, and an upstream thread in the grid would be a pane about something
+   * the grid cannot say anything useful about.
+   */
+  const panes = useMemo<readonly BuilderPaneThread[]>(() => {
+    const visible = threads.filter((thread) => thread.archivedAt === null);
+    const order = buildCodevSidebarOrder(visible, {
+      projectKeyOf: (thread) => `${thread.environmentId}:${thread.projectId}`,
+    });
+    return order.entries
+      .filter((entry) => entry.kind === "architect" || entry.kind === "builder")
+      .map((entry) => entry.thread);
+  }, [threads]);
+
+  const statusFor = useMemo(
+    () => (thread: BuilderPaneThread) => {
+      const shell = threads.find((candidate) => candidate.id === thread.id);
+      if (shell === undefined) return STATUS_LABELS.ready;
+      return STATUS_LABELS[resolveSidebarThreadStatus(shell)];
+    },
+    [threads],
+  );
+
+  return (
+    <div className="flex min-h-0 min-w-0 flex-1 flex-col">
+      {panes.length === 0 ? (
+        <p className="px-4 py-8 text-center text-muted-foreground text-sm">
+          No Codev agents in this workspace yet.
+        </p>
+      ) : (
+        <BuilderGrid threads={panes} statusFor={statusFor} />
+      )}
+    </div>
+  );
+}
+
+export const Route = createFileRoute("/_chat/codev-builders")({
+  component: CodevBuilderGridRoute,
+});
