diff --git a/apps/web/src/codev/BuilderGrid.tsx b/apps/web/src/codev/BuilderGrid.tsx
new file mode 100644
index 000000000..c1e7acf85
--- /dev/null
+++ b/apps/web/src/codev/BuilderGrid.tsx
@@ -0,0 +1,154 @@
+/**
+ * Codev customization (spec 250), phase 9 — four to six builders, watchable at once.
+ *
+ * ## The width it lays out against is MEASURED, not derived
+ *
+ * `apps/client` computed columns from the viewport because its grid was the
+ * whole page. This one is a route inside t3code's chat shell, behind a sidebar
+ * that is 232px at rest, narrower when resized, and gone at 390. A viewport
+ * number would be describing a page nobody is looking at, so the grid measures
+ * its own container and hands that to `columnsFor`.
+ *
+ * `ResizeObserver` rather than a window listener: the sidebar can be collapsed
+ * without the window changing size at all, and a grid that only listened to the
+ * window would keep three columns in a space that now fits four.
+ */
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+
+import { cn } from "~/lib/utils";
+import { BuilderPane, type BuilderPaneStatus, type BuilderPaneThread } from "./BuilderPane";
+import {
+  columnsFor,
+  GRID_GAP,
+  layoutModeFor,
+  MIN_BODY_PX,
+  PAGE_PADDING,
+  PAGED_PANES_PER_PAGE,
+  pageCountFor,
+} from "./layout";
+
+/**
+ * The container's inner width, or `null` until it has been measured.
+ *
+ * `null` is not zero. Laying out against zero for one frame gives one column,
+ * which then reflows to three — a visible jump on every mount, and on a slow
+ * machine a screenshot of the wrong layout. Nothing renders until the width is
+ * known.
+ */
+function useMeasuredWidth(): {
+  readonly ref: (node: HTMLElement | null) => void;
+  readonly width: number | null;
+} {
+  const [width, setWidth] = useState<number | null>(null);
+  const observerRef = useRef<ResizeObserver | null>(null);
+
+  const ref = useCallback((node: HTMLElement | null) => {
+    observerRef.current?.disconnect();
+    observerRef.current = null;
+    if (node === null) return;
+    setWidth(node.getBoundingClientRect().width);
+    const observer = new ResizeObserver((entries) => {
+      const entry = entries[0];
+      if (entry === undefined) return;
+      setWidth(entry.contentRect.width);
+    });
+    observer.observe(node);
+    observerRef.current = observer;
+  }, []);
+
+  useEffect(() => () => observerRef.current?.disconnect(), []);
+  return { ref, width };
+}
+
+export function BuilderGrid(props: {
+  readonly threads: readonly BuilderPaneThread[];
+  readonly statusFor: (thread: BuilderPaneThread) => BuilderPaneStatus;
+}) {
+  const { threads, statusFor } = props;
+  const { ref, width } = useMeasuredWidth();
+  const [page, setPage] = useState(0);
+
+  const columns = width === null ? 1 : columnsFor(threads.length, width);
+  const mode = width === null ? "standard" : layoutModeFor(width);
+  const pageCount = width === null ? 1 : pageCountFor(threads.length, width);
+  // A page index outliving the list it indexed shows an empty grid on a screen
+  // that has panes in it.
+  const currentPage = Math.min(page, pageCount - 1);
+  const visible = useMemo(() => {
+    if (mode !== "paged") return threads;
+    const start = currentPage * PAGED_PANES_PER_PAGE;
+    return threads.slice(start, start + PAGED_PANES_PER_PAGE);
+  }, [threads, mode, currentPage]);
+
+  return (
+    <div
+      ref={ref}
+      data-testid="codev-builder-grid"
+      data-codev-grid-columns={width === null ? undefined : columns}
+      data-codev-grid-mode={width === null ? undefined : mode}
+      style={{ padding: PAGE_PADDING, ["--codev-pane-body" as string]: `${MIN_BODY_PX}px` }}
+      className="flex min-h-0 min-w-0 flex-1 flex-col gap-3 overflow-x-hidden"
+    >
+      {width === null ? null : (
+        <>
+          <div
+            data-testid="codev-builder-grid-panes"
+            style={{
+              display: "grid",
+              gap: GRID_GAP,
+              gridTemplateColumns: `repeat(${columns}, minmax(0, 1fr))`,
+            }}
+            className="min-w-0"
+          >
+            {visible.map((thread) => (
+              <BuilderPane key={thread.id} thread={thread} status={statusFor(thread)} />
+            ))}
+          </div>
+          {pageCount <= 1 ? null : (
+            /*
+              Paging, not shrinking. Below 700px of AVAILABLE width a grid that
+              kept tiling would put panes under the 340px floor, and a pane under
+              the floor is not a smaller pane, it is an unreadable one.
+            */
+            <nav
+              data-testid="codev-builder-grid-paging"
+              aria-label="Builder pages"
+              className="flex shrink-0 items-center justify-center gap-2 text-xs"
+            >
+              <button
+                type="button"
+                onClick={() => setPage((value) => Math.max(0, value - 1))}
+                disabled={currentPage === 0}
+                className={cn(
+                  "rounded-md px-2 py-1 font-medium",
+                  currentPage === 0
+                    ? "text-muted-foreground/40"
+                    : "cursor-pointer text-info hover:underline",
+                )}
+              >
+                Previous
+              </button>
+              <span data-testid="codev-builder-grid-page-label" className="text-muted-foreground">
+                Page {currentPage + 1} of {pageCount}
+              </span>
+              <button
+                type="button"
+                onClick={() => setPage((value) => Math.min(pageCount - 1, value + 1))}
+                disabled={currentPage >= pageCount - 1}
+                className={cn(
+                  "rounded-md px-2 py-1 font-medium",
+                  currentPage >= pageCount - 1
+                    ? "text-muted-foreground/40"
+                    : "cursor-pointer text-info hover:underline",
+                )}
+              >
+                Next
+              </button>
+            </nav>
+          )}
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/apps/web/src/codev/BuilderPane.tsx b/apps/web/src/codev/BuilderPane.tsx
new file mode 100644
index 000000000..c13ec7366
--- /dev/null
+++ b/apps/web/src/codev/BuilderPane.tsx
@@ -0,0 +1,137 @@
+/**
+ * Codev customization (spec 250), phase 9 — one builder, at a glance.
+ *
+ * ## It is deliberately not a transcript
+ *
+ * The plan is explicit: six live transcripts is six continuous subscriptions,
+ * which is a different feature at a different cost. A full transcript is read by
+ * opening one thread full-size, which t3code already does. So this pane renders
+ * only what the SHELL carries — the list every sidebar row is already built from
+ * — and opening the pane is a link to the real thread.
+ *
+ * ## Two of the four things are PUBLISHED, and this page cannot reach them yet
+ *
+ * The plan asks for a porch phase and the last three messages. Neither is on the
+ * thread — Codev writes `role`, `parentThreadId`, `codevGate` and `gateRevision`
+ * and nothing else, and `latestTurn` is ids and timestamps with no message text.
+ * But both ARE published, by `codev-agent`, workspace-scoped, in one request for
+ * the whole grid rather than one per pane: `GET /api/agent/v1/workspaces/<b64>/state`
+ * carries `porch.phase` and the last three messages per identity. That is where
+ * `apps/client` reads them, and it is why the plan's ban on six continuous
+ * subscriptions was never in tension with showing them.
+ *
+ * This page does not read it yet: the same-origin proxy that lets it is phase
+ * 10's deliverable. So these two lines say **that** — not that the data does not
+ * exist. "The phase was never published" and "this page cannot see the phase"
+ * are different facts, one of them is false, and writing the false one is the
+ * defect this project has caught repeatedly.
+ */
+
+import { Link } from "@tanstack/react-router";
+import { GavelIcon } from "lucide-react";
+
+import { cn } from "~/lib/utils";
+import { resolveCodevGateState, type CodevGateFields } from "./gateState";
+import { MIN_PANE_H, MIN_PANE_W } from "./layout";
+
+export interface BuilderPaneThread extends CodevGateFields {
+  readonly id: string;
+  readonly environmentId: string;
+  readonly title: string;
+  readonly role?: "architect" | "builder" | null | undefined;
+  readonly branch: string | null;
+}
+
+/** The status line, from what the shell carries and nothing more. */
+export interface BuilderPaneStatus {
+  readonly label: string;
+  readonly colorClass: string;
+}
+
+export function BuilderPane(props: {
+  readonly thread: BuilderPaneThread;
+  readonly status: BuilderPaneStatus;
+}) {
+  const { thread, status } = props;
+  const gate = resolveCodevGateState(thread);
+  // Role-prefixed, because a grid of six panes is read by scanning the corner of
+  // each one and `builder/` there is the difference between "one of the six" and
+  // "the one running them".
+  const rolePrefix = thread.role === null || thread.role === undefined ? "thread" : thread.role;
+
+  return (
+    <article
+      data-testid="codev-builder-pane"
+      data-codev-pane-thread-id={thread.id}
+      style={{ minWidth: MIN_PANE_W, minHeight: MIN_PANE_H }}
+      className="flex min-w-0 flex-col gap-2 overflow-hidden rounded-xl border border-sidebar-border/60 bg-card p-3"
+    >
+      <header className="flex min-w-0 items-baseline gap-2">
+        <span
+          data-testid="codev-pane-id"
+          className="min-w-0 truncate font-medium text-card-foreground text-sm"
+        >
+          <span className="text-muted-foreground">{rolePrefix}/</span>
+          {thread.title}
+        </span>
+        <span
+          data-testid="codev-pane-status"
+          className={cn("ml-auto shrink-0 font-medium text-xs", status.colorClass)}
+        >
+          {status.label}
+        </span>
+      </header>
+
+      <p data-testid="codev-pane-phase" className="flex min-w-0 items-center gap-1 text-xs">
+        {gate.kind === "none" ? (
+          /*
+            NOT "phase not published" — it is published, and this page cannot
+            read it until phase 10 wires the same-origin proxy. The distinction
+            is the whole reason this line has words in it at all.
+          */
+          <span className="text-muted-foreground/70">
+            Phase not read here yet — published by codev-agent
+          </span>
+        ) : (
+          <>
+            <GavelIcon aria-hidden className="size-3 shrink-0 text-rose-600 dark:text-rose-300/90" />
+            <span className="min-w-0 truncate font-medium text-rose-600 dark:text-rose-300/90">
+              {gate.gateName}
+            </span>
+          </>
+        )}
+      </p>
+
+      <div
+        data-testid="codev-pane-messages"
+        className="min-h-0 flex-1 overflow-auto rounded-md bg-muted/30 p-2 text-muted-foreground text-[13px]"
+      >
+        {/*
+          The fourth thing the plan asks for. `codev-agent` publishes it in the
+          same workspace-scoped request as the phase; this page is not wired to
+          that yet. A blank box would read as "this builder has said nothing",
+          which is a claim about the builder rather than about what reached the
+          browser — and it would be wrong.
+        */}
+        Recent messages come from codev-agent, which this page does not read yet. Open the thread
+        to read them now.
+      </div>
+
+      <footer className="flex min-w-0 items-baseline gap-2 text-muted-foreground text-xs">
+        {thread.branch === null ? (
+          <span className="min-w-0 truncate text-muted-foreground/70">no branch</span>
+        ) : (
+          <span className="min-w-0 truncate font-mono">{thread.branch}</span>
+        )}
+        <Link
+          data-testid="codev-pane-open"
+          to="/$environmentId/$threadId"
+          params={{ environmentId: thread.environmentId, threadId: thread.id }}
+          className="ml-auto shrink-0 font-medium text-info hover:underline"
+        >
+          Open
+        </Link>
+      </footer>
+    </article>
+  );
+}
diff --git a/apps/web/src/codev/layout.test.ts b/apps/web/src/codev/layout.test.ts
new file mode 100644
index 000000000..66e4e43b8
--- /dev/null
+++ b/apps/web/src/codev/layout.test.ts
@@ -0,0 +1,174 @@
+/**
+ * Codev customization (spec 250), phase 9 — the tiling arithmetic, as a function.
+ *
+ * These prove the RULE. They cannot prove the rendered pane is 340px wide inside
+ * t3code's chrome — that is the Playwright measurement in
+ * `packages/codev/src/__tests__/e2e/spec-250-tiling.spec.ts`, and the two are
+ * deliberately not the same test.
+ */
+
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  columnsFor,
+  columnsThatFit,
+  contentWidth,
+  GRID_GAP,
+  layoutModeFor,
+  MIN_PANE_W,
+  pageCountFor,
+  paneWidthAt,
+  PAGED_PANES_PER_PAGE,
+  PAGING_MAX_WIDTH,
+} from "./layout";
+
+/**
+ * The available widths these tests are about.
+ *
+ * NOT viewport widths. The grid lives behind t3code's sidebar, so the number
+ * that decides the layout is the container's, and `apps/client`'s viewport-based
+ * version would have been right about a page nobody is looking at. 1176 is 1440
+ * with the sidebar open; 1688 is 1920 with it open; 1404 is 1440 with it
+ * collapsed, kept here because a user can collapse it and the arithmetic must
+ * not care which of the two it was handed.
+ */
+const AT_1440_WITH_SIDEBAR = 1176;
+const AT_1920_WITH_SIDEBAR = 1688;
+const AT_1440_NO_SIDEBAR = 1404;
+const AT_390 = 390;
+
+describe("columnsThatFit", () => {
+  it("adds the gap to both sides of the division", () => {
+    // N columns need N panes and N-1 gaps. Dividing by (MIN_PANE_W + gap) alone
+    // charges a gap for the last column, which loses a column at every width
+    // that is exactly full.
+    expect(columnsThatFit(MIN_PANE_W)).toBe(1);
+    expect(columnsThatFit(MIN_PANE_W * 2 + GRID_GAP)).toBe(2);
+    expect(columnsThatFit(MIN_PANE_W * 2 + GRID_GAP - 1)).toBe(1);
+  });
+
+  it("never returns zero, however narrow", () => {
+    // One column at 200px is a pane under the floor, which the caller resolves
+    // by paging. Zero columns is a division by zero in every caller.
+    expect(columnsThatFit(200)).toBe(1);
+    expect(columnsThatFit(0)).toBe(1);
+  });
+});
+
+describe("columnsFor: the fewest rows that fit", () => {
+  it("gives six panes three columns at 1440 with the sidebar open", () => {
+    // Criterion 5's case. 3x2.
+    expect(columnsFor(6, AT_1440_WITH_SIDEBAR)).toBe(3);
+  });
+
+  /**
+   * CRITERION 5b, and the reason this rule is written out rather than left to
+   * `auto-fill` or to a near-square heuristic.
+   *
+   * Near-square gives 3x3 here: three columns of a five-column-wide screen, and
+   * a last row holding one tile beside two tiles' worth of nothing. Both rules
+   * agree at 1440, so criterion 5 alone cannot tell them apart — this is the
+   * case that can.
+   */
+  it("gives seven panes FOUR columns at 1920, not three", () => {
+    expect(columnsFor(7, AT_1920_WITH_SIDEBAR)).toBe(4);
+    // Said the other way, so a regression to near-square fails here too.
+    expect(columnsFor(7, AT_1920_WITH_SIDEBAR)).not.toBe(3);
+    expect(Math.ceil(7 / columnsFor(7, AT_1920_WITH_SIDEBAR))).toBe(2);
+  });
+
+  it("walks 1 to 8 panes at 1440 without ever dropping a pane under the floor", () => {
+    // 3 columns is all that fits in 1152px of content, so 7 and 8 panes take
+    // three rows rather than widening — the rule stops at the floor, it does not
+    // negotiate with it.
+    const expected = [1, 2, 3, 2, 3, 3, 3, 3];
+    for (let count = 1; count <= 8; count += 1) {
+      const columns = columnsFor(count, AT_1440_WITH_SIDEBAR);
+      expect(columns, `${count} panes at 1440`).toBe(expected[count - 1]);
+      expect(paneWidthAt(count, AT_1440_WITH_SIDEBAR)).toBeGreaterThanOrEqual(MIN_PANE_W);
+    }
+  });
+
+  it("walks 1 to 8 panes at 1920 without ever dropping a pane under the floor", () => {
+    const expected = [1, 2, 3, 4, 3, 3, 4, 4];
+    for (let count = 1; count <= 8; count += 1) {
+      const columns = columnsFor(count, AT_1920_WITH_SIDEBAR);
+      expect(columns, `${count} panes at 1920`).toBe(expected[count - 1]);
+      expect(paneWidthAt(count, AT_1920_WITH_SIDEBAR)).toBeGreaterThanOrEqual(MIN_PANE_W);
+    }
+  });
+
+  it("is one column for every count at 700 and below", () => {
+    for (let count = 1; count <= 8; count += 1) {
+      expect(columnsFor(count, PAGING_MAX_WIDTH)).toBe(1);
+      expect(columnsFor(count, AT_390)).toBe(1);
+    }
+  });
+
+  it("reads the width it is given, not a viewport it cannot see", () => {
+    // 1440 with the sidebar open and 1440 with it collapsed are 1176 and 1404,
+    // and both fit exactly three columns — so they answer the same. The point is
+    // that the answer comes from the ARGUMENT: 1688 fits four, and the function
+    // has no idea any of the three came from a 1440 or a 1920 window.
+    expect(columnsFor(7, AT_1440_NO_SIDEBAR)).toBe(columnsFor(7, AT_1440_WITH_SIDEBAR));
+    expect(columnsFor(7, AT_1920_WITH_SIDEBAR)).toBeGreaterThan(
+      columnsFor(7, AT_1440_NO_SIDEBAR),
+    );
+  });
+
+  it("returns one column for no panes rather than dividing by zero", () => {
+    expect(columnsFor(0, AT_1440_WITH_SIDEBAR)).toBe(1);
+    expect(columnsFor(-1, AT_1440_WITH_SIDEBAR)).toBe(1);
+  });
+});
+
+describe("paneWidthAt: the floor holds at every count these tests cover", () => {
+  it("keeps every pane at or above 340px wherever the grid is not paged", () => {
+    for (const available of [700, 900, AT_1440_WITH_SIDEBAR, AT_1440_NO_SIDEBAR, AT_1920_WITH_SIDEBAR]) {
+      for (let count = 1; count <= 8; count += 1) {
+        expect(
+          paneWidthAt(count, available),
+          `${count} panes in ${available}px`,
+        ).toBeGreaterThanOrEqual(MIN_PANE_W);
+      }
+    }
+  });
+
+  it("keeps the floor at 390 too, by paging instead of shrinking", () => {
+    // This is the criterion's real claim at phone width: the grid does not fit
+    // four panes into 390px, it shows one column of full-width panes and pages
+    // through them. The single column is 366px — over the floor, not under it —
+    // which is why nothing overflows horizontally there.
+    expect(layoutModeFor(AT_390)).toBe("paged");
+    expect(columnsFor(4, AT_390)).toBe(1);
+    expect(paneWidthAt(4, AT_390)).toBeGreaterThanOrEqual(MIN_PANE_W);
+    expect(paneWidthAt(4, AT_390)).toBeLessThanOrEqual(contentWidth(AT_390));
+  });
+});
+
+describe("layoutModeFor and paging", () => {
+  it("pages at 699 and tiles at 700", () => {
+    expect(layoutModeFor(PAGING_MAX_WIDTH)).toBe("paged");
+    expect(layoutModeFor(PAGING_MAX_WIDTH + 1)).toBe("standard");
+  });
+
+  it("splits a paged grid into pages rather than shrinking it", () => {
+    expect(pageCountFor(6, AT_390)).toBe(3);
+    expect(pageCountFor(PAGED_PANES_PER_PAGE, AT_390)).toBe(1);
+    expect(pageCountFor(0, AT_390)).toBe(1);
+  });
+
+  it("has one page when it is not paging", () => {
+    expect(pageCountFor(6, AT_1440_WITH_SIDEBAR)).toBe(1);
+  });
+});
+
+describe("contentWidth", () => {
+  it("takes the grid's own padding off both sides", () => {
+    expect(contentWidth(1000)).toBe(1000 - 12 * 2);
+  });
+
+  it("never goes negative", () => {
+    expect(contentWidth(10)).toBe(0);
+  });
+});
diff --git a/apps/web/src/codev/layout.ts b/apps/web/src/codev/layout.ts
