index 000000000..5cd417264
--- /dev/null
+++ b/apps/web/src/codev/layout.ts
@@ -0,0 +1,139 @@
+/**
+ * Codev customization (spec 250), phase 9 — the tiling arithmetic.
+ *
+ * Ported from `apps/client/src/responsive/layout.ts` and **re-measured**, which
+ * is the whole point of the port: `apps/client` owned the entire viewport, and
+ * this grid lives inside t3code's chrome behind a sidebar. Carrying the old
+ * constants across unchanged would have produced numbers that are right about a
+ * page nobody is looking at.
+ *
+ * These are the numbers a component test cannot check — they are measured from a
+ * rendered page under Playwright — so the rules that produce them live here as
+ * pure functions with their own unit tests, and the components do nothing but
+ * apply what these return.
+ *
+ * ## Why the column count is computed rather than left to `auto-fill`
+ *
+ * `repeat(auto-fill, minmax(340px, 1fr))` looks like the obvious spelling and
+ * gives the wrong answer: `auto-fill` maximises columns, and the criterion wants
+ * the FEWEST ROWS that fit without a pane going under the floor. Those are
+ * different rules and only one of them is expressible in CSS.
+ *
+ * ## What changed in the port, and why
+ *
+ * `apps/client` computed everything from `viewportWidth` because its grid was
+ * the page. Here the grid is a route inside the chat shell, so the sidebar —
+ * 232px at rest, zero when collapsed or off-canvas at 390 — is not a constant
+ * this file can know. Every function therefore takes the **available width**:
+ * the grid container's own inner width, measured from the DOM.
+ *
+ * That is not a cosmetic change. Six panes at 1440 with the sidebar open have
+ * 1440 - 232 - 2*PAGE_PADDING = 1176px to work with, not 1404. Three columns fit
+ * either way, so criterion 5 would have passed on the viewport-based version by
+ * luck; the seven-at-1920 case in criterion 5b is the one that keeps it honest.
+ */
+
+/** Criterion 5's floor. Below this a pane stops being readable at a glance. */
+export const MIN_PANE_W = 340;
+export const MIN_PANE_H = 240;
+/** Criterion 5's body-text floor. Applied as a CSS custom property, asserted from the DOM. */
+export const MIN_BODY_PX = 13;
+
+/**
+ * Re-measured against t3code, not inherited.
+ *
+ * `apps/client` used a 12px gap and 18px page padding on a page it owned
+ * outright. t3code's own content surfaces sit on a 12px rhythm — the sidebar's
+ * rows, the composer's shell and the settings panes all step in multiples of it
+ * — and the chat body already carries horizontal inset from the shell, so the
+ * grid adds a smaller one of its own rather than doubling up. 12 and 12: the gap
+ * survives the port unchanged because it was already t3code's number, and the
+ * padding drops from 18 to 12 because the shell is paying for the rest.
+ */
+export const GRID_GAP = 12;
+export const PAGE_PADDING = 12;
+
+/**
+ * Below this the grid PAGES rather than shrinks.
+ *
+ * 700 rather than 680 (= 2 x 340 + gap): a two-column grid whose panes are
+ * exactly at the floor with no padding left is the arithmetic minimum, not a
+ * usable layout. One column below 700, two at 700 and above.
+ *
+ * Measured against AVAILABLE width, so a 1024px window with the sidebar open
+ * (792px available) is a two-column grid, and the same window with the sidebar
+ * collapsed is three. That is the honest reading: the user widened the grid.
+ */
+export const PAGING_MAX_WIDTH = 699;
+
+export type LayoutMode = "paged" | "standard";
+
+export function layoutModeFor(availableWidth: number): LayoutMode {
+  return availableWidth <= PAGING_MAX_WIDTH ? "paged" : "standard";
+}
+
+/** The width the grid itself gets, once its own padding is taken out. */
+export function contentWidth(availableWidth: number): number {
+  return Math.max(0, availableWidth - PAGE_PADDING * 2);
+}
+
+/**
+ * How many columns fit at this width without any pane falling under the floor.
+ *
+ * N columns need N panes plus N-1 gaps, which is why the gap is added to both
+ * sides of the division rather than only the numerator.
+ */
+export function columnsThatFit(available: number, gap = GRID_GAP): number {
+  return Math.max(1, Math.floor((available + gap) / (MIN_PANE_W + gap)));
+}
+
+/**
+ * The column count for `count` panes in `availableWidth`.
+ *
+ * THE RULE IS "AS FEW ROWS AS FIT", not "as square as possible", and
+ * `apps/client/src/responsive/layout.ts` records the near-square rule as
+ * considered and rejected. Both give 3 columns for six panes at 1440, which is
+ * why criterion 5 alone cannot tell them apart — they diverge as soon as the
+ * grid is not a neat rectangle. A near-square rule puts seven panes at 1920 into
+ * 3x3: three columns of a five-column-wide screen, and a last row holding one
+ * tile beside two tiles' worth of nothing. Fewest-rows gives 4x2 — every pane
+ * larger, one short row instead of two-thirds of one empty.
+ *
+ * So: try one row, then two, and stop at the first row count whose columns fit
+ * without any pane falling under the floor.
+ */
+export function columnsFor(count: number, availableWidth: number): number {
+  if (count <= 0) return 1;
+  if (layoutModeFor(availableWidth) === "paged") return 1;
+  const fits = columnsThatFit(contentWidth(availableWidth));
+  for (let rows = 1; rows <= count; rows += 1) {
+    const columns = Math.ceil(count / rows);
+    if (columns <= fits) return columns;
+  }
+  return 1;
+}
+
+/**
+ * The width one pane will actually get, for the tests that assert the floor
+ * holds rather than trusting that it does.
+ */
+export function paneWidthAt(count: number, availableWidth: number): number {
+  const columns = columnsFor(count, availableWidth);
+  const available = contentWidth(availableWidth);
+  return (available - GRID_GAP * (columns - 1)) / columns;
+}
+
+/**
+ * How many panes fit on one page in paged mode.
+ *
+ * Paged mode is one column, and a phone showing one pane at a time is a list
+ * with extra steps. Two: the pane floor is 240px tall, so two of them plus a gap
+ * fit a 390x844 viewport with the chrome, and a user swiping through six
+ * builders takes three pages rather than six.
+ */
+export const PAGED_PANES_PER_PAGE = 2;
+
+export function pageCountFor(count: number, availableWidth: number): number {
+  if (layoutModeFor(availableWidth) !== "paged") return 1;
+  return Math.max(1, Math.ceil(count / PAGED_PANES_PER_PAGE));
+}
