+/**
+ * CRITERION 4b — the architect does not take a seventh equal tile where that
+ * makes a ragged row.
+ *
+ * Keyed on WIDTH, never on how many builders there are. A count-based rule would
+ * make the architect jump between strip and tile as builders come and go, which
+ * is a layout that moves under a reader who did nothing.
+ */
+describe("architectPlacement", () => {
+  it("gives the architect a strip at 1440, where three columns make 3 + 3 + 1", () => {
+    expect(architectPlacement(AT_1440_WITH_SIDEBAR)).toBe("strip");
+    expect(architectPlacement(AT_1440_NO_SIDEBAR)).toBe("strip");
+  });
+
+  it("gives the architect a tile at 1920, where four columns make 4 + 3", () => {
+    expect(architectPlacement(AT_1920_WITH_SIDEBAR)).toBe("tile");
+  });
+
+  it("is a strip on a paged grid", () => {
+    // One column: a "tile" and a "strip" would be the same shape, and the strip
+    // is the one that says what it is.
+    expect(architectPlacement(AT_390)).toBe("strip");
+    expect(architectPlacement(PAGING_MAX_WIDTH)).toBe("strip");
+  });
+
+  it("turns over exactly where the fourth column starts to fit", () => {
+    // The rule IS the reason, so the boundary is the reason's boundary: four
+    // panes at the floor plus three gaps, plus the grid's own padding.
+    const fourColumns = MIN_PANE_W * 4 + GRID_GAP * 3 + 12 * 2;
+    expect(architectPlacement(fourColumns)).toBe("tile");
+    expect(architectPlacement(fourColumns - 1)).toBe("strip");
+    expect(ARCHITECT_TILE_MIN_COLUMNS).toBe(4);
+  });
+
+  it("does not consult the builder count", () => {
+    // Stated as a test because the temptation is real: "seven items is ragged at
+    // three columns" invites a count-based rule, and a layout that reflows when
+    // a builder finishes is a layout that moves under a reader who did nothing.
+    const at1920 = architectPlacement(AT_1920_WITH_SIDEBAR);
+    const at1440 = architectPlacement(AT_1440_WITH_SIDEBAR);
+    expect(at1920).not.toBe(at1440);
+    // `architectPlacement` takes one argument, and this is what that means.
+    expect(architectPlacement.length).toBe(1);
+  });
+});
diff --git a/apps/web/src/codev/layout.ts b/apps/web/src/codev/layout.ts
index 5cd417264..af6b396ac 100644
--- a/apps/web/src/codev/layout.ts
+++ b/apps/web/src/codev/layout.ts
@@ -87,6 +87,37 @@ export function columnsThatFit(available: number, gap = GRID_GAP): number {
   return Math.max(1, Math.floor((available + gap) / (MIN_PANE_W + gap)));
 }
 
+/**
+ * Spec 146 criterion 4b: the architect does NOT take a seventh equal tile at
+ * 1440x900. It gets a persistent strip below the grid, and an equal tile only
+ * where there is room for one.
+ *
+ * **Expressed in columns, not in a viewport width, and that is a deliberate
+ * departure from the letter of 4b.** `apps/client` said "1920 or wider" because
+ * it owned the whole viewport, so a viewport number and an available number were
+ * the same number. Here they are not: 1920 with the sidebar open is 1688px of
+ * grid, and 1440 with it collapsed is 1404. A literal viewport threshold would
+ * offer the tile at 1920 even when the sidebar has been dragged wide enough that
+ * only three columns fit — which is precisely the ragged 3 + 3 + 1 row that 4b
+ * exists to prevent.
+ *
+ * Four columns is the rule because four columns is the REASON: with six builders
+ * and an architect, four columns is 4 + 3 and three columns is 3 + 3 + 1, one
+ * lonely card beside two empty slots. It gives exactly what 4b names at both
+ * viewports 4b names — 1440 is three columns, so the strip; 1920 is four, so the
+ * tile.
+ */
+export const ARCHITECT_TILE_MIN_COLUMNS = 4;
+
+export type ArchitectPlacement = "tile" | "strip";
+
+export function architectPlacement(availableWidth: number): ArchitectPlacement {
+  if (layoutModeFor(availableWidth) === "paged") return "strip";
+  return columnsThatFit(contentWidth(availableWidth)) >= ARCHITECT_TILE_MIN_COLUMNS
+    ? "tile"
+    : "strip";
+}
+
