new file mode 100644
index 000000000..9aebba313
--- /dev/null
+++ b/apps/web/src/codev/gateState.ts
@@ -0,0 +1,143 @@
+/**
+ * Codev customization (spec 250), phase 8 — a porch gate, derived from the thread.
+ *
+ * Spec 146 wrote the gate name into the thread TITLE, because t3code had nowhere
+ * else to put it. Phase 4 gave it somewhere: `codevGate` on the thread record,
+ * with a server-allocated revision. This turns that block into the three states a
+ * renderer has to tell apart, and it is a pure function so both the sidebar row
+ * and the panel answer from one derivation rather than two.
+ *
+ * ## Three states, and the third is the one that gets lost
+ *
+ *   none                    no gate. Nothing to draw.
+ *   pending-unstructured    a gate is pending and carries NO question and NO
+ *                           choices. `porch gate 250` without `--request-file` is
+ *                           legitimate and common, so this is the ordinary case
+ *                           for a gate nobody attached content to.
+ *   pending                 a gate with #128's structured request.
+ *
+ * The middle one is why this is a union and not a nullable object. Rendering it
+ * as `none` hides a human who is waiting; rendering it as `pending` with an empty
+ * question shows a heading with nothing under it, which reads as a bug in the
+ * gate rather than as an absence of content. "I have a gate and no question" is
+ * its own answer and has to be spelled as one.
+ *
+ * ## It is not folded into session status
+ *
+ * `starting` / `running` / `ready` / `settled` describe what the AGENT is doing.
+ * None of them can say "a human has to decide". `hasPendingApprovals` cannot
+ * stand in either — that is provider TOOL approvals, and the contract says why
+ * keeping them apart matters: a builder blocked on `plan-approval` and one
+ * waiting on a tool call need different things from a person, and one flag
+ * covering both is one flag nobody can act on.
+ */
+
+import type { CodevGate, CodevGateChoice } from "@t3tools/contracts";
+
+/**
+ * The one field this reads, and the seam it has to fit.
+ *
+ * `| undefined` is written out and load-bearing, for the same reason it is on
+ * `CodevHierarchyFields`: the web app compiles with `exactOptionalPropertyTypes`,
+ * under which `codevGate?: X` means "may be absent" and NOT "may be undefined",
+ * so a real thread — whose type is `CodevGate | null | undefined` — would not
+ * satisfy it. The compile-time check in the test file is what holds this honest.
+ */
+export interface CodevGateFields {
+  readonly codevGate?: CodevGate | null | undefined;
+}
+
+export interface CodevGatePendingBase {
+  /** The porch gate name, e.g. `plan-approval`. Never read from the title. */
+  readonly gateName: string;
+  readonly requestedAt: string;
+}
+
+export type CodevGateState =
+  | { readonly kind: "none" }
+  | ({ readonly kind: "pending-unstructured" } & CodevGatePendingBase)
+  | ({
+      readonly kind: "pending";
+      readonly question: string | null;
+      readonly choices: readonly CodevGateChoice[];
+      /**
+       * Which choice is recommended, or `null`.
+       *
+       * An index rather than a boolean on each choice, because the schema
+       * already refuses two recommendations ("two recommendations is no
+       * recommendation") and a renderer that trusted a per-choice flag would
+       * have to re-derive that rule to know whether to believe it.
+       */
+      readonly recommendedIndex: number | null;
+      readonly terminalExcerpt: string | null;
+    } & CodevGatePendingBase);
+
+/**
+ * Read the gate off a thread.
+ *
+ * Absent and null are one answer here — "no gate" — and they arrive as both
+ * because the wire spells an unset optional either way.
+ */
+export function resolveCodevGateState<T extends CodevGateFields>(
+  thread: T | null | undefined,
+): CodevGateState {
+  const gate = thread?.codevGate;
+  if (gate === null || gate === undefined) return { kind: "none" };
+
+  const question = gate.question ?? null;
+  const choices = gate.choices ?? [];
+  // Structured means there is something to READ, not that the field was sent.
+  // A gate carrying a question, or choices, or both, has content; one carrying
+  // neither is the third state and must say so.
+  if (question === null && choices.length === 0) {
+    return {
+      kind: "pending-unstructured",
+      gateName: gate.gateName,
+      requestedAt: gate.requestedAt,
+    };
+  }
+
+  const recommendedIndex = choices.findIndex((choice) => choice.recommended === true);
+  return {
+    kind: "pending",
+    gateName: gate.gateName,
+    requestedAt: gate.requestedAt,
+    question,
+    choices,
+    recommendedIndex: recommendedIndex === -1 ? null : recommendedIndex,
+    terminalExcerpt: gate.terminalExcerpt ?? null,
+  };
+}
+
+/** Is a human being waited on? True for BOTH pending states. */
+export function isCodevGatePending(state: CodevGateState): boolean {
+  return state.kind !== "none";
+}
+
+export interface CodevGatePill {
+  readonly label: string;
+  readonly colorClass: string;
+  readonly dotClass: string;
+}
+
+/**
+ * The sidebar row's gate marker.
+ *
+ * Rose, and deliberately none of the hues already spoken for: amber is Pending
+ * Approval (provider tool approvals), indigo Awaiting Input, sky Working,
+ * violet Plan Ready, emerald Completed. Reusing amber would collapse exactly the
+ * distinction phase 4 built the gate block to make.
+ *
+ * The label carries the gate NAME, because "which gate" is the first thing a
+ * human asks and the panel is a click away. Both pending states get the same
+ * pill: from the sidebar, a gate with no attached question is no less blocking
+ * than one with a question.
+ */
+export function resolveCodevGatePill(state: CodevGateState): CodevGatePill | null {
+  if (state.kind === "none") return null;
+  return {
+    label: `Gate: ${state.gateName}`,
+    colorClass: "text-rose-600 dark:text-rose-300/90",
+    dotClass: "bg-rose-500 dark:bg-rose-300/90",
+  };
+}
