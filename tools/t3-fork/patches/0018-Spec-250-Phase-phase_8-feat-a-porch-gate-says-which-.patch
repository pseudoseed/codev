@@ -0,0 +1,175 @@
+/**
+ * Codev customization (spec 250), phase 8 — the panel, rendered.
+ *
+ * `gateState.test.ts` settles what the three states ARE. This settles what a
+ * human sees for each, and one claim it makes is a security claim: gate text is
+ * written by a builder agent into `status.yaml` and carried over a socket, so if
+ * any of it reached the page as markup, a repository under review could script
+ * the page reviewing it.
+ */
+
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+import { CodevGate } from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vite-plus/test";
+
+import { GatePanel } from "./GatePanel";
+
+const decodeGate = Schema.decodeUnknownSync(CodevGate);
+
+const render = (overrides: Record<string, unknown> | null) =>
+  renderToStaticMarkup(
+    <GatePanel
+      thread={{
+        codevGate:
+          overrides === null
+            ? null
+            : decodeGate({
+                gateName: "plan-approval",
+                requestedAt: "2026-08-31T05:00:00.000Z",
+                ...overrides,
+              }),
+      }}
+    />,
+  );
+
+describe("GatePanel", () => {
+  it("renders nothing when there is no gate", () => {
+    // Every thread that is not blocked has to look exactly as it did before
+    // spec 250; an empty frame above the composer is new furniture.
+    expect(render(null)).toBe("");
+    expect(renderToStaticMarkup(<GatePanel thread={null} />)).toBe("");
+  });
+
+  it("names the gate and when it was requested, from the gate block", () => {
+    const markup = render({ question: "Approve the plan?" });
+    expect(markup).toContain("plan-approval");
+    expect(markup).toContain('data-codev-gate-name="plan-approval"');
+    // The timestamp is machine-readable as well as rendered: a relative label
+    // alone ("2 hours ago") drifts with the clock and cannot be checked against
+    // anything. Asserted as `<time>` plus the ISO string rather than on the
+    // attribute spelling — `renderToStaticMarkup` emits `dateTime`, a browser
+    // emits `datetime`, and the claim here is about neither.
+    expect(markup).toContain("<time");
+    expect(markup).toContain("2026-08-31T05:00:00.000Z");
+  });
+
+  it("shows the question and every choice with its consequence", () => {
+    const markup = render({
+      question: "Delete the legacy table?",
+      choices: [
+        { label: "Delete it", consequence: "Migrate references and drop it.", recommended: true },
+        { label: "Keep it", consequence: "Retain it and document the dependency." },
+      ],
+    });
+    expect(markup).toContain("Delete the legacy table?");
+    expect(markup).toContain("Delete it");
+    expect(markup).toContain("Migrate references and drop it.");
+    expect(markup).toContain("Keep it");
+    expect(markup).toContain("Retain it and document the dependency.");
+  });
+
+  it("marks exactly the recommended choice", () => {
+    const markup = render({
+      question: "Delete the legacy table?",
+      choices: [
+        { label: "Delete it", consequence: "Drop it.", recommended: true },
+        { label: "Keep it", consequence: "Retain it." },
+      ],
+    });
+    const marks = markup.match(/data-codev-gate-recommended="true"/g) ?? [];
+    expect(marks).toHaveLength(1);
+    // Marked in place, not moved to the top: reordering would break the
+    // numbering the builder wrote its consequences against.
+    expect(markup.indexOf("Delete it")).toBeLessThan(markup.indexOf("Keep it"));
+    expect(markup).toContain("Recommended");
+  });
+
+  it("marks nothing when there is no recommendation", () => {
+    const markup = render({
+      question: "Which way?",
+      choices: [
+        { label: "Left", consequence: "Go left." },
+        { label: "Right", consequence: "Go right." },
+      ],
+    });
+    expect(markup).not.toContain('data-codev-gate-recommended="true"');
+    expect(markup).not.toContain("Recommended");
+  });
+
+  /**
+   * THE THIRD STATE, on screen.
+   *
+   * Never "no gate" and never an empty question. `porch gate <id>` without
+   * `--request-file` is the ordinary way to reach this.
+   */
+  it("says a gate is pending with no structured request, rather than showing an empty question", () => {
+    const markup = render({});
+    expect(markup).toContain('data-codev-gate-kind="pending-unstructured"');
+    expect(markup).toContain("Gate pending, no structured request");
+    expect(markup).toContain("plan-approval");
+    expect(markup).not.toContain('data-testid="codev-gate-question"');
+    expect(markup).not.toContain('data-testid="codev-gate-choices"');
+  });
+
+  it("renders a question with no choices, and choices with no question", () => {
+    const questionOnly = render({ question: "Ready to merge?" });
+    expect(questionOnly).toContain("Ready to merge?");
+    expect(questionOnly).not.toContain('data-testid="codev-gate-choices"');
+
+    const choicesOnly = render({ choices: [{ label: "Proceed", consequence: "Open the PR." }] });
+    expect(choicesOnly).toContain("Proceed");
+    expect(choicesOnly).not.toContain('data-testid="codev-gate-question"');
+    // And neither is the third state: both have something to read.
+    expect(choicesOnly).not.toContain("no structured request");
+  });
+
+  it("renders the terminal excerpt verbatim, including its truncation marker", () => {
+    const markup = render({
+      question: "Ship it?",
+      terminalExcerpt: "[…earlier output truncated…]\nwarning: 2 tests skipped",
+    });
+    expect(markup).toContain("[…earlier output truncated…]");
+    expect(markup).toContain("warning: 2 tests skipped");
+    // Phase 6 truncates an oversize excerpt TAIL-FIRST behind that inline
+    // marker, so re-truncating here would hide the notice saying it is partial.
+  });
+
+  /**
+   * NO `dangerouslySetInnerHTML`, asserted rather than promised.
+   *
+   * Every field a builder controls is checked. A test that only covered the
+   * question would pass while a choice label rendered as markup.
+   */
+  it("escapes gate text instead of rendering it as markup", () => {
+    const payload = '<img src=x onerror="alert(1)">';
+    const markup = render({
+      question: `Question ${payload}`,
+      choices: [{ label: `Label ${payload}`, consequence: `Consequence ${payload}` }],
+      terminalExcerpt: `Excerpt ${payload}`,
+    });
+    // No element was created from the payload...
+    expect(markup).not.toContain("<img");
+    // ...and all four builder-controlled fields carry it as inert text.
+    expect(markup.match(/&lt;img src=x onerror=&quot;alert\(1\)&quot;&gt;/g) ?? []).toHaveLength(4);
+  });
+
+  it("carries no dangerouslySetInnerHTML in its source", () => {
+    /*
+     * The escaping above is a property of how React renders CHILDREN, and it
+     * survives only while nothing in this file opts out of it. The test above
+     * would keep passing on a version that escaped the question and handed the
+     * terminal excerpt to `dangerouslySetInnerHTML`, because that one field
+     * would simply stop matching — a check that gets quieter as the defect gets
+     * worse. This reads the file.
+     */
+    const source = readFileSync(join(import.meta.dirname, "GatePanel.tsx"), "utf8");
+    // A USE, not a mention: the file's own doc comment names the thing it does
+    // not do, and a bare substring check fails on that sentence — which would
+    // train the next reader to delete the sentence rather than the risk.
+    expect(source).not.toMatch(/dangerouslySetInnerHTML\s*[=:]/);
+  });
+});
diff --git a/apps/web/src/codev/GatePanel.tsx b/apps/web/src/codev/GatePanel.tsx
new file mode 100644
index 000000000..91607ca35
--- /dev/null
+++ b/apps/web/src/codev/GatePanel.tsx
@@ -0,0 +1,140 @@
+/**
+ * Codev customization (spec 250), phase 8 — the gate a human is blocking on.
+ *
+ * Everything here comes from `codevGate` on the thread record. Spec 146 read the
+ * gate name out of the thread TITLE because there was nowhere else to put it, and
+ * a title is a string a user can rename: a panel sourced from one would report
+ * whatever the last person typed. Nothing in this file touches the title.
+ *
+ * ## No `dangerouslySetInnerHTML`, and it is not a style choice
+ *
+ * Gate text is CONTENT. The question, the labels, the consequences and the
+ * terminal excerpt are all written by a builder agent into `status.yaml` and
+ * carried over a socket, so a panel that rendered them as markup would let a
+ * repository under review script the page that reviews it. React escapes text
+ * children; that is the whole mechanism and it must stay the whole mechanism.
+ *
+ * ## It is drawn in t3code's own frame
+ *
+ * `Alert` with the `info` variant, the same primitive the composer banners use.
+ * A gate is not an error and not a warning — a human being asked to decide is the
+ * system working — so it takes the informational treatment and earns attention
+ * from the sidebar's rose pill instead of from a red panel.
+ */
+
+import { GavelIcon } from "lucide-react";
+
+import { Alert, AlertDescription, AlertTitle } from "../components/ui/alert";
+import { formatRelativeTimeLabel } from "../timestampFormat";
+import { resolveCodevGateState, type CodevGateFields, type CodevGateState } from "./gateState";
+
+function RequestedAt({ requestedAt }: { readonly requestedAt: string }) {
+  const relative = formatRelativeTimeLabel(requestedAt);
+  return (
+    <time
+      dateTime={requestedAt}
+      title={requestedAt}
+      className="shrink-0 font-normal text-muted-foreground text-xs tabular-nums"
+    >
+      {relative === "" ? requestedAt : relative}
+    </time>
+  );
+}
+
+/**
+ * The gate panel, or nothing.
+ *
+ * Takes the thread rather than a pre-derived state so the call site cannot get
+ * the derivation wrong: there is one `resolveCodevGateState` and both this and
+ * the sidebar row go through it.
+ */
+export function GatePanel({ thread }: { readonly thread: CodevGateFields | null | undefined }) {
+  const state = resolveCodevGateState(thread);
+  if (state.kind === "none") return null;
+  return <GatePanelBody state={state} />;
+}
+
+export function GatePanelBody({ state }: { readonly state: CodevGateState }) {
+  if (state.kind === "none") return null;
+
+  return (
+    <Alert
+      variant="info"
+      controlAlignment="first-line"
+      data-testid="codev-gate-panel"
+      data-codev-gate-name={state.gateName}
+      data-codev-gate-kind={state.kind}
+      className="mx-auto w-full max-w-3xl"
+    >
+      <GavelIcon aria-hidden className="size-4" />
+      <AlertTitle className="flex min-w-0 items-baseline gap-2">
+        <span className="min-w-0 truncate font-medium">Waiting on you: {state.gateName}</span>
+        <RequestedAt requestedAt={state.requestedAt} />
+      </AlertTitle>
+      <AlertDescription>
+        {state.kind === "pending-unstructured" ? (
+          /*
+           * The third state, said out loud.
+           *
+           * `porch gate <id>` without `--request-file` is legitimate and common,
+           * so this is not an error and is not an empty question — it is a gate
+           * that nobody attached content to, and the reader needs to know that
+           * rather than wonder what failed to load.
+           */
+          <p data-testid="codev-gate-no-request">
+            Gate pending, no structured request. The builder recorded that it is waiting here but
+            attached no question or choices.
+          </p>
+        ) : (
+          <div className="flex min-w-0 flex-col gap-2">
+            {state.question === null ? null : (
+              <p data-testid="codev-gate-question" className="text-foreground">
+                {state.question}
+              </p>
+            )}
+            {state.choices.length === 0 ? null : (
+              <ol data-testid="codev-gate-choices" className="flex flex-col gap-1.5">
+                {state.choices.map((choice, index) => (
+                  <li
+                    key={`${index}:${choice.label}`}
+                    data-testid="codev-gate-choice"
+                    data-codev-gate-recommended={index === state.recommendedIndex ? "true" : "false"}
+                    className="flex min-w-0 flex-col gap-0.5"
+                  >
+                    <span className="flex min-w-0 items-baseline gap-1.5">
+                      <span className="min-w-0 font-medium text-foreground">{choice.label}</span>
+                      {index === state.recommendedIndex ? (
+                        /* Marked, not reordered. Moving the recommendation to the
+                           top would change the numbering the builder wrote its
+                           consequences against. */
+                        <span className="shrink-0 font-medium text-info text-xs">Recommended</span>
+                      ) : null}
+                    </span>
+                    <span className="min-w-0">{choice.consequence}</span>
+                  </li>
+                ))}
+              </ol>
+            )}
+            {state.terminalExcerpt === null ? null : (
+              /*
+               * Scrolls inside itself. Terminal output is wide and a panel that
+               * let it widen the page would push the composer off screen at 390.
+               *
+               * Rendered exactly as it arrived: phase 6 truncates an oversize
+               * excerpt TAIL-FIRST behind an inline marker, so the marker is part
+               * of the string and re-truncating here would hide the notice that
+               * says the text is partial.
+               */
+              <pre
+                data-testid="codev-gate-excerpt"
+                className="max-h-48 overflow-auto rounded-md bg-muted/40 p-2 font-mono text-xs whitespace-pre-wrap"
+              >
+                {state.terminalExcerpt}
+              </pre>
+            )}
+          </div>
+        )}
+      </AlertDescription>
+    </Alert>
+  );
+}
diff --git a/apps/web/src/codev/gateState.test.ts b/apps/web/src/codev/gateState.test.ts
new file mode 100644
index 000000000..bcfb4fd7b
--- /dev/null
+++ b/apps/web/src/codev/gateState.test.ts
@@ -0,0 +1,271 @@
+/**
+ * Codev customization (spec 250), phase 8 — the gate derivation, tested as a
+ * function.
+ *
+ * Every fixture is DECODED through `CodevGate` rather than written as an object
+ * literal. That is the difference between testing the states a server can
+ * actually produce and testing states this file invented: six choices, two
+ * recommendations and a multi-line question are all refused at the schema
+ * boundary, and a test that hand-built one would be asserting behaviour for input
+ * that cannot arrive.
+ */
+
+import { CodevGate } from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import { describe, expect, it } from "vite-plus/test";
+
+import type { SidebarThreadSummary, Thread } from "../types";
+import {
+  isCodevGatePending,
+  resolveCodevGatePill,
+  resolveCodevGateState,
+  type CodevGateFields,
+} from "./gateState";
+
+/**
+ * THE SEAM, checked by the compiler.
+ *
+ * The same check that caught a `threadId`/`id` mismatch and an
+ * `exactOptionalPropertyTypes` rejection in phase 7, before either had a call
+ * site. These compile only if the sidebar's and the chat view's actual thread
+ * types satisfy this module's input, so a rename on either side is a build error
+ * here rather than a panel that silently never renders.
+ */
+const _shellFits: (thread: SidebarThreadSummary) => unknown = resolveCodevGateState;
+const _threadFits: (thread: Thread) => unknown = resolveCodevGateState;
+void _shellFits;
+void _threadFits;
+
+const decodeGate = Schema.decodeUnknownSync(CodevGate);
+
+const gate = (overrides: Record<string, unknown> = {}): CodevGateFields => ({
+  codevGate: decodeGate({
+    gateName: "plan-approval",
+    requestedAt: "2026-08-31T05:00:00.000Z",
+    ...overrides,
+  }),
+});
+
+describe("resolveCodevGateState: no gate", () => {
+  it("reads an absent field and a null field as the same answer", () => {
+    // The wire spells an unset optional either way, and distinguishing them in
+    // the UI would be distinguishing two spellings of one fact.
+    expect(resolveCodevGateState({}).kind).toBe("none");
+    expect(resolveCodevGateState({ codevGate: null }).kind).toBe("none");
+    expect(resolveCodevGateState({ codevGate: undefined }).kind).toBe("none");
+  });
+
+  it("reads a missing thread as no gate rather than throwing", () => {
+    // The chat view has no thread while one is loading, and a panel that threw
+    // there would take the whole view down for the absence of a gate.
+    expect(resolveCodevGateState(null).kind).toBe("none");
+    expect(resolveCodevGateState(undefined).kind).toBe("none");
+  });
+
+  it("is not pending", () => {
+    expect(isCodevGatePending(resolveCodevGateState({}))).toBe(false);
+    expect(resolveCodevGatePill(resolveCodevGateState({}))).toBeNull();
+  });
+});
+
+/**
+ * THE THIRD STATE.
+ *
+ * `porch gate <id>` without `--request-file` is legitimate and common. Reporting
+ * it as `none` hides a human who is waiting; reporting it as `pending` with an
+ * empty question shows a heading with nothing under it, which reads as a broken
+ * gate rather than an absent request.
+ */
+describe("resolveCodevGateState: a gate with no structured request", () => {
+  it("is its own state, not 'none'", () => {
+    const state = resolveCodevGateState(gate());
+    expect(state.kind).toBe("pending-unstructured");
+    expect(isCodevGatePending(state)).toBe(true);
+  });
+
+  it("still carries the two fields that always travel", () => {
+    const state = resolveCodevGateState(gate());
+    if (state.kind === "none") throw new Error("expected a pending gate");
+    expect(state.gateName).toBe("plan-approval");
+    expect(state.requestedAt).toBe("2026-08-31T05:00:00.000Z");
+  });
+
+  it("treats an explicitly null question and null choices the same as absent", () => {
+    expect(resolveCodevGateState(gate({ question: null, choices: null })).kind).toBe(
+      "pending-unstructured",
+    );
+  });
+});
+
+describe("resolveCodevGateState: a gate with a structured request", () => {
+  const twoChoices = [
+    { label: "Delete it", consequence: "Migrate references and drop the table.", recommended: true },
+    { label: "Keep it", consequence: "Retain the table and document the dependency." },
+  ];
+
+  it("carries the question, the choices, and which one is recommended", () => {
+    const state = resolveCodevGateState(
+      gate({ question: "Delete the legacy table?", choices: twoChoices }),
+    );
+    if (state.kind !== "pending") throw new Error(`expected pending, saw ${state.kind}`);
+    expect(state.question).toBe("Delete the legacy table?");
+    expect(state.choices.map((choice) => choice.label)).toEqual(["Delete it", "Keep it"]);
+    expect(state.choices.map((choice) => choice.consequence)).toEqual([
+      "Migrate references and drop the table.",
+      "Retain the table and document the dependency.",
+    ]);
+    expect(state.recommendedIndex).toBe(0);
+  });
+
+  it("reports no recommendation as null rather than as the first choice", () => {
+    const state = resolveCodevGateState(
+      gate({
+        question: "Which way?",
+        choices: [
+          { label: "Left", consequence: "Go left." },
+          { label: "Right", consequence: "Go right." },
+        ],
+      }),
+    );
+    if (state.kind !== "pending") throw new Error("expected pending");
+    // Defaulting to 0 would mark a choice the builder did not recommend, which
+    // is a stronger claim than the absence of a recommendation.
+    expect(state.recommendedIndex).toBeNull();
+  });
+
+  it("is structured on a question alone", () => {
+    const state = resolveCodevGateState(gate({ question: "Ready to merge?" }));
+    if (state.kind !== "pending") throw new Error("expected pending");
+    expect(state.choices).toEqual([]);
+  });
+
+  it("is structured on choices alone", () => {
+    const state = resolveCodevGateState(
+      gate({ choices: [{ label: "Proceed", consequence: "Open the PR." }] }),
+    );
+    if (state.kind !== "pending") throw new Error("expected pending");
+    // A list of choices with no question still has something to read, so
+    // reporting it as "no structured request" would be reporting content as
+    // absent while showing it.
+    expect(state.question).toBeNull();
+    expect(state.choices).toHaveLength(1);
+  });
+
+  it("carries one choice and five, which are the bounds the schema allows", () => {
+    const one = resolveCodevGateState(
+      gate({ question: "Go?", choices: [{ label: "Yes", consequence: "Proceed." }] }),
+    );
+    const five = resolveCodevGateState(
+      gate({
+        question: "Which?",
+        choices: Array.from({ length: 5 }, (_, index) => ({
+          label: `Choice ${index + 1}`,
+          consequence: `Consequence ${index + 1}`,
+        })),
+      }),
+    );
+    if (one.kind !== "pending" || five.kind !== "pending") throw new Error("expected pending");
+    expect(one.choices).toHaveLength(1);
+    expect(five.choices).toHaveLength(5);
+  });
+
+  it("carries the terminal excerpt verbatim, and null when there is none", () => {
+    const withExcerpt = resolveCodevGateState(
+      gate({ question: "Ship it?", terminalExcerpt: "warning: 2 tests skipped\n…" }),
+    );
+    if (withExcerpt.kind !== "pending") throw new Error("expected pending");
+    expect(withExcerpt.terminalExcerpt).toBe("warning: 2 tests skipped\n…");
+    const withoutExcerpt = resolveCodevGateState(gate({ question: "Ship it?" }));
+    if (withoutExcerpt.kind !== "pending") throw new Error("expected pending");
+    expect(withoutExcerpt.terminalExcerpt).toBeNull();
+  });
+});
+
+/**
+ * The schema refuses these, which is why the derivation does not handle them.
+ *
+ * Asserted here rather than assumed: if a later contract change relaxed one of
+ * these bounds, the derivation and the panel would both start receiving input
+ * they were written on the promise of never seeing, and this is where that shows
+ * up.
+ */
+describe("the gate bounds are the schema's, not the renderer's", () => {
+  it("refuses six choices", () => {
+    expect(() =>
+      decodeGate({
+        gateName: "plan-approval",
+        requestedAt: "2026-08-31T05:00:00.000Z",
+        choices: Array.from({ length: 6 }, (_, index) => ({
+          label: `Choice ${index + 1}`,
+          consequence: "…",
+        })),
+      }),
+    ).toThrow();
+  });
+
+  it("refuses two recommendations", () => {
+    expect(() =>
+      decodeGate({
+        gateName: "plan-approval",
+        requestedAt: "2026-08-31T05:00:00.000Z",
+        choices: [
+          { label: "A", consequence: "…", recommended: true },
+          { label: "B", consequence: "…", recommended: true },
+        ],
+      }),
+    ).toThrow();
+  });
+
+  it("refuses a multi-line question, because it is rendered as a heading", () => {
+    expect(() =>
+      decodeGate({
+        gateName: "plan-approval",
+        requestedAt: "2026-08-31T05:00:00.000Z",
+        question: "Line one\nLine two",
+      }),
+    ).toThrow();
+  });
+
+  /**
+   * The plan's "a choice with no consequence" case does not exist.
+   *
+   * `consequence` is a required non-empty string, so a choice without one is
+   * refused whole at the boundary. Recorded as a test rather than left out, so
+   * the next reader can see the case was checked and found unrepresentable
+   * instead of assuming it was forgotten.
+   */
+  it("refuses a choice with no consequence", () => {
+    expect(() =>
+      decodeGate({
+        gateName: "plan-approval",
+        requestedAt: "2026-08-31T05:00:00.000Z",
+        choices: [{ label: "Proceed" }],
+      }),
+    ).toThrow();
+  });
+});
+
+describe("resolveCodevGatePill", () => {
+  it("names the gate, so the row says WHICH decision is waiting", () => {
+    const pill = resolveCodevGatePill(resolveCodevGateState(gate({ gateName: "spec-approval" })));
+    expect(pill?.label).toBe("Gate: spec-approval");
+  });
+
+  it("gives both pending states the same pill", () => {
+    // From the sidebar, a gate with no attached question is no less blocking
+    // than one with a question. The difference belongs in the panel.
+    const unstructured = resolveCodevGatePill(resolveCodevGateState(gate()));
+    const structured = resolveCodevGatePill(resolveCodevGateState(gate({ question: "Go?" })));
+    expect(unstructured).toEqual(structured);
+  });
+
+  it("uses a hue none of t3code's status pills already own", () => {
+    const pill = resolveCodevGatePill(resolveCodevGateState(gate()));
+    // amber is Pending Approval (provider TOOL approvals), indigo Awaiting
+    // Input, sky Working, violet Plan Ready, emerald Completed. Reusing amber
+    // would collapse the exact distinction the gate block exists to make.
+    for (const taken of ["amber", "indigo", "sky", "violet", "emerald"]) {
+      expect(`${pill?.colorClass} ${pill?.dotClass}`).not.toContain(taken);
+    }
+  });
+});
